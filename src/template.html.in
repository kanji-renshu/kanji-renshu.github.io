  if (full && outside && A.effect !== 'rainbow') outside += `<g transform="translate(0,96)">${outside}</g>`;
  if (expr === 'cheer') outside += star(16,28,8,'#ffd23f') + star(104,22,7,'#ffd23f') + star(106,98,6,'#ffd23f') + star(14,96,6,'#ffd23f');
  const pets = {
    bunny:`<g transform="rotate(-10 96 92)"><ellipse cx="96" cy="86" rx="3.8" ry="10" fill="#fff" stroke="#f2c4d6" stroke-width="1.2"/><ellipse cx="96" cy="87" rx="1.8" ry="7" fill="#ffc2dc"/></g><g transform="rotate(12 106 92)"><ellipse cx="106" cy="86" rx="3.8" ry="10" fill="#fff" stroke="#f2c4d6" stroke-width="1.2"/><ellipse cx="106" cy="87" rx="1.8" ry="7" fill="#ffc2dc"/></g><ellipse cx="101" cy="105" rx="12" ry="10.5" fill="#fff" stroke="#f2c4d6" stroke-width="1.6"/><circle cx="97" cy="103" r="1.7" fill="${dk}"/><circle cx="105" cy="103" r="1.7" fill="${dk}"/><path d="M100,106.5 L102,106.5 L101,108Z" fill="#ff7a9a"/><ellipse cx="94" cy="107" rx="2.4" ry="1.5" fill="#ffc2dc"/><ellipse cx="108" cy="107" rx="2.4" ry="1.5" fill="#ffc2dc"/>`,
    hamster:`<circle cx="92" cy="95" r="3.6" fill="#e8a868"/><circle cx="110" cy="95" r="3.6" fill="#e8a868"/><circle cx="92" cy="95" r="1.8" fill="#ffc2dc"/><circle cx="110" cy="95" r="1.8" fill="#ffc2dc"/><ellipse cx="101" cy="105" rx="13" ry="11" fill="#f2c38b" stroke="#fff" stroke-width="1.8"/><ellipse cx="101" cy="109" rx="8.5" ry="6" fill="#fff8ee"/><circle cx="96.5" cy="102.5" r="1.8" fill="${dk}"/><circle cx="105.5" cy="102.5" r="1.8" fill="${dk}"/><circle cx="101" cy="106.5" r="1.1" fill="#ff7a9a"/><ellipse cx="91.5" cy="107" rx="2.6" ry="1.6" fill="#ffb3c7"/><ellipse cx="110.5" cy="107" rx="2.6" ry="1.6" fill="#ffb3c7"/>`,
    bear:`<circle cx="91" cy="94" r="4.6" fill="#b07a4f"/><circle cx="111" cy="94" r="4.6" fill="#b07a4f"/><circle cx="91" cy="94" r="2.2" fill="#e8c09a"/><circle cx="111" cy="94" r="2.2" fill="#e8c09a"/><circle cx="101" cy="104" r="12" fill="#b07a4f" stroke="#fff" stroke-width="1.8"/><ellipse cx="101" cy="108" rx="5.6" ry="4.2" fill="#e8c09a"/><circle cx="96.5" cy="101.5" r="1.7" fill="${dk}"/><circle cx="105.5" cy="101.5" r="1.7" fill="${dk}"/><ellipse cx="101" cy="106.4" rx="1.8" ry="1.3" fill="${dk}"/>`,
    unicorn:`<path d="M96,94 L101,76 L104,94Z" fill="#ffd23f" stroke="#e0a100" stroke-width="1"/><path d="M98,90 L103,88 M97.5,86 L102.5,84" stroke="#e0a100" stroke-width=".9"/><path d="M110,96 Q120,100 114,114" fill="none" stroke="#ffb3d1" stroke-width="4" stroke-linecap="round"/><path d="M108,94 Q118,94 116,106" fill="none" stroke="#c9b6ff" stroke-width="3.4" stroke-linecap="round"/><ellipse cx="101" cy="105" rx="12.5" ry="11" fill="#fff" stroke="#e8e1f5" stroke-width="1.8"/><path d="M94,103 Q97,105.5 100,103" fill="none" stroke="${dk}" stroke-width="1.4" stroke-linecap="round"/><path d="M94,103 L92.5,101.5 M95.5,104 L94.5,102" stroke="${dk}" stroke-width="1"/><ellipse cx="96" cy="108" rx="2.4" ry="1.5" fill="#ffc2dc"/><ellipse cx="104" cy="109" rx="2" ry="1.3" fill="#c9b6ff" opacity=".7"/>`,
    chick:`<circle cx="101" cy="104" r="12" fill="#ffd23f" stroke="#fff" stroke-width="2"/><path d="M98,92 Q100,86 103,92" fill="none" stroke="#f2b705" stroke-width="2"/><circle cx="97" cy="101" r="1.8" fill="${dk}"/><path d="M91,104 L86,106.5 L91,109Z" fill="#ff9a3c"/><path d="M104,105 Q113,101 110,111Z" fill="#f2b705"/>`,
    cat:`<path d="M90,97 L90,83 L99,92Z M112,97 L112,83 L103,92Z" fill="#f4a259" stroke="#fff" stroke-width="1.5"/><circle cx="101" cy="103" r="12" fill="#f4a259" stroke="#fff" stroke-width="2"/><circle cx="97" cy="101" r="1.7" fill="${dk}"/><circle cx="105" cy="101" r="1.7" fill="${dk}"/><path d="M99.5,105 L102.5,105 L101,106.8Z" fill="#ff7a9a"/><path d="M92,106 L85,105 M92,108 L86,110 M110,106 L117,105 M110,108 L116,110" stroke="${dk}" stroke-width=".8"/>`,
    dog:`<circle cx="101" cy="103" r="12" fill="#d9a066" stroke="#fff" stroke-width="2"/><ellipse cx="90" cy="101" rx="4.5" ry="9" fill="#8a5a2b" transform="rotate(18 90 101)"/><ellipse cx="112" cy="101" rx="4.5" ry="9" fill="#8a5a2b" transform="rotate(-18 112 101)"/><circle cx="97" cy="101" r="1.7" fill="${dk}"/><circle cx="105" cy="101" r="1.7" fill="${dk}"/><ellipse cx="101" cy="106" rx="2.6" ry="2" fill="${dk}"/><path d="M99.5,108.5 Q101,113 102.5,108.5Z" fill="#ff7a9a"/>`,
    robot:`<path d="M101,92 L101,85" stroke="#7a8296" stroke-width="2"/><circle cx="101" cy="84" r="2.4" fill="#ef476f"/><rect x="89" y="92" width="24" height="21" rx="6" fill="#aab4c8" stroke="#fff" stroke-width="2"/><rect x="93" y="98" width="6" height="5" rx="1.5" fill="#5bf0ff"/><rect x="103" y="98" width="6" height="5" rx="1.5" fill="#5bf0ff"/><path d="M96,108 L106,108" stroke="#4a4f63" stroke-width="1.8" stroke-linecap="round"/>`,
    dragon:`<path d="M109,100 L120,88 L117,107Z" fill="#2fa463"/><path d="M93,95 L89,85 L97,92Z M109,95 L113,85 L105,92Z" fill="#ffd23f"/><ellipse cx="101" cy="104" rx="12.5" ry="11" fill="#3cc47c" stroke="#fff" stroke-width="2"/><circle cx="96.5" cy="101" r="2.2" fill="${dk}"/><circle cx="105.5" cy="101" r="2.2" fill="${dk}"/><circle cx="97.2" cy="100.2" r=".8" fill="#fff"/><circle cx="106.2" cy="100.2" r=".8" fill="#fff"/><path d="M96,108 Q101,111 106,108" fill="none" stroke="${dk}" stroke-width="1.4" stroke-linecap="round"/>`
  }[A.pet];
  if (pets) outside += full ? `<g transform="translate(2,76)"><g class="av-pet">${pets}</g></g>` : `<g class="av-pet">${pets}</g>`;
  const items = {
    kite:`<path d="M14,119 Q18,106 24,98" fill="none" stroke="#9a9282" stroke-width="1"/><path d="M24,68 L37,84 L24,100 L11,84Z" fill="#e5383b" stroke="#fff" stroke-width="1.6"/><path d="M24,68 L24,100 M11,84 L37,84" stroke="#ffd23f" stroke-width="1.6"/><circle cx="24" cy="84" r="4" fill="#ffd23f"/><path d="M24,100 Q18,106 24,110 Q30,114 24,119" fill="none" stroke="#3a9bff" stroke-width="1.6"/><path d="M21,106 L27,104 L26,109Z" fill="#3a9bff"/>`,
    fukumame:`<path d="M7,104 L33,104 L30,119 L10,119Z" fill="#d9a066" stroke="#fff" stroke-width="1.4"/>` + [[12,101],[17,99],[22,100],[27,102],[19,103],[14,104],[25,104]].map(([x,y]) => `<circle cx="${x}" cy="${y}" r="3" fill="#f2d6a0" stroke="#d1a85f" stroke-width=".8"/>`).join('') + `<text x="20" y="116" font-size="9" fill="#c0392b" text-anchor="middle" font-weight="bold">ふく</text>`,
    diploma:`<g transform="rotate(-28 21 102)"><rect x="5" y="97" width="32" height="10" rx="5" fill="#fffaf0" stroke="#d9c49a" stroke-width="1.2"/><ellipse cx="36" cy="102" rx="2.5" ry="5" fill="#f3e6c8"/></g><path d="M20,102 L12,96 L12,108Z M20,102 L28,96 L28,108Z" fill="#e5383b"/><circle cx="20" cy="102" r="2.4" fill="#c9302c"/><path d="M19,104 L16,114 M21,104 L24,114" stroke="#e5383b" stroke-width="2"/>`,
    koinobori:`<path d="M10,119 L10,62" stroke="#8a5a2b" stroke-width="2.4" stroke-linecap="round"/><circle cx="10" cy="61" r="2.6" fill="#ffd23f"/><path d="M11,66 L36,66 Q42,71 36,76 L11,76 L15,71Z" fill="#3a9bff" stroke="#fff" stroke-width="1"/><circle cx="31" cy="69.5" r="1.8" fill="#fff"/><circle cx="31" cy="69.5" r=".9" fill="#2b2d42"/><path d="M11,80 L32,80 Q37,84.5 32,89 L11,89 L15,84.5Z" fill="#ef476f" stroke="#fff" stroke-width="1"/><circle cx="27.5" cy="83" r="1.6" fill="#fff"/><circle cx="27.5" cy="83" r=".8" fill="#2b2d42"/><path d="M18,66 Q20,71 18,76 M22,66 Q24,71 22,76 M18,80 Q20,84.5 18,89" stroke="#fff" stroke-width=".8" fill="none" opacity=".7"/>`,
    umbrella:`<path d="M22,86 L22,114 Q22,119 17,119" fill="none" stroke="#8a5a2b" stroke-width="2.2" stroke-linecap="round"/><path d="M6,88 Q8,70 22,70 Q36,70 38,88 Q34,85 30,88 Q26,85 22,88 Q18,85 14,88 Q10,85 6,88Z" fill="#9ad0ff" stroke="#fff" stroke-width="1.4"/><path d="M22,70 L22,88 M14,72 Q14,80 14,88 M30,72 Q30,80 30,88" stroke="#fff" stroke-width="1" opacity=".8"/>` + heart(16, 79, .55, '#fff') + heart(28, 79, .55, '#fff'),
    sasa:`<path d="M12,119 Q16,96 26,66" fill="none" stroke="#3cc47c" stroke-width="2.6" stroke-linecap="round"/>` + [[20,84,-40],[24,74,-30],[16,98,-50],[28,90,20],[30,78,30]].map(([x,y,a]) => `<ellipse cx="${x}" cy="${y}" rx="7" ry="2.4" fill="#2fa463" transform="rotate(${a} ${x} ${y})"/>`).join('') + [[22,90,'#ff8fb1'],[30,82,'#ffd23f'],[14,104,'#9ad0ff'],[26,98,'#c9b6ff']].map(([x,y,c]) => `<rect x="${x-2}" y="${y}" width="4" height="10" fill="${c}" stroke="#fff" stroke-width=".6"/>`).join('') + star(34, 72, 4, '#ffd23f'),
    pumpkin:`<path d="M20,93 Q20,89 23,88" stroke="#2fa463" stroke-width="2.6" fill="none" stroke-linecap="round"/><ellipse cx="20" cy="105" rx="14" ry="12" fill="#ff922b" stroke="#fff" stroke-width="1.6"/><path d="M14,94 Q10,105 14,116 M26,94 Q30,105 26,116 M20,93 L20,117" stroke="#e8590c" stroke-width="1.2" fill="none"/><path d="M13,101 L17,101 L15,98Z M23,101 L27,101 L25,98Z" fill="#ffe066"/><path d="M13,108 Q20,114 27,108 L24,109 L22,107 L20,110 L18,107 L16,109Z" fill="#ffe066"/>`,
    balloon:`<path d="M20,93 Q16,104 22,118" fill="none" stroke="#9a9282" stroke-width="1.2"/><ellipse cx="20" cy="81" rx="10" ry="12" fill="#ff6b9a" stroke="#fff" stroke-width="1.6"/><ellipse cx="16.5" cy="76" rx="2.5" ry="3.6" fill="#fff" opacity=".7"/><path d="M18,93 L22,93 L20,96Z" fill="#ff6b9a"/>`,
    icecream:`<path d="M12,99 L28,99 L20,119Z" fill="#e8b46a" stroke="#fff" stroke-width="1.4"/><path d="M14,103 L24,103 M16,108 L22,108" stroke="#c98b3a" stroke-width="1"/><circle cx="20" cy="94" r="8" fill="#ffb3d1" stroke="#fff" stroke-width="1.4"/><circle cx="20" cy="85" r="6.4" fill="#bdf0dc" stroke="#fff" stroke-width="1.4"/><circle cx="21" cy="77.5" r="2.6" fill="#ef476f"/>`,
    bouquet: flower(13, 93, '#ff8fb1') + flower(27, 93, '#c9b6ff') + flower(20, 86, '#fff1a8') + flower(20, 97, '#ffb3d1') + `<path d="M9,99 L31,99 L20,119Z" fill="#ffc2dc" stroke="#fff" stroke-width="1.4"/><path d="M15,104 Q20,108 25,104" fill="none" stroke="#ff5d9e" stroke-width="2" stroke-linecap="round"/>`,
    starwand:`<path d="M12,119 L26,93" stroke="#ff8fb1" stroke-width="3.4" stroke-linecap="round"/><path d="M12,119 L26,93" stroke="#fff" stroke-width="1" stroke-linecap="round" opacity=".7"/>` + star(28, 87, 10, '#ffd23f') + spark(28, 86, 2.4, '#fff') + `<path d="M24,96 Q16,98 18,104 M24,96 Q28,103 24,106" fill="none" stroke="#ff8fb1" stroke-width="1.6"/>` + spark(40, 80, 2.4, '#ffd23f') + spark(14, 80, 1.8, '#fff'),
    heartwand:`<path d="M12,119 L26,94" stroke="#c9b6ff" stroke-width="3.4" stroke-linecap="round"/>` + `<path d="M17,88 Q8,84 12,78 Q18,80 21,86Z M39,88 Q48,84 44,78 Q38,80 35,86Z" fill="#fff" stroke="#c9b6ff" stroke-width="1.2"/>` + heart(28, 88, 1.55, '#ff5d9e') + `<circle cx="25" cy="83" r="1.6" fill="#fff"/>` + spark(42, 96, 2.2, '#ffd23f')
  }[A.item];
  const GRIP = {balloon:[21,112], icecream:[20,112], bouquet:[20,112], starwand:[17,110], heartwand:[17,110], kite:[16,114], fukumame:[20,112], diploma:[20,104], koinobori:[10,110], umbrella:[22,112], sasa:[16,110], pumpkin:[21,93]};
  if (items && full){ if (FB.hold){ const g = GRIP[A.item] || [20,112]; outside += `<g transform="translate(${(FB.hold[0]-g[0]).toFixed(1)},${(FB.hold[1]-g[1]).toFixed(1)})"><g class="av-pet">${items}</g></g>`; } else outside += `<g transform="translate(2,72)"><g class="av-pet">${items}</g></g>`; }
  else if (items) outside += `<g class="av-pet">${items}</g>`;
  return `<svg viewBox="${full ? (vb && vb !== '0 0 120 120' ? vb : '0 0 120 200') : vb}" class="av${live ? ' av-live' : ''}${full ? ' av-full' : ''}" xmlns="http://www.w3.org/2000/svg"><defs>${defs}</defs><g clip-path="url(#${id}c)">${bg}${behind}${back}${body}${ears}${head}${front}${shine}${cheeks}${eyes}${mouth}${acc}${sweat}</g>${outside}</svg>`;
}
function hop(node){ node.classList.remove('hop'); void node.offsetWidth; node.classList.add('hop'); }
let lastTotal = 0;
function checkUnlock(){ lastTotal = totalStars(); }
function openBuy(key, val, label, price, after){
  const box = openOv();
  box.appendChild(el('div',{class:'msg',text:`「${label}」`}));
  box.appendChild(el('div',{class:'buy-av',html:avatarSVG(Object.assign({}, AV, {[key]:val}), 'happy', '0 0 120 120', true, true)}));
  const can = META.pts >= price;
  box.appendChild(el('div',{style:'font-size:20px;margin:6px 0',html:`ねだん <b class="coin">🪙 ${price}</b>　／　もっている <b class="coin">🪙 ${META.pts}</b>`}));
  const btns = el('div',{class:'btns'});
  const buy = el('button',{class:'big-btn' + (can ? ' green' : ' gray'),html: can ? `🛍️ 🪙${price} で かう` : `あと 🪙${price - META.pts} あつめよう`});
  buy.onclick = () => {
    if (!can){ closeOv(); return; }
    META.pts -= price; META.owned.push(key + ':' + val); saveMeta();
    AV[key] = val; saveAV(); beep('win'); confetti(16); closeOv();
    toast(`「${label}」を てに いれた！`); if (after) after();
  };
  const no = el('button',{class:'big-btn gray',text:'やめる'}); no.onclick = closeOv;
  btns.appendChild(buy); btns.appendChild(no); box.appendChild(btns);
}
function renderAvatar(s){
  setTitle('キャラ・ショップ');
  const wrap = el('div',{class:'ave'});
  const left = el('div',{class:'card ave-prev'});
  const big = el('button',{class:'av-big'});
  const nm = el('div',{class:'av-name'});
  const coin = el('div',{class:'av-coin'});
  let expr = 'normal';
  const draw = () => { big.innerHTML = avatarSVG(AV, expr, '0 0 120 120', true, true); nm.textContent = AV.name || '（なまえ なし）'; coin.innerHTML = `🪙 <b>${META.pts}</b>`; };
  big.onclick = () => { const o = ['normal','happy','think','cheer']; expr = o[(o.indexOf(expr)+1) % o.length]; draw(); hop(big); beep('tap'); };
  left.appendChild(coin); left.appendChild(big); left.appendChild(nm);
  left.appendChild(el('div',{class:'muted',style:'font-size:13px;margin-top:2px',text:'キャラを タッチすると かおが かわるよ'}));
  const lb = el('div',{class:'row',style:'margin-top:10px'});
  const rnd = el('button',{class:'big-btn gray',html:'🎲 おまかせ'});
  const ok = el('button',{class:'big-btn green',html:'✅ できた'});
  lb.appendChild(rnd); lb.appendChild(ok); left.appendChild(lb);
  const right = el('div',{class:'card'});
  const tabs = el('div',{class:'av-tabs'});
  const panel = el('div',{class:'av-panel'});
  const TABS = [['pose','🙌','ポーズ'],['face','🙂','かお'],['hair','💇','かみ'],['eyes','👀','め・くち'],['outfit','👕','ふく'],['acc','🎀','こもの'],['item','🪄','もちもの'],['pet','🐣','ペット'],['bg','🌈','はいけい'],['name','✏️','なまえ']];
  let tab = 'pose';
  const set = patch => { Object.assign(AV, patch); saveAV(); expr = 'normal'; draw(); hop(big); beep('tap'); fill(); };
  const FACEVB = '22 18 76 76', BODYVB = '0 50 120 70';
  const thumbs = (title, list, key, opts={}) => {
    if (title) panel.appendChild(el('h4',{text:title}));
    const g = el('div',{class:'av-opts'});
    list.forEach(item => {
      const [v, label] = item; const price = priceOf(key, v); const mine = owns(key, v);
      const b = el('button',{class:'av-opt' + (AV[key] === v ? ' on' : '') + (mine ? '' : ' locked')});
      if (opts.full) b.classList.add(opts.wide ? 'wide' : 'tall');
      b.innerHTML = avatarSVG(Object.assign({}, AV, {[key]:v}), 'normal', opts.vb || '0 0 120 120', false, !!opts.full) + `<span>${mine ? esc(label) : price < 0 ? '🎁イベント' : '🪙' + price}</span>`;
      if (price < 0 && !mine) b.classList.add('evonly');
      b.onclick = () => mine ? set({[key]:v}) : price < 0 ? toast(`「${label}」は ${evMonthOf(key, v)}がつの イベントで もらえるよ`) : openBuy(key, v, label, price, () => { draw(); fill(); });
      g.appendChild(b);
    });
    panel.appendChild(g);
  };
  const swatches = (title, list, key) => {
    panel.appendChild(el('h4',{text:title}));
    const g = el('div',{class:'pcols'});
    list.forEach(c => { const b = el('button',{class:'sw' + (AV[key] === c ? ' on' : ''),style:`background:${c}`}); b.onclick = () => set({[key]:c}); g.appendChild(b); });
    panel.appendChild(g);
  };
  function fill(){
    panel.innerHTML = '';
    tabs.querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.t === tab));
    if (tab === 'pose') thumbs('', POSES, 'pose', {full:true});
    if (tab === 'face'){ thumbs('かおの かたち', FACES, 'face'); swatches('はだの いろ', SKINS, 'skin'); thumbs('ほっぺ', CHEEKS, 'cheek', {vb:FACEVB}); }
    if (tab === 'hair'){ thumbs('', HAIRS, 'hair'); swatches('かみの いろ', HAIR_COLORS, 'hairColor'); thumbs('かみの ひかり', HAIR_SHINES, 'hairShine', {vb:'14 0 92 70'}); }
    if (tab === 'eyes'){ thumbs('め', EYES, 'eyes', {vb:FACEVB}); swatches('ひとみの いろ', EYE_COLORS, 'eyeColor'); thumbs('くち', MOUTHS, 'mouth', {vb:FACEVB}); }
    if (tab === 'outfit'){ thumbs('', OUTFITS, 'outfit', {full:true}); thumbs('くつ', SHOES, 'shoes', {full:true, vb:'24 152 72 46', wide:true}); swatches('くつの いろ', SHOE_COLORS, 'shoeColor'); { const g = panel.lastChild; const b = el('button',{class:'sw sw-auto' + (!AV.shoeColor ? ' on' : ''), text:'おまかせ'}); b.onclick = () => set({shoeColor:''}); g.insertBefore(b, g.firstChild); } swatches('ふくの いろ', CLOTHES, 'clothes'); }
    if (tab === 'acc') thumbs('', ACCS, 'acc');
    if (tab === 'pet') thumbs('', PETS, 'pet', {full:true});
    if (tab === 'item') thumbs('', ITEMS, 'item', {full:true});
    if (tab === 'bg'){ swatches('いろ', BGS, 'bg'); thumbs('もよう', BG_PATTERNS, 'bg', {full:true}); thumbs('エフェクト', EFFECTS, 'effect', {full:true}); }
    if (tab === 'name'){
      panel.appendChild(el('h4',{text:'なまえ（8もじまで）'}));
      const inp = el('input',{type:'text',maxlength:8,value:AV.name,placeholder:'ここに なまえを かいてね',class:'av-input',autocomplete:'off'});
      inp.oninput = () => { AV.name = inp.value.slice(0,8); saveAV(); draw(); };
      panel.appendChild(inp);
      panel.appendChild(el('p',{class:'muted',style:'font-size:14px',text:'ホームや はなまるの ときに よばれるよ'}));
      panel.appendChild(el('p',{class:'name-note',text:'⚠️ ほんとうの なまえは いれないでね。ニックネームに しよう。'}));
    }
    if (['outfit','acc','pet','bg','item'].includes(tab)) panel.appendChild(el('p',{class:'muted',style:'font-size:13px;margin:8px 0 0',text:'🪙の ついた ものは ポイントで かえるよ。タッチすると ためしに きせて みられるよ'}));
    requestAnimationFrame(layout);
  }
  TABS.forEach(([t,i,l]) => { const b = el('button',{'data-t':t,html:`<span>${i}</span>${l}`}); b.onclick = () => { tab = t; fill(); }; tabs.appendChild(b); });
  rnd.onclick = () => {
    const pick = (a, key) => { const ok = key ? a.filter(x => owns(key, x[0])) : a; return ok[Math.floor(Math.random()*ok.length)]; };
    const any = a => a[Math.floor(Math.random()*a.length)];
    Object.assign(AV, {face:any(FACES)[0], skin:any(SKINS), hair:any(HAIRS)[0], hairColor:any(HAIR_COLORS), eyes:any(EYES)[0], mouth:any(MOUTHS)[0],
      outfit:pick(OUTFITS,'outfit')[0], shoes:pick(SHOES,'shoes')[0], shoeColor:Math.random() < .5 ? '' : any(SHOE_COLORS), clothes:any(CLOTHES), bg:any(BGS), acc:pick(ACCS,'acc')[0], pet:pick(PETS,'pet')[0], effect:pick(EFFECTS,'effect')[0], item:pick(ITEMS,'item')[0], eyeColor:any(EYE_COLORS), hairShine:any(HAIR_SHINES)[0], cheek:any(CHEEKS)[0], pose:any(POSES)[0]});
    saveAV(); expr = 'happy'; draw(); hop(big); beep('ok'); fill();
  };
  ok.onclick = () => { saveAV(); progressChanged(); beep('win'); back(); };
  right.appendChild(tabs); right.appendChild(panel);
  wrap.appendChild(left); wrap.appendChild(right);
  s.appendChild(wrap);
  draw(); fill();
}

/* ===== きせつの イベント ===== */
const EVENTS = __EVENTS__;
const currentEvent = (d = new Date()) => EVENTS.find(e => e.m === d.getMonth() + 1);
const evKey = e => e.id + '-' + new Date().getFullYear();
function evState(e){ META.ev = META.ev || {}; const k = evKey(e); return META.ev[k] = META.ev[k] || {pr:[], read:[], best:0, done:{}, claimed:false}; }
const evKanji = e => [...new Set(e.words.map(w => w[3]))];
const EV_MISSIONS = e => [
  {id:'p', t:'きせつの かんじを 5こ れんしゅう', goal:5, prog:s => s.pr.length},
  {id:'r', t:'ことわざを ぜんぶ よむ', goal:e.prov.length, prog:s => s.read.length},
  {id:'t', t:'きせつの かきとりテストで 6もん いじょう せいかい', goal:6, prog:s => s.best}
];
const evMonthOf = (key, val) => { const e = EVENTS.find(x => x.reward[0] === key && x.reward[1] === val); return e ? e.m : '?'; };
function checkEvent(){
  const e = currentEvent(); if (!e) return; const s = evState(e);
  EV_MISSIONS(e).forEach(m => { if (!s.done[m.id] && m.prog(s) >= m.goal){ s.done[m.id] = 1; addPts(20, e.icon, 'イベント ミッション クリア！ ' + m.t); } });
  if (!s.claimed && EV_MISSIONS(e).every(m => s.done[m.id])){
    s.claimed = true; const [key, val, label] = e.reward; const id = key + ':' + val;
    if (!META.owned.includes(id)) META.owned.push(id);
    META.evDone = (META.evDone || 0) + 1;
    addPts(50, '🎁', `イベント コンプリート！「${label}」を ゲット！`);
  }
}
function evNote(k){ const e = currentEvent(); if (e && evKanji(e).includes(k)){ const s = evState(e); if (!s.pr.includes(k)) s.pr.push(k); } }
function startEventTest(e){
  const qs = shuffle(e.words).map(w => ({k:w[3], w:[w[0], w[1], w[2]]}));
  go('test', {qs, i:0, res:[], label:e.icon + ' きせつの', ev:e.id});
}
function evBar(){
  const e = currentEvent(); if (!e) return null;
  const s = evState(e); const n = EV_MISSIONS(e).filter(m => s.done[m.id]).length;
  const b = el('button',{class:'evbar',style:`--ec:${e.color}`,html:`<span class="ei">${e.icon}</span><span class="et"><small>${e.m}がつの イベント</small>「${esc(e.title)}」</span><span class="ep">${s.claimed ? '🎁 コンプリート！' : `ミッション <b>${n}/3</b>`}</span><span class="ea">▶</span>`});
  b.onclick = () => { beep('tap'); go('event'); };
  return b;
}
function renderEvent(s){
  const e = currentEvent(); if (!e){ home(); return; }
  const st = evState(e);
  setTitle(`${e.icon} ${e.m}がつの イベント`);
  const wrap = el('div',{class:'evw',style:`--ec:${e.color}`});
  const left = el('div',{class:'evl'});
  const last = new Date(new Date().getFullYear(), e.m, 0).getDate();
  left.appendChild(el('div',{class:'card evban',html:`<div class="evic">${e.icon}</div><div><div class="evt">${esc(e.title)}</div><div class="evd">${e.m}/1 〜 ${e.m}/${last}</div><div class="evds">${esc(e.desc)}</div></div>`}));
  const ml = el('div',{class:'card mlist'});
  ml.appendChild(el('div',{class:'mh',html:`🎯 イベント ミッション <small>1つ +20🪙・ぜんぶで げんてい アイテム！</small>`}));
  EV_MISSIONS(e).forEach(m => { const p = Math.min(m.goal, m.prog(st)), done = st.done[m.id];
    ml.appendChild(el('div',{class:'mi' + (done ? ' done' : ''),html:`<div class="mt">${done ? '✅' : '⬜'} ${esc(m.t)}</div><div class="mb"><i style="width:${p/m.goal*100}%"></i></div><div class="mr">${p}/${m.goal}</div>`})); });
  left.appendChild(ml);
  const [rk, rv, rl] = e.reward;
  const rw = el('div',{class:'card evrw'});
  rw.innerHTML = `<div class="evrav">${avatarSVG(Object.assign({}, AV, {[rk]:rv}), st.claimed ? 'cheer' : 'happy', '0 0 120 120', true, true)}</div><div><div class="evrt">🎁 げんてい アイテム</div><div class="evrl">「${esc(rl)}」</div><div class="evrs">${st.claimed ? 'ゲットしたよ！ キャラ・ショップで つけてみよう' : 'ミッションを 3つ ぜんぶ クリアすると もらえるよ（+50🪙）'}</div></div>`;
  if (st.claimed){ const b = el('button',{class:'big-btn green',style:'margin-top:8px;width:100%;min-height:48px;font-size:17px',text:'🛍️ つけてみる'}); b.onclick = () => { AV[rk] = rv; saveAV(); go('avatar'); }; rw.lastChild.appendChild(b); }
  left.appendChild(rw);
  const right = el('div',{class:'evr'});
  const wc = el('div',{class:'card'});
  wc.appendChild(el('h3',{html:'📚 きせつの ことば <small>タッチで れんしゅう・🔈で よみあげ</small>'}));
  const wg = el('div',{class:'evwords'});
  const ctx = evKanji(e);
  e.words.forEach(([w, r, m, f]) => {
    const did = st.pr.includes(f);
    const c = el('div',{class:'evword' + (did ? ' did' : '')});
    c.innerHTML = `<div class="ew"><ruby>${[...w].map(ch => ch === f ? `<em>${ch}</em>` : esc(ch)).join('')}<rt>${esc(r)}</rt></ruby>${did ? '<span class="ok">✅</span>' : ''}</div><div class="em">${esc(m)}</div>`;
    const sp = el('button',{class:'esp',text:'🔈'}); sp.onclick = ev => { ev.stopPropagation(); say(r); };
    c.appendChild(sp);
    c.onclick = () => { beep('tap'); go('kanji',{k:f, ctx}); };
    wg.appendChild(c);
  });
  wc.appendChild(wg); right.appendChild(wc);
  const pc = el('div',{class:'card'});
  pc.appendChild(el('h3',{html:'📜 きせつの ことわざ <small>🔈 よむ で よんだ ことに なるよ</small>'}));
  e.prov.forEach(([p, r, m], i) => {
    const read = st.read.includes(i);
    const c = el('div',{class:'evprov' + (read ? ' did' : '')});
    c.innerHTML = `<div class="pt">${esc(p)}</div><div class="prr">${esc(r)}</div><div class="pm">💡 ${esc(m)}</div>`;
    const b = el('button',{class:'pbtn',text: read ? '✅ よんだ' : '🔈 よむ'});
    b.onclick = () => { say(r); if (!st.read.includes(i)){ st.read.push(i); progressChanged(); setTimeout(() => render(), 300); } };
    c.appendChild(b); pc.appendChild(c);
  });
  right.appendChild(pc);
  const tb = el('button',{class:'big-btn blue',style:'width:100%',html:`📝 きせつの かきとり テスト（${e.words.length}もん）${st.best ? `　さいこう ${st.best}もん` : ''}`});
  tb.onclick = () => startEventTest(e);
  right.appendChild(tb);
  wrap.appendChild(left); wrap.appendChild(right);
  s.appendChild(wrap);
}

/* ===== ポイント・ログインボーナス・ミッション・バッジ ===== */
const today = (d = new Date()) => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
const dayDiff = (a, b) => Math.round((new Date(b + 'T12:00:00') - new Date(a + 'T12:00:00')) / 864e5);
const md = s => { const p = String(s).split('-'); return p.length === 3 ? `${+p[1]}/${+p[2]}` : ''; };
const META_DEFAULT = {pts:0, earned:0, owned:[], badges:{}, days:{}, last:'', streak:0, best:0, hana:0, tests:0, perfect:0, welcomed:false, mis:{}};
let META = Object.assign({}, META_DEFAULT, store.get('kkr.meta', {}));
['owned'].forEach(k => { if (!Array.isArray(META[k])) META[k] = []; });
['badges','days','mis'].forEach(k => { if (!META[k] || typeof META[k] !== 'object') META[k] = {}; });
// 以前に★で使えた こもの は もっている ことに する
if (!META.owned.length && ['crown','catears','sunglasses'].includes(AV.acc)) META.owned.push('acc:' + AV.acc);
const saveMeta = () => { store.set('kkr.meta', META); touch(); };
function dayRec(){ const t = today(); return META.days[t] = META.days[t] || {}; }
function bump(key, n=1){ const r = dayRec(); r[key] = (r[key] || 0) + n; }
const masterCount = () => ALLK.filter(k => stars(k) === 3).length;
const doneCount = () => ALLK.filter(k => { const p = prog[k]; return p && (p.tr || p.fr); }).length;
const practicedDays = () => Object.values(META.days).filter(r => (r.done || 0) + (r.tests || 0) > 0).length;
/* ごほうびの おしらせ（じゅんばんに でる） */
const rewardQ = []; let rewardBusy = false;
function rewardToast(icon, title, pts){
  rewardQ.push({icon, title, pts});
  if (!rewardBusy) nextReward();
}
function nextReward(){
  const r = rewardQ.shift(); if (!r){ rewardBusy = false; return; }
  rewardBusy = true;
  let t = document.getElementById('reward');
  if (!t){ t = el('div',{id:'reward'}); document.body.appendChild(t); t.onclick = () => { clearTimeout(rewardTimer); hideReward(); }; }
  t.innerHTML = `<span class="ri">${r.icon}</span><span class="rt">${esc(r.title)}</span>${r.pts ? `<b class="rp">+${r.pts} 🪙</b>` : ''}`;
  t.className = 'show'; beep('win');
  clearTimeout(rewardTimer); rewardTimer = setTimeout(hideReward, 2600);
}
let rewardTimer = 0;
function hideReward(){ const t = document.getElementById('reward'); if (t) t.className = ''; setTimeout(nextReward, 350); }
function addPts(n, icon, title){ if (!n) return; META.pts += n; META.earned += n; if (title) rewardToast(icon, title, n); updCoins(); }
function updCoins(){ document.querySelectorAll('.coin-now').forEach(e => e.textContent = META.pts); }
/* ミッション */
const MISSION_POOL = [
  {id:'kanji3', t:'かんじを 3こ れんしゅう しよう', goal:3, key:'done', pts:15},
  {id:'free3', t:'おてほん なしで 3こ かこう', goal:3, key:'fr', pts:20},
  {id:'hana2', t:'はなまるを 2こ もらおう', goal:2, key:'hana', pts:20},
  {id:'test1', t:'かきとりテストを 1かい やろう', goal:1, key:'tests', pts:20},
  {id:'good8', t:'テストで 8もん いじょう せいかい', goal:8, key:'bestTest', pts:30},
  {id:'new2', t:'はじめての かんじを 2こ れんしゅう', goal:2, key:'newk', pts:20},
  {id:'trace5', t:'なぞりがきを 5こ やろう', goal:5, key:'tr', pts:15}
];
function todaysMissions(t = today()){
  let h = 0; for (const c of t) h = (h * 31 + c.charCodeAt(0)) >>> 0;
  const pool = MISSION_POOL.slice(), out = [];
  while (out.length < 3){ h = (h * 1103515245 + 12345) >>> 0; out.push(pool.splice(h % pool.length, 1)[0]); }
  return out;
}
const missionProg = m => Math.min(m.goal, (dayRec()[m.key] || 0));
function checkMissions(){
  const t = today(); const st = META.mis[t] = META.mis[t] || {};
  const ms = todaysMissions(t);
  ms.forEach(m => { if (!st[m.id] && missionProg(m) >= m.goal){ st[m.id] = 1; addPts(m.pts, '🎯', 'ミッション クリア！ ' + m.t); } });
  if (!st.all && ms.every(m => st[m.id])){ st.all = 1; addPts(30, '🏅', 'きょうの ミッション ぜんぶ クリア！'); }
  Object.keys(META.mis).sort().slice(0, -7).forEach(k => delete META.mis[k]);
}
/* バッジ */
const BADGES = [
  {id:'first', icon:'🌱', t:'はじめの いっぽ', d:'はじめて かんじを れんしゅう した', pts:10, ok:() => doneCount() >= 1},
  {id:'av', icon:'🎨', t:'キャラ デビュー', d:'じぶんの キャラを つくった', pts:10, ok:() => hasAV},
  {id:'hana1', icon:'💮', t:'はじめての はなまる', d:'はなまるを 1こ もらった', pts:10, ok:() => META.hana >= 1},
  {id:'hana10', icon:'🌸', t:'はなまる 10こ', d:'はなまるを 10こ もらった', pts:20, ok:() => META.hana >= 10},
  {id:'hana50', icon:'🌺', t:'はなまる 50こ', d:'はなまるを 50こ もらった', pts:50, ok:() => META.hana >= 50},
  {id:'hana100', icon:'💐', t:'はなまる 100こ', d:'はなまるを 100こ もらった', pts:100, ok:() => META.hana >= 100},
  {id:'t1', icon:'📝', t:'はじめての テスト', d:'かきとりテストを さいごまで やった', pts:10, ok:() => META.tests >= 1},
  {id:'t10', icon:'📚', t:'テスト 10かい', d:'かきとりテストを 10かい やった', pts:40, ok:() => META.tests >= 10},
  {id:'tp', icon:'💯', t:'ぜんもん せいかい', d:'テストで ぜんもん せいかい した', pts:50, ok:() => META.perfect >= 1},
  {id:'m10', icon:'⭐', t:'マスター 10じ', d:'★3の かんじが 10こ', pts:30, ok:() => masterCount() >= 10},
  {id:'m50', icon:'🌟', t:'マスター 50じ', d:'★3の かんじが 50こ', pts:80, ok:() => masterCount() >= 50},
  {id:'m100', icon:'✨', t:'マスター 100じ', d:'★3の かんじが 100こ', pts:150, ok:() => masterCount() >= 100},
  {id:'m300', icon:'👑', t:'マスター 300じ', d:'★3の かんじが 300こ', pts:300, ok:() => masterCount() >= 300},
  {id:'s3', icon:'🔥', t:'3にち れんぞく', d:'3にち つづけて ひらいた', pts:20, ok:() => META.best >= 3},
  {id:'s7', icon:'☄️', t:'7にち れんぞく', d:'7にち つづけて ひらいた', pts:50, ok:() => META.best >= 7},
  {id:'s30', icon:'🏆', t:'30にち れんぞく', d:'30にち つづけて ひらいた', pts:200, ok:() => META.best >= 30},
  {id:'ev1', icon:'🎉', t:'イベント デビュー', d:'きせつの イベントを 1かい コンプリート', pts:30, ok:() => (META.evDone || 0) >= 1},
  {id:'ev3', icon:'🎊', t:'イベント マスター', d:'きせつの イベントを 3かい コンプリート', pts:80, ok:() => (META.evDone || 0) >= 3},
  {id:'ev12', icon:'🗓️', t:'1ねん まるごと', d:'きせつの イベントを 12かい コンプリート', pts:300, ok:() => (META.evDone || 0) >= 12},
  {id:'d10', icon:'📅', t:'10にち れんしゅう', d:'れんしゅうした ひが 10にち', pts:40, ok:() => practicedDays() >= 10},
  {id:'d50', icon:'🗓️', t:'50にち れんしゅう', d:'れんしゅうした ひが 50にち', pts:150, ok:() => practicedDays() >= 50},
  ...LEVELS.flatMap(L => [
    {id:'L' + L.id + 'a', icon:'✏️', t:`${L.name} ぜんぶ れんしゅう`, d:`${L.name}の かんじを ぜんぶ れんしゅう した`, pts:60, ok:() => L.list.every(k => { const p = prog[k]; return p && (p.tr || p.fr); })},
    {id:'L' + L.id + 'm', icon:'🎓', t:`${L.name} はかせ`, d:`${L.name}の かんじが ぜんぶ ★3`, pts:200, ok:() => L.list.every(k => stars(k) === 3)}
  ])
];
function checkBadges(){
  BADGES.forEach(b => { if (!META.badges[b.id] && b.ok()){ META.badges[b.id] = today(); addPts(b.pts, b.icon, 'バッジ ゲット！「' + b.t + '」'); } });
}
function progressChanged(){ checkMissions(); checkEvent(); checkBadges(); saveMeta(); }
/* ログインボーナス */
function checkLogin(){
  const t = today();
  if (META.last === t) return;
  META.streak = META.last && dayDiff(META.last, t) === 1 ? META.streak + 1 : 1;
  META.best = Math.max(META.best || 0, META.streak); META.last = t;
  let bonus = 10 + Math.min(META.streak - 1, 5) * 2; const lines = [`ログイン ボーナス　+${bonus} 🪙`];
  if (META.streak % 7 === 0){ bonus += 30; lines.push(`🎉 ${META.streak}にち れんぞく ボーナス　+30 🪙`); }
  let welcome = 0;
  if (!META.welcomed){ welcome = 30 + totalStars() * 2; META.welcomed = true; lines.unshift(`🎁 これまでの がんばり ボーナス　+${welcome} 🪙`); }
  META.pts += bonus + welcome; META.earned += bonus + welcome;
  saveMeta();
  setTimeout(() => {
    const box = openOv();
    box.appendChild(el('div',{class:'ov-top'}));
    box.firstChild.appendChild(el('div',{class:'ov-av hop',html:avatarSVG(AV,'cheer','0 0 120 120',true,true)}));
    box.firstChild.appendChild(el('div',{class:'login-st',html:`<div class="fire">🔥</div><b>${META.streak}</b><small>にち れんぞく</small>`}));
    box.appendChild(el('div',{class:'msg',text:(AV.name ? AV.name + '、' : '') + 'きょうも きてくれて ありがとう！'}));
    box.appendChild(el('div',{class:'login-lines',html:lines.map(esc).join('<br>')}));
    box.appendChild(el('div',{class:'login-week',html:weekDots()}));
    box.appendChild(missionList());
    const ce = currentEvent(); if (ce) box.appendChild(el('div',{class:'login-ev',html:`${ce.icon} いまは ${ce.m}がつの イベント「${esc(ce.title)}」！ げんてい アイテムを ゲットしよう`}));
    const b = el('button',{class:'big-btn',style:'width:100%;margin-top:12px',text:'きょうも がんばる！'});
    b.onclick = () => { closeOv(); progressChanged(); if (cur && cur.name === 'home') render(); };
    box.appendChild(b);
    beep('win'); confetti(14);
  }, 400);
}
function weekDots(){
  const out = []; const d = new Date();
  for (let i=6;i>=0;i--){ const x = new Date(d); x.setDate(d.getDate() - i); const k = today(x); const r = META.days[k];
    const did = r && ((r.done||0) + (r.tests||0) > 0) || (k === META.last && i === 0);
    out.push(`<span class="${did ? 'on' : ''}${i === 0 ? ' td' : ''}"><i>${['にち','げつ','か','すい','もく','きん','ど'][x.getDay()]}</i>${did ? '🔥' : '・'}</span>`); }
  return out.join('');
}
function missionList(){
  const t = today(); const st = META.mis[t] || {};
  const box = el('div',{class:'mlist'});
  box.appendChild(el('div',{class:'mh',html:'🎯 きょうの ミッション <small>ぜんぶ クリアで +30 🪙</small>'}));
  todaysMissions(t).forEach(m => {
    const p = missionProg(m), done = st[m.id];
    box.appendChild(el('div',{class:'mi' + (done ? ' done' : ''),html:`<div class="mt">${done ? '✅' : '⬜'} ${esc(m.t)}</div><div class="mb"><i style="width:${p/m.goal*100}%"></i></div><div class="mr">${p}/${m.goal}　+${m.pts}🪙</div>`}));
  });
  return box;
}
function openMissions(){
  const box = openOv();
  box.appendChild(el('div',{class:'msg',html:`🔥 ${META.streak}にち れんぞく　／　🪙 <span class="coin-now">${META.pts}</span>`}));
  box.appendChild(el('div',{class:'login-week',html:weekDots()}));
  box.appendChild(missionList());
  const b = el('button',{class:'big-btn gray',style:'width:100%;margin-top:12px',text:'とじる'}); b.onclick = closeOv; box.appendChild(b);
}
/* きろく がめん */
function renderRecord(s){
  setTitle('きろく');
  const wrap = el('div',{class:'rec'});
  const left = el('div',{class:'rec-l'});
  const total = totalStars();
  left.appendChild(el('div',{class:'card rec-sum',html:`<div class="rs-av">${avatarSVG(AV,'happy','0 0 120 120',true,true)}</div>
    <div class="rs-grid">
      <div><b>🪙 ${META.pts}</b><small>ポイント（ぜんぶで ${META.earned}）</small></div>
      <div><b>🔥 ${META.streak}</b><small>れんぞく（さいこう ${META.best}）</small></div>
      <div><b>★ ${total}</b><small>あつめた ★</small></div>
      <div><b>👑 ${masterCount()}</b><small>マスター（★3）</small></div>
      <div><b>💮 ${META.hana}</b><small>はなまる</small></div>
      <div><b>📅 ${practicedDays()}</b><small>れんしゅう した ひ</small></div>
    </div>`}));
  // カレンダー（5しゅう）
  const cal = el('div',{class:'card rec-cal'});
  cal.appendChild(el('h3',{text:'📅 れんしゅう カレンダー'}));
  const g = el('div',{class:'calg'});
  ['にち','げつ','か','すい','もく','きん','ど'].forEach(w => g.appendChild(el('span',{class:'cw',text:w})));
  const now = new Date(); const start = new Date(now); start.setDate(now.getDate() - now.getDay() - 28);
  for (let i=0;i<35;i++){
    const x = new Date(start); x.setDate(start.getDate() + i); const k = today(x); const r = META.days[k] || {};
    const n = (r.done || 0) + (r.tests || 0); const lv = n === 0 ? 0 : n < 3 ? 1 : n < 8 ? 2 : 3;
    g.appendChild(el('span',{class:`cd l${lv}${k === today() ? ' td' : ''}${x > now ? ' fu' : ''}`,html:`<i>${x.getDate()}</i>`}));
  }
  cal.appendChild(g);
  cal.appendChild(el('div',{class:'muted',style:'font-size:12px;margin-top:4px',text:'いろが こいほど たくさん れんしゅう した ひ'}));
  left.appendChild(cal);
  const right = el('div',{class:'rec-r'});
  const lvs = el('div',{class:'card rec-lv'});
  lvs.appendChild(el('h3',{text:'📈 きゅうごとの すすみぐあい'}));
  const lvg = el('div',{class:'lvgrid' + (LEVELS.length > 6 ? ' two' : '')}); lvs.appendChild(lvg);
  LEVELS.forEach(L => {
    const c = [0,0,0,0]; L.list.forEach(k => c[stars(k)]++); const n = L.list.length;
    const row = el('button',{class:'lvrow',html:`<span class="ln" style="color:${L.color}">${L.name}</span>
      <span class="lb"><i class="b3" style="width:${c[3]/n*100}%;background:${L.color}"></i><i class="b2" style="width:${c[2]/n*100}%;background:${L.color}"></i><i class="b1" style="width:${c[1]/n*100}%;background:${L.color}"></i></span>
      <span class="lc">👑${c[3]}<small>/${n}</small></span>`});
    row.onclick = () => go('list',{g:L.g});
    lvg.appendChild(row);
  });
  lvs.appendChild(el('div',{class:'muted',style:'font-size:12px;margin-top:4px',text:'こい いろ＝★3（マスター）・うすい いろ＝★2・★1'}));
  right.appendChild(lvs);
  const bd = el('div',{class:'card rec-bd'});
  const got = BADGES.filter(b => META.badges[b.id]).length;
  bd.appendChild(el('h3',{html:`🏅 バッジ <small>${got} / ${BADGES.length}</small>`}));
  const bg = el('div',{class:'bdg'});
  BADGES.forEach(b => {
    const has = META.badges[b.id];
    const x = el('button',{class:'bdi' + (has ? ' on' : ''),html:`<span>${has ? b.icon : '❔'}</span><small>${esc(b.t)}</small>`});
    x.onclick = () => toast(`${has ? b.icon : '❔'} ${b.t}：${b.d}（+${b.pts}🪙）${has ? '　' + md(has) + ' に ゲット' : ''}`);
    bg.appendChild(x);
  });
  bd.appendChild(bg); right.appendChild(bd);
  wrap.appendChild(left); wrap.appendChild(right);
  s.appendChild(wrap);
}

/* ===== 保存・クラウド・バックアップ ===== */
const cloud = {state:'off', ref:null, busy:false, pending:false, last:''};
let cloudTimer = null;
function touch(){ store.set('kkr.ts', Date.now()); scheduleCloud(); }
function snapshot(){ return {app:'kanji-renshu', v:2, ts:store.get('kkr.ts', 0), prog, settings, avatar: hasAV ? AV : null, meta: META, fr: snapFriends()}; }
function snapFriends(){ try{ return {cid: myCardId(), key: store.get('kkr.ckey', null), list: friendsStore()}; }catch(e){ return undefined; } }
const pick = (v, list, def) => list.includes(v) ? v : def;
function sanitizeAV(a){
  a = a && typeof a === 'object' ? a : {};
  const ids = l => l.map(x => x[0]);
  return {
    face: pick(a.face, ids(FACES), AV_DEFAULT.face), skin: pick(a.skin, SKINS, AV_DEFAULT.skin), cheek: a.cheek === false ? 'none' : a.cheek === true ? 'normal' : pick(a.cheek, ids(CHEEKS), 'normal'),
    pose: pick(a.pose, ids(POSES), 'stand'), shoes: pick(a.shoes, ids(SHOES), 'auto'), shoeColor: pick(a.shoeColor, SHOE_COLORS.concat(['']), ''), hairShine: pick(a.hairShine, ids(HAIR_SHINES), 'none'), eyeColor: pick(a.eyeColor, EYE_COLORS, AV_DEFAULT.eyeColor), item: pick(a.item, ids(ITEMS), 'none'),
    hair: pick(a.hair, ids(HAIRS), AV_DEFAULT.hair), hairColor: pick(a.hairColor, HAIR_COLORS, AV_DEFAULT.hairColor),
    eyes: pick(a.eyes, ids(EYES), AV_DEFAULT.eyes), mouth: pick(a.mouth, ids(MOUTHS), AV_DEFAULT.mouth),
    outfit: pick(a.outfit, ids(OUTFITS), 'tshirt'), clothes: pick(a.clothes, CLOTHES, AV_DEFAULT.clothes),
    bg: pick(a.bg, BGS.concat(ids(BG_PATTERNS)), AV_DEFAULT.bg), acc: pick(a.acc, ids(ACCS), 'none'),
    pet: pick(a.pet, ids(PETS), 'none'), effect: pick(a.effect, ids(EFFECTS), 'none'),
    name: String(a.name == null ? '' : a.name).replace(/[\u0000-\u001f\u007f-\u009f\u200b-\u200f\u2028-\u202e\u2060-\u206f\ufeff]/g, '').slice(0, 8)
  };
}
const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
function sanitizeMeta(m){
  m = m && typeof m === 'object' ? m : {};
  const validOwn = new Set(Object.entries(SHOP).flatMap(([k, l]) => l.map(x => k + ':' + x[0])));
  const badgeIds = new Set(BADGES.map(b => b.id));
  const days = {}; if (m.days && typeof m.days === 'object') Object.entries(m.days).forEach(([d, r]) => { if (DATE_RE.test(d) && r && typeof r === 'object'){ const o = {}; Object.entries(r).slice(0, 16).forEach(([k, v]) => { if (/^[a-zA-Z]{1,12}$/.test(k) && k !== 'constructor') o[k] = num(v); }); days[d] = o; } });
  const badges = {}; if (m.badges && typeof m.badges === 'object') Object.entries(m.badges).forEach(([k, v]) => { if (badgeIds.has(k) && DATE_RE.test(String(v))) badges[k] = String(v); });
  const mis = {}; if (m.mis && typeof m.mis === 'object') Object.entries(m.mis).forEach(([d, r]) => { if (DATE_RE.test(d) && r && typeof r === 'object'){ const o = {}; Object.keys(r).forEach(k => { if (/^[a-z0-9]{1,10}$/.test(k)) o[k] = 1; }); mis[d] = o; } });
  const ev = {}; if (m.ev && typeof m.ev === 'object') Object.entries(m.ev).forEach(([k, s]) => { if (/^m\d{2}-\d{4}$/.test(k) && s && typeof s === 'object') ev[k] = {pr:(Array.isArray(s.pr) ? s.pr : []).filter(x => BYK[x]).slice(0, 20), read:(Array.isArray(s.read) ? s.read : []).filter(x => Number.isInteger(x) && x >= 0 && x < 10), best:num(s.best), done:{p:s.done && s.done.p ? 1 : undefined, r:s.done && s.done.r ? 1 : undefined, t:s.done && s.done.t ? 1 : undefined}, claimed:!!s.claimed}; });
  Object.values(ev).forEach(s => Object.keys(s.done).forEach(k => { if (!s.done[k]) delete s.done[k]; }));
  const lastN = (o, n) => { const ks = Object.keys(o).sort(); if (ks.length > n) ks.slice(0, ks.length - n).forEach(k => delete o[k]); };
  lastN(days, 800); lastN(mis, 60); lastN(ev, 36);
  return {ev, evDone:num(m.evDone), pts:num(m.pts), earned:num(m.earned), owned:(Array.isArray(m.owned) ? m.owned : []).filter(x => validOwn.has(x)), badges, days, mis,
    last: DATE_RE.test(String(m.last)) ? String(m.last) : '', streak:num(m.streak), best:num(m.best), hana:num(m.hana), tests:num(m.tests), perfect:num(m.perfect), welcomed: !!m.welcomed};
}
function mergeMeta(a, b, bNewer){
  b = sanitizeMeta(b);
  const base = bNewer ? Object.assign({}, a, b) : Object.assign({}, b, a);
  base.owned = [...new Set([...(a.owned||[]), ...b.owned])];
  base.badges = Object.assign({}, b.badges, a.badges);
  base.days = Object.assign({}, b.days); Object.entries(a.days || {}).forEach(([d, r]) => { const o = Object.assign({}, base.days[d] || {}); Object.entries(r).forEach(([k, v]) => { o[k] = Math.max(o[k] || 0, v || 0); }); base.days[d] = o; });
  base.mis = Object.assign({}, b.mis, a.mis);
  base.ev = Object.assign({}, b.ev, a.ev || {}); base.evDone = Math.max(a.evDone || 0, b.evDone || 0);
  ['earned','best','hana','tests','perfect'].forEach(k => base[k] = Math.max(a[k] || 0, b[k] || 0));
  base.welcomed = !!(a.welcomed || b.welcomed);
  return base;
}
function sanitizeSettings(s){
  s = s && typeof s === 'object' ? s : {};
  return {
    sound: s.sound !== false, nums: s.nums !== false,
    penMode: pick(s.penMode, ['auto','pen','all'], 'auto'), strict: pick(s.strict, ['easy','normal','hard'], 'normal'),
    penColor: pick(s.penColor, PEN_COLORS.map(x=>x[0]), '#1f2235'), penSize: pick(s.penSize, PEN_SIZES.map(x=>x[0]), 'normal'), theme: pick(s.theme, ['normal','yume','sora'], 'normal'), lvTab: Math.min(2, num(s.lvTab))
  };
}
const num = v => { v = Number(v); return isFinite(v) && v > 0 ? Math.min(Math.floor(v), 1e6) : 0; };
function mergeProg(a, b, bNewer){
  const out = {}; a = a || {}; b = (b && typeof b === 'object') ? b : {};
  new Set([...Object.keys(a), ...Object.keys(b)]).forEach(k => {
    if (!KG[k]) return;
    const x = a[k] || {}, y = (b[k] && typeof b[k] === 'object') ? b[k] : {}; const o = {};
    ['tr','fr','ts','tm'].forEach(f => { const v = Math.max(num(x[f]), num(y[f])); if (v) o[f] = v; });
    const wk = bNewer ? (y.wk !== undefined ? y.wk : x.wk) : (x.wk !== undefined ? x.wk : y.wk);
    if (wk) o.wk = 1;
    const ld = [x.ld, y.ld].filter(v => DATE_RE.test(String(v))).sort().pop(); if (ld) o.ld = ld;
    if (Object.keys(o).length) out[k] = o;
  });
  return out;
}
function applySnapshot(s){
  if (!s || typeof s !== 'object' || s.app !== 'kanji-renshu' || typeof s.prog !== 'object') throw new Error('bad');
  const localTs = store.get('kkr.ts', 0), rt = Number(s.ts), remoteTs = isFinite(rt) && rt > 0 ? Math.min(rt, Date.now() + 864e5) : 0, newer = remoteTs > localTs;
  prog = mergeProg(prog, s.prog, newer);
  if (newer && s.settings) settings = Object.assign({}, settings, sanitizeSettings(s.settings));
  if (s.avatar && (newer || !hasAV)){ AV = Object.assign({}, AV_DEFAULT, sanitizeAV(s.avatar)); hasAV = true; store.set('kkr.avatar', AV); }
  if (s.meta){ META = mergeMeta(META, s.meta, newer); store.set('kkr.meta', META); }
  /* ともだちカードの「じぶん」（ID と しょめいの かぎ）と ともだち いちらんを ひきつぐ */
  if (s.fr && typeof s.fr === 'object' && !s.legacy){
    if (typeof s.fr.cid === 'string' && /^[a-z0-9]{10}$/.test(s.fr.cid) && validJwk(s.fr.key)){
      store.set('kkr.cid', s.fr.cid); store.set('kkr.ckey', {kty:'EC', crv:'P-256', x:s.fr.key.x, y:s.fr.key.y, d:s.fr.key.d}); cardKeyP = null;
    }
    if (Array.isArray(s.fr.list)){
      s.fr.list.slice(0, FR_MAX).forEach(x => { try{ if (!x || typeof x !== 'object') return; const c = sanitizeCard(x.c); c.doubt = !c.ok || !!(x.c && x.c.dq) || cardDoubt(c, null).length > 0; if (c.id === myCardId()) return;
        const i = FRIENDS.findIndex(f => f.c.id === c.id); const f = {c, got:num(x.got)};
        if (i < 0){ if (FRIENDS.length < FR_MAX) FRIENDS.push(f); } else if (f.got > FRIENDS[i].got) FRIENDS[i] = f; }catch(e){} });
      saveFriends();
    }
  }
  store.set('kkr.prog', prog); store.set('kkr.settings', settings);
  store.set('kkr.ts', Math.max(localTs, remoteTs));
  lastTotal = totalStars();
  updSound(); if (typeof applyTheme === 'function') applyTheme();
}
async function initCloud(){
  try{
    if (!window.claude || typeof window.claude.use !== 'function') return;
    const [db, user] = await Promise.all([window.claude.use('db'), window.claude.use('user')]);
    if (!db || !user) return;
    const id = await user.id(); if (!id) return;
    cloud.ref = db.doc('data/users/' + id + '/save');
    cloud.state = 'loading'; updCloudBadge();
    const snap = await Promise.race([cloud.ref.get(), new Promise((_, rej) => setTimeout(() => rej({code:'timeout'}), 10000))]);
    if (snap.exists){
      const remote = snap.data(); cloud.last = JSON.stringify(remote);
      const before = JSON.stringify([prog, AV, settings, META]);
      try{ applySnapshot(remote); }catch(e){}
      if (JSON.stringify([prog, AV, settings, META]) !== before && cur && ['home','list','kanji'].includes(cur.name)) render();
    }
    cloud.state = 'on';
    await pushCloud();
  }catch(e){ cloud.state = e && e.code === 'invalid_argument' ? 'readonly' : 'error'; }
  updCloudBadge();
}
function scheduleCloud(){ if (!cloud.ref || cloud.state === 'readonly') return; clearTimeout(cloudTimer); cloudTimer = setTimeout(pushCloud, 2000); }
async function pushCloud(){
  if (!cloud.ref || cloud.state === 'readonly') return;
  if (cloud.busy){ cloud.pending = true; return; }
  const str = JSON.stringify(snapshot());
  if (str === cloud.last) return;
  cloud.busy = true;
  try{ await cloud.ref.set(JSON.parse(str)); cloud.last = str; cloud.state = 'on'; }
  catch(e){
    if (e && e.code === 'invalid_argument') cloud.state = 'readonly';
    else if (e && e.code === 'unavailable') setTimeout(scheduleCloud, 3000 + Math.random()*2000);
    else cloud.state = 'error';
  }
  cloud.busy = false; updCloudBadge();
  if (cloud.pending){ cloud.pending = false; scheduleCloud(); }
}
function cloudLabel(){
  return {on:'☁️ クラウドに じどうで ほぞん されています', loading:'☁️ クラウドと つないでいます…',
    readonly:'✅ じどうで ほぞん しています（この たんまつ）', error:'✅ じどうで ほぞん しています（この たんまつ）'}[cloud.state]
    || '✅ じどうで ほぞん しています（この たんまつ）';
}
function updCloudBadge(){ document.querySelectorAll('.cloud-badge').forEach(e => e.textContent = cloudLabel()); }
/* コード化 */
const b64e = s => { const by = new TextEncoder().encode(s); let bin = ''; for (let i=0;i<by.length;i+=8192) bin += String.fromCharCode.apply(null, by.subarray(i, i+8192)); return btoa(bin); };
const b64d = s => new TextDecoder().decode(Uint8Array.from(atob(s), c => c.charCodeAt(0)));
/* バックアップ（KKR2）：あっしゅく＋チェックち（HMAC）。かぎは アプリの なかに あるので、きがるな かきかえと はそんを ふせぐ ための もの */
const BK_KEY = 'kanji-renshu/backup/v2/0b6aedebfc71c66d13045f94ad55bd91', LEGACY_UNTIL = '2027-03-31';
async function bkMac(payload){
  const k = await crypto.subtle.importKey('raw', new TextEncoder().encode(BK_KEY), {name:'HMAC', hash:'SHA-256'}, false, ['sign']);
  return u8b64(new Uint8Array(await crypto.subtle.sign('HMAC', k, new TextEncoder().encode(payload))).subarray(0, 18));
}
async function makeCode(){
  const buf = await new Response(new Blob([JSON.stringify(snapshot())]).stream().pipeThrough(new CompressionStream('deflate-raw'))).arrayBuffer();
  const payload = u8b64(new Uint8Array(buf));
  return 'KKR2.' + payload + '.' + await bkMac(payload);
}
async function inflate(b64, max = 4e6){
  const by = Uint8Array.from(atob(b64), c => c.charCodeAt(0));
  const st = new Blob([by]).stream().pipeThrough(new DecompressionStream('deflate-raw'));
  const r = st.getReader(), parts = []; let n = 0;
  for (;;){ const {done, value} = await r.read(); if (done) break; n += value.length; if (n > max) throw new Error('big'); parts.push(value); }
  return new TextDecoder().decode(await new Blob(parts).arrayBuffer());
}
async function parseBackup(text, now = today()){
  text = String(text || '').trim();
  if (text.length > 4e6) throw new Error('big');
  if (text.startsWith('{')){ let o = null; try{ o = JSON.parse(text); }catch(e){} if (o && o.format === 'kanji-renshu-backup' && typeof o.code === 'string') text = o.code; }
  text = text.replace(/\s+/g, '');
  if (text.startsWith('KKR2.')){
    const m = text.match(/^KKR2\.([A-Za-z0-9+/=]+)\.([A-Za-z0-9+/=]{24})$/);
    if (!m || await bkMac(m[1]) !== m[2]) throw new Error('mac');
    const o = JSON.parse(await inflate(m[1])); if (o && typeof o === 'object') delete o.legacy; return o;
  }
  /* ふるい かたち（チェックち なし）は いこう きかんの あいだだけ */
  if (now > LEGACY_UNTIL) throw new Error('legacy');
  const o = text.startsWith('KKZ1.') ? JSON.parse(await inflate(text.slice(5))) : text.startsWith('KKR1.') ? JSON.parse(b64d(text.slice(5))) : JSON.parse(text);
  if (o && typeof o === 'object') o.legacy = true;   // ふるい かたちでは ともだちカードの じょうほうは ひきつがない
  return o;
}
async function restoreFrom(text){
  let s; try{ s = await parseBackup(text); applySnapshot(s); }catch(e){ toast(e && e.message === 'mac' ? 'コードや ファイルが こわれているか、かきかえられています' : e && e.message === 'legacy' ? 'ふるい かたちの バックアップは もう つかえません' : 'よみこめませんでした。コードや ファイルを たしかめてね'); return false; }
  touch(); closeOv(); home(); beep('win');
  toast(`きろくを もどしたよ（★ ${totalStars()}こ）`);
  return true;
}
async function saveFile(){
  const d = new Date(); const ymd = `${d.getFullYear()}${String(d.getMonth()+1).padStart(2,'0')}${String(d.getDate()).padStart(2,'0')}`;
  const filename = `kanji-kiroku-${ymd}.json`; let data;
  try{ data = JSON.stringify({format:'kanji-renshu-backup', code: await makeCode()}); }catch(e){ toast('ファイルを つくれませんでした'); return; }
  let dl = null;
  try{ if (window.claude && typeof window.claude.use === 'function') dl = await window.claude.use('downloads'); }catch(e){}
  if (dl){
    try{ await dl.save({filename, data}); toast('ファイルに ほぞんしたよ'); }
    catch(e){ if (!e || e.code !== 'declined') toast('ファイルに ほぞん できませんでした。「コード」を つかってね'); }
    return;
  }
  try{
    const url = URL.createObjectURL(new Blob([data], {type:'application/json'}));
    const a = el('a',{href:url, download:filename}); document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 4000);
  }catch(e){ toast('ファイルに ほぞん できませんでした。「コード」を つかってね'); }
}
function openBackup(){
  const box = openOv();
  box.appendChild(el('div',{class:'msg',text:'💾 きろくの ほぞん・ひきつぎ'}));
  box.appendChild(el('div',{class:'cloud-badge muted',style:'font-size:14px;margin-bottom:10px',text:cloudLabel()}));
  box.appendChild(el('p',{class:'bk-note',html:`★・にがて・キャラ・せってい・ともだちカードを まとめて ほぞんします（いまの ★：${totalStars()}こ）。<br>もどすときは、いまの きろくと <b>あわせて</b>（おおい ほうを のこして）よみこみます。`}));
  box.appendChild(el('p',{class:'name-note',style:'text-align:left',text:'⚠️ ファイルや コードには ニックネーム・きろく・ともだちカードの「かぎ」が はいっています。ひとに わたすと なりすまされることが あるので、SNSや ネットに のせないでね。'}));
  const g = el('div',{class:'btns'});
  const bFile = el('button',{class:'big-btn blue',html:'📄 ファイルに ほぞん'}); bFile.onclick = saveFile;
  const bCode = el('button',{class:'big-btn gray',html:'🔑 ひきつぎコードを コピー'});
  const codeBox = el('textarea',{class:'bk-code',readonly:'readonly',rows:3,style:'display:none'});
  bCode.onclick = async () => {
    let code; try{ code = await makeCode(); }catch(e){ toast('コードを つくれませんでした'); return; } codeBox.value = code; codeBox.style.display = 'block';
    try{ await navigator.clipboard.writeText(code); toast('コードを コピーしたよ。メッセージなどに はりつけて ほぞんしてね'); }
    catch(e){ codeBox.focus(); codeBox.select(); toast('コードを えらびました。「コピー」してね'); }
  };
  g.appendChild(bFile); g.appendChild(bCode); g.appendChild(codeBox);
  box.appendChild(g);
  box.appendChild(el('h4',{class:'bk-h',text:'⬇️ きろくを もどす'}));
  const g2 = el('div',{class:'btns'});
  const fin = el('input',{type:'file',accept:'.json,.txt,application/json,text/plain',style:'display:none'});
  fin.onchange = () => { const f = fin.files && fin.files[0]; if (!f) return; const r = new FileReader(); r.onload = () => restoreFrom(r.result); r.readAsText(f); };
  const bOpen = el('button',{class:'big-btn gray',html:'📂 ファイルから もどす'}); bOpen.onclick = () => fin.click();
  const inCode = el('textarea',{class:'bk-code',rows:3,placeholder:'ここに ひきつぎコード（KKR2. ではじまる もじ）を はりつけ'});
  const bLoad = el('button',{class:'big-btn',html:'🔑 コードから もどす'}); bLoad.onclick = () => { if (inCode.value.trim()) restoreFrom(inCode.value); else toast('コードを はりつけてね'); };
  g2.appendChild(fin); g2.appendChild(bOpen); g2.appendChild(inCode); g2.appendChild(bLoad);
  box.appendChild(g2);
  const close = el('button',{class:'big-btn gray',style:'margin-top:12px;width:100%',text:'とじる'}); close.onclick = closeOv;
  box.appendChild(close);
}

/* ===== 画面遷移 ===== */
const stack = [];
let cur = null;
function go(name, params={}, replace=false){
  const need = needPacks(name, params);
  if (need.length){ loadPacksThen(need, () => go(name, params, replace)); return; }
  if (cur && !replace) stack.push(cur);
  cur = {name, params};
  render();
}
function back(){ if (stack.length){ cur = stack.pop(); render(); } }
function home(){ stack.length = 0; cur = {name:'home', params:{}}; render(); }
function render(){
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('on'));
  closeOv();
  if (practice){ practice.destroy(); practice = null; }
  const s = document.getElementById('s-' + cur.name);
  s.innerHTML = '';
  ({home:renderHome, list:renderList, kanji:renderKanji, practice:renderPractice, test:renderTest, avatar:renderAvatar, record:renderRecord, event:renderEvent, friends:renderFriends})[cur.name](s, cur.params);
  s.classList.add('on');
  requestAnimationFrame(layout);
  $('#backBtn').classList.toggle('hide', cur.name === 'home');
  window.scrollTo(0,0);
}
$('#backBtn').onclick = () => { if (cur.name === 'test' && cur.params.i > 0 && cur.params.i < cur.params.qs.length){ ask('テストを やめて もどりますか？', 'やめる', back); return; } back(); };
function ask(msg, yes, onYes){
  const box = openOv();
  box.appendChild(el('div',{class:'msg',text:msg}));
  const btns = el('div',{class:'btns'});
  const y = el('button',{class:'big-btn',text:yes}); y.onclick = () => { closeOv(); onYes(); };
  const n = el('button',{class:'big-btn gray',text:'つづける'}); n.onclick = closeOv;
  btns.appendChild(n); btns.appendChild(y); box.appendChild(btns);
}
$('#soundBtn').onclick = () => { settings.sound = !settings.sound; saveSet(); updSound(); if (settings.sound) beep('tap'); };
function updSound(){ $('#soundBtn').textContent = settings.sound ? '🔊' : '🔇'; }
$('#setBtn').onclick = openSettings;
const setTitle = t => $('#title').textContent = t;
const APP_VERSION = '__VERSION__', APP_BUILD = '__BUILD__';
const CHANGELOG = __CHANGELOG__;
$('#verBtn').onclick = () => {
  const box = openOv();
  box.appendChild(el('div',{class:'msg',text:`バージョン ${APP_VERSION}`}));
  box.appendChild(el('div',{class:'muted',style:'font-size:14px;margin-bottom:10px',text:`つくった にちじ：${APP_BUILD}`}));
  const upd = el('div',{class:'updbox'});
  const st = el('div',{class:'updst'});
  const bChk = el('button',{class:'big-btn blue',html:'🔄 こうしんを たしかめる'});
  const bGo = el('button',{class:'big-btn green',html:'⬆️ こうしんする',style:'display:none'});
  const show = () => {
    if (update.state === 'new'){ st.textContent = `🆕 あたらしい はん v${update.remote.version}（${update.remote.build}）が あります`; bGo.style.display = ''; }
    else if (update.state === 'latest') st.textContent = '✅ いまの はんが いちばん あたらしいよ';
    else if (update.state === 'checking') st.textContent = 'たしかめています…';
    else if (update.state === 'error') st.textContent = 'たしかめられませんでした（ネットに つながっているか みてね）';
    else if (update.state === 'off') st.textContent = 'この ひらきかたでは こうしんの チェックが できません';
    else st.textContent = '';
  };
  bChk.onclick = async () => { update.state = 'checking'; show(); await checkUpdate(true); show(); };
  bGo.onclick = applyUpdate;
  upd.appendChild(st); upd.appendChild(bChk); upd.appendChild(bGo);
  box.appendChild(upd); show();
  box.appendChild(el('div',{class:'chlog-h',text:'📝 これまでの こうしん'}));
  const ul = el('div',{class:'chlog'});
  const item = ([v, d, txt]) => el('div',{html:`<b>v${esc(v)}</b> <small>${esc(d)}</small><br>${esc(txt)}`});
  CHANGELOG.slice(0, 5).forEach(x => ul.appendChild(item(x)));
  if (CHANGELOG.length > 5){
    const more = el('button',{class:'chlog-more',text:`▼ もっと みる（あと ${CHANGELOG.length - 5}こ）`});
    more.onclick = () => { more.remove(); CHANGELOG.slice(5).forEach(x => ul.appendChild(item(x))); };
    ul.appendChild(more);
  }
  box.appendChild(ul);
  const c = el('button',{class:'big-btn gray',style:'margin-top:12px;width:100%',text:'とじる'}); c.onclick = closeOv; box.appendChild(c);
};

/* ===== ホーム ===== */
function renderHome(s){
  setTitle('かんじ れんしゅう');
  const total = totalStars();
  const nextAcc = ACCS.find(a => a[2] > total);
  const me = el('div',{class:'me'});
  const ms = todaysMissions(); const mst = META.mis[today()] || {}; const mdone = ms.filter(m => mst[m.id]).length;
  me.innerHTML = `<button class="me-av av-bob">${avatarSVG(AV, 'happy', '0 0 120 120', true, true)}</button><div class="me-t">
    <div class="me-hi">${hasAV && AV.name ? esc(AV.name) + '、' : ''}きょうも がんばろう！</div>
    <div class="me-stats"><span class="chip-s">🪙 <b class="coin-now">${META.pts}</b></span><span class="chip-s">🔥 <b>${META.streak}</b>にち</span><span class="chip-s">★ <b>${total}</b></span><span class="chip-s">👑 <b>${masterCount()}</b></span></div></div>
    <div class="me-btns"><button class="mb1">🎯 ミッション <b>${mdone}/3</b></button><button class="mb2">📊 きろく</button><button class="mb3">🛍️ キャラ</button><button class="mb4">🤝 ともだち</button></div>`;
  me.querySelector('.me-av').onclick = () => { beep('tap'); go('avatar'); };
  me.querySelector('.mb1').onclick = () => { beep('tap'); openMissions(); };
  me.querySelector('.mb2').onclick = () => { beep('tap'); go('record'); };
  me.querySelector('.mb3').onclick = () => { beep('tap'); go('avatar'); };
  me.querySelector('.mb4').onclick = () => { beep('tap'); go('friends'); };
  s.appendChild(me);
  const eb = evBar(); if (eb) s.appendChild(eb); else s.appendChild(el('p',{class:'pick',text:'れんしゅうする きゅうを えらんでね'}));
  let tab = Math.min(Math.max(0, num(settings.lvTab)), LV_TABS.length - 1);
  if (LV_TABS.length > 1){
    const tabs = el('div',{class:'lv-tabs', role:'tablist'});
    LV_TABS.forEach((x, i) => { const b = el('button',{class:'lv-tab' + (i === tab ? ' on' : ''), role:'tab', 'aria-selected':String(i === tab), html:`${esc(x.t)}<small>${esc(x.s)}</small>`}); b.onclick = () => { if (i === tab) return; beep('tap'); settings.lvTab = i; saveSet(); render(); }; tabs.appendChild(b); });
    s.appendChild(tabs);
  }
  const box = el('div',{class:'levels t' + tab});
  LEVELS.filter(L => L.tab === tab).forEach(L => {
    const tot = L.list.length * 3; const got = L.list.reduce((a,k) => a + stars(k), 0);
    const b = el('button',{class:'lv',html:
      `<span class="band" style="background:${L.color}"></span>
       <div class="sample" style="color:${L.color}">${L.list[0]}</div>
       <div class="name" style="color:${L.color}">${L.name}<small>${L.gl}</small></div>
       <div class="meta">${L.list.length}じ ・ ★ ${got} / ${tot}</div>
       <div class="bar"><i style="width:${(got/tot*100).toFixed(1)}%;background:${L.color}"></i></div>`});
    b.onclick = () => { beep('tap'); go('list',{g:L.g}); };
    box.appendChild(b);
  });
  s.appendChild(box);
  const weak = ALLK.filter(k => (prog[k]||{}).wk);
  const foot = el('div',{class:'home-foot'});
  const wb = el('button',{class:'big-btn' + (weak.length ? '' : ' gray'),html:`🔁 にがてな かんじ（${weak.length}）`});
  wb.onclick = () => { if (!weak.length){ toast('にがてな かんじは まだ ないよ。テストを してみよう！'); return; } go('list',{weak:true}); };
  const bk = el('button',{class:'cloud-foot'}); bk.appendChild(el('span',{class:'cloud-badge',text:cloudLabel()})); bk.appendChild(el('b',{text:'💾 バックアップ'})); bk.onclick = openBackup;
  foot.appendChild(wb); foot.appendChild(bk);
  s.appendChild(foot);
}

/* ===== いちらん ===== */
function renderList(s, {g, weak, page = 0}){
  let list, L = null;
  if (weak){ list = ALLK.filter(k => (prog[k]||{}).wk); setTitle('にがてな かんじ'); }
  else { L = levelOf(g); list = L.list; setTitle(`${L.name}（${L.gl}）`); }
  const PG = 200, pages = Math.max(1, Math.ceil(list.length / PG)); page = Math.min(num(page), pages - 1);
  const pageList = list.slice(page * PG, (page + 1) * PG);
  const kana = k => { const d = BYK[k]; const r = d ? (d.on[0] || d.kun[0] || '') : ''; return r ? String.fromCharCode(r.charCodeAt(0) - (r.charCodeAt(0) >= 0x30a1 && r.charCodeAt(0) <= 0x30f6 ? 0x60 : 0)) : ''; };
  const head = el('div',{class:'list-head'});
  head.appendChild(el('div',{class:'ttl',html: (weak ? `にがてな かんじ <small>テストで まちがえた ${list.length}じ</small>`
    : `<span style="color:${L.color}">${L.name}</span> の かんじ <small>${L.gl}・${list.length}じ</small>`)
    + `<div class="lg"><i class="on"></i>なぞった <i class="on"></i>じぶんで かけた <i class="on"></i>テスト せいかい${weak ? '' : '　<b class="wkmark"></b>にがて'}</div>`}));
  const tb = el('button',{class:'big-btn blue',html:'📝 かきとり テスト'});
  tb.onclick = () => { if (!list.length) return; startTest(pageList, weak ? 'にがて' : `${L.name}${pages > 1 ? ' ' + (page + 1) : ''}`); };
  head.appendChild(tb);
  s.appendChild(head);
  if (pages > 1){
    const pg = el('div',{class:'pages'});
    for (let i = 0; i < pages; i++){ const a = list[i * PG], b = list[Math.min(list.length, (i + 1) * PG) - 1]; const got = list.slice(i * PG, (i + 1) * PG).reduce((x, k) => x + stars(k), 0), tot = Math.min(PG, list.length - i * PG) * 3;
      const bt = el('button',{class:'pg' + (i === page ? ' on' : ''), html:`<b>${kana(a)}〜${kana(b)}</b><small>${i * PG + 1}〜${Math.min(list.length, (i + 1) * PG)}</small><i style="width:${(got / tot * 100).toFixed(1)}%"></i>`});
      bt.onclick = () => { if (i === page) return; beep('tap'); go('list', {g, weak, page:i}, true); }; pg.appendChild(bt); }
    s.appendChild(pg);
  }
  const tiles = el('div',{class:'tiles'});
  pageList.forEach(k => {
    const n = stars(k);
    const t = el('button',{class:'tile' + ((prog[k]||{}).wk ? ' weak' : '') + ' s' + n,html:`<span class="tk">${k}</span><span class="st">${[0,1,2].map(i => `<i class="${i < n ? 'on' : ''}"></i>`).join('')}</span>`});
    t.onclick = () => { beep('tap'); go('kanji',{k, ctx:pageList}); };
    tiles.appendChild(t);
  });
  s.appendChild(tiles);
  s._layout = (W, H, phone) => {
    if (phone){ tiles.classList.remove('fixed'); tiles.style.cssText = ''; return; }
    const pgEl = s.querySelector('.pages'); const avail = H - head.offsetHeight - (pgEl ? pgEl.offsetHeight + 10 : 0) - 12, N = Math.max(1, pageList.length);
    let best = null;
    for (let sz = 112; sz >= 30; sz--){
      const gp = sz > 64 ? 10 : sz > 44 ? 6 : 4;
      const cols = Math.max(1, Math.floor((W + gp) / (sz + gp))); const rows = Math.ceil(N / cols);
      if (rows * (sz * 1.08 + gp) - gp <= avail){ best = {sz, cols, gp}; break; }
    }
    best = best || {sz:30, cols:Math.floor((W+4)/34), gp:4};
    tiles.classList.add('fixed');
    tiles.style.cssText = `grid-template-columns:repeat(${best.cols}, ${best.sz}px);gap:${best.gp}px;--ts:${best.sz}px;justify-content:center`;
  };
}

/* ===== かんじ ===== */
function renderKanji(s, {k, ctx}){
  if (!Array.isArray(ctx) || !ctx.includes(k)) ctx = [k];
  const d = BYK[k]; const L = levelOf(d.g);
  setTitle(`「${k}」の かんじ`);
  const wrap = el('div',{class:'kd'});
  // 左：かきじゅん
  const left = el('div');
  const stage = el('div',{class:'stage'});
  let mode = 'anim', step = -1, svg;
  const holder = el('div');
  const draw = () => {
    holder.innerHTML = '';
    if (mode === 'step') svg = kanjiSVG(d,{nums:settings.nums, color:false, upto:step, hi:step, width:4});
    else svg = kanjiSVG(d,{nums:settings.nums, color:mode === 'color', width:4});
    holder.appendChild(svg);
  };
  draw();
  stage.appendChild(holder);
  const ctrl = el('div',{class:'ctrl'});
  const bPlay = el('button',{html:'▶ かきじゅん'});
  const bStep = el('button',{html:'👆 1かくずつ'});
  const bNum = el('button',{html:'🔢 ばんごう', class: settings.nums ? 'on' : ''});
  const bColor = el('button',{html:'🎨 いろわけ'});
  const stepInfo = el('div',{class:'muted',style:'text-align:center;margin-top:8px;font-size:16px;min-height:22px'});
  bPlay.onclick = () => { mode = 'anim'; step = -1; stepInfo.textContent=''; draw(); animateSVG(svg); };
  bStep.onclick = () => {
    if (mode !== 'step'){ mode = 'step'; step = 0; } else step = (step + 1) % d.s.length;
    draw(); const p = svg.querySelector(`path[data-i="${step}"]`); const tmp = {_anims:[]};
    const len = p.getTotalLength(); p.style.strokeDasharray = len + ' ' + (len+10);
    p.animate([{strokeDashoffset:len},{strokeDashoffset:0}],{duration:Math.max(400,len*13),fill:'both',easing:'ease-in-out'});
    stepInfo.textContent = `${step+1}かくめ（ぜんぶで ${d.s.length}かく）` + (step === d.s.length-1 ? ' ✨おしまい' : '　もういちど おすと つぎへ');
  };
  bNum.onclick = () => { settings.nums = !settings.nums; saveSet(); bNum.classList.toggle('on', settings.nums); draw(); };
  bColor.onclick = () => { mode = mode === 'color' ? 'anim' : 'color'; bColor.classList.toggle('on', mode === 'color'); stepInfo.textContent=''; draw(); if (mode==='color') animateSVG(svg,{speed:1.6}); };
  [bPlay,bStep,bNum,bColor].forEach(b => ctrl.appendChild(b));
  stage.appendChild(ctrl); stage.appendChild(stepInfo);
  left.appendChild(stage);
  const acts = el('div',{class:'kacts'});
  const idx = ctx.indexOf(k);
  const pv = el('button',{class:'navb',html:'◀<small>まえ</small>'}), nx = el('button',{class:'navb',html:'▶<small>つぎ</small>'});
  pv.disabled = idx <= 0; nx.disabled = idx < 0 || idx >= ctx.length - 1;
  pv.onclick = () => go('kanji',{k:ctx[idx-1], ctx}, true);
  nx.onclick = () => go('kanji',{k:ctx[idx+1], ctx}, true);
  const b1 = el('button',{class:'big-btn',html:'✏️ なぞる'});
  const b2 = el('button',{class:'big-btn green',html:'✍️ じぶんで'});
  b1.onclick = () => go('practice',{k, mode:'trace', ctx});
  b2.onclick = () => go('practice',{k, mode:'free', ctx});
  acts.appendChild(pv); acts.appendChild(b1); acts.appendChild(b2); acts.appendChild(nx);
  left.appendChild(acts);
  wrap.appendChild(left);

  // 右：かいせつ
  const right = el('div');
  right.appendChild(el('div',{class:'facts',html:
    `<div class="fact"><div class="l">かくすう</div><div class="v">${d.s.length}<small>かく</small></div></div>
     <div class="fact"><div class="l">きゅう</div><div class="v" style="color:${L.color}">${L.lv}<small>きゅう</small></div></div>
     ${d.r ? `<div class="fact"><div class="l">ぶしゅ</div><div class="v">${esc(d.r)}</div></div>` : ''}
     <div class="fact frec"><div class="l">きみの きろく</div><div class="v" style="color:#f5b301;font-size:20px">${starStr(k)}</div>
       <div class="kr">${(() => { const p = prog[k] || {}; return `✏️${p.tr||0} ✍️${p.fr||0} 📝<span class="ok">○${p.ts||0}</span><span class="ng">×${p.tm||0}</span>` + (p.ld ? `<br>さいご ${md(p.ld)}` : '<br>まだ れんしゅう してないよ'); })()}</div></div>`}));
  // よみ
  const yomi = el('div',{class:'sec'});
  yomi.appendChild(el('h3',{html:'🗣️ よみかた <span class="tag">タッチで よみあげ</span>'}));
  const addReadings = (label, arr, cls, fmt) => {
    if (!arr.length) return;
    const line = el('div',{style:'display:flex;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap'});
    line.appendChild(el('div',{style:'font-size:15px;color:var(--sub);width:62px',html:label}));
    const ch = el('div',{class:'chips'});
    arr.forEach(r => { const c = el('button',{class:'chip ' + cls,html: fmt(r) + '<span class="sp">🔈</span>'}); c.onclick = () => say(plain(r)); ch.appendChild(c); });
    line.appendChild(ch); yomi.appendChild(line);
  };
  addReadings('おん<br><small>（カタカナ）</small>', d.on, 'on-r', esc);
  addReadings('くん<br><small>（ひらがな）</small>', d.kun, 'kun-r', kunHTML);
  if (d.kun.some(r => r.includes('-'))) yomi.appendChild(el('div',{class:'muted',style:'font-size:14px',html:'<span class="oku">うすい じ</span>は「おくりがな」。かんじの あとに ひらがなで かくよ。'}));
  right.appendChild(yomi);
  // いみ
  right.appendChild(el('div',{class:'sec',html:`<h3>💡 いみ</h3><div class="meaning">${esc(d.m)}</div>`}));
  // ことば
  if (d.w.length){
    const w = el('div',{class:'sec'});
    w.appendChild(el('h3',{html:'📚 つかいかた（ことば） <span class="tag">タッチで よみあげ</span>'}));
    const g = el('div',{class:'words'});
    d.w.forEach(([word, rd]) => {
      const b = el('button',{class:'word',html:`<ruby>${[...word].map(c => c === k ? `<em>${c}</em>` : esc(c)).join('')}<rt>${esc(rd)}</rt></ruby>`});
      b.onclick = () => say(rd);
      g.appendChild(b);
    });
    w.appendChild(g); right.appendChild(w);
  }
  // くみたて・なかま
  const parts = d.p.filter(p => p && p !== k);
  const nak = d.r ? DATA.filter(x => x.r === d.r && x.k !== k && x.k !== d.r).sort((a,b) => a.g - b.g).slice(0, 12) : [];
  if (parts.length >= 2 || nak.length){
    const sec = el('div',{class:'sec'});
    if (parts.length >= 2) sec.appendChild(el('div',{html:`<h3>🧩 くみたて</h3><div class="meaning" style="font-size:28px;margin-bottom:10px">${parts.map(esc).join(' ＋ ')}</div>`}));
    if (nak.length){
      sec.appendChild(el('h3',{html:`👪 「${esc(d.r)}」の なかまの かんじ`}));
      const nb = el('div',{class:'nakama'});
      nak.forEach(x => { const b = el('button',{html:`${x.k}<small>${levelOf(x.g).lv}きゅう</small>`}); b.onclick = () => go('kanji',{k:x.k, ctx:[x.k]}); nb.appendChild(b); });
      sec.appendChild(nb);
    }
    right.appendChild(sec);
  }
  wrap.appendChild(right);
  s.appendChild(wrap);
  s._layout = (W, H, phone) => {
    if (phone){ wrap.style.removeProperty('--kv'); return; }
    const portrait = H > W;
    const kv = Math.max(220, Math.min(W * (portrait ? 0.5 : 0.44), H - stage.querySelector('.ctrl').offsetHeight - stepInfo.offsetHeight - acts.offsetHeight - 84));
    wrap.style.setProperty('--kv', Math.floor(kv) + 'px');
  };
  setTimeout(() => { if (svg && svg.isConnected) animateSVG(svg); }, 250);
}

/* ===== かくパッド（共通） ===== */
let practice = null;
function makePad(container, onStroke){
  const pad = el('div',{class:'pad'});
  const guide = sel('svg',{viewBox:'0 0 109 109'});
  const cv = el('canvas');
  pad.appendChild(guide); pad.appendChild(cv);
  container.appendChild(pad);
  const ctx = cv.getContext('2d');
  let size = 300, strokes = [], curS = null, flash = null;
  function fit(W, H, phone){
    const pr = container.closest('.pr'), side = pr && pr.querySelector('.side');
    W = W || container.clientWidth || 320; H = H || window.innerHeight - 80;
    if (phone){
      // 横向きのスマホ：書く欄を左（高さいっぱい）、ボタンを右に並べる
      const land = !!(pr && side) && W > H * 1.15 && W >= 560;
      pr && pr.classList.toggle('land', land);
      if (land){ const sideW = Math.min(360, Math.max(260, W * 0.46)); side.style.width = sideW + 'px'; side.style.maxHeight = H + 'px'; size = Math.min(H - 4, W - sideW - 12); }
      else {
        if (side){ side.style.width = ''; side.style.maxHeight = ''; }
        // 縦向き：下のボタンがなるべく画面に入る大きさ（ただし小さくしすぎない）
        const rest = side ? side.offsetHeight + 12 : 0;
        size = Math.min(W, 560, Math.max(H * 0.6, H - rest));
      }
    }
    else {
      if (side) side.style.maxHeight = '';
      const sideW = Math.min(360, Math.max(290, W * 0.3)), gap = 14;
      const land = W - sideW - gap >= H * 0.92;
      pr.classList.toggle('land', land);
      if (land){ side.style.width = sideW + 'px'; size = Math.min(H, W - sideW - gap); }
      else { side.style.width = '100%'; size = Math.min(W, H - side.offsetHeight - 12); }
    }
    size = Math.max(220, Math.floor(size));
    pad.style.width = pad.style.height = size + 'px';
    const dpr = window.devicePixelRatio || 1;
    cv.width = size * dpr; cv.height = size * dpr;
    ctx.setTransform(dpr * size / 109, 0, 0, dpr * size / 109, 0, 0);
    redraw();
  }
  function seg(a, b, w, color){
    ctx.strokeStyle = color; ctx.lineWidth = w; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    ctx.beginPath(); ctx.moveTo(a[0], a[1]); ctx.lineTo(b[0], b[1]); ctx.stroke();
  }
  function drawStroke(st, color){
    const pts = st.pts;
    if (pts.length === 1){ ctx.fillStyle = color; ctx.beginPath(); ctx.arc(pts[0][0], pts[0][1], st.w[0]/2, 0, Math.PI*2); ctx.fill(); return; }
    for (let i=1;i<pts.length;i++) seg(pts[i-1], pts[i], st.w[i], color);
  }
  function redraw(){
    ctx.save(); ctx.setTransform(1,0,0,1,0,0); ctx.clearRect(0,0,cv.width,cv.height); ctx.restore();
    strokes.forEach(st => drawStroke(st, st.color || '#1f2235'));
    if (flash) drawStroke(flash, flash.color === '#e23b4e' || flash.color === '#f0609e' ? '#a7abb8' : '#ef476f');
    if (curS) drawStroke(curS, curS.color);
  }
  const toLocal = e => { const r = cv.getBoundingClientRect(); return [(e.clientX - r.left) * 109 / r.width, (e.clientY - r.top) * 109 / r.height]; };
  const widthOf = e => { const base = 5.2 * penScale(); if (e.pointerType === 'pen' && e.pressure > 0) return base * (0.55 + e.pressure * 0.9); return base; };
  const accept = e => {
    if (e.pointerType === 'pen'){ if (!penSeen){ penSeen = true; } return true; }
    if (settings.penMode === 'pen') return false;
    if (settings.penMode === 'auto' && penSeen && e.pointerType === 'touch') return false;
    return true;
  };
  cv.addEventListener('pointerdown', e => {
    if (!accept(e)) return;
    if (curS) return;
    e.preventDefault();
    try{ cv.setPointerCapture(e.pointerId); }catch(_){}
    curS = {id:e.pointerId, pts:[toLocal(e)], w:[widthOf(e)], color:settings.penColor};
    redraw();
  });
  cv.addEventListener('pointermove', e => {
    if (!curS || e.pointerId !== curS.id) return;
    e.preventDefault();
    const evs = e.getCoalescedEvents ? e.getCoalescedEvents() : [e];
    (evs.length ? evs : [e]).forEach(ev => {
      const p = toLocal(ev); const last = curS.pts[curS.pts.length-1];
      if (dist(p, last) < 0.35) return;
      const w = widthOf(ev); const pw = curS.w[curS.w.length-1]; const nw = pw * 0.7 + w * 0.3;
      curS.pts.push(p); curS.w.push(nw);
      seg(last, p, nw, curS.color);
    });
  });
  const end = e => {
    if (!curS || e.pointerId !== curS.id) return;
    const st = curS; curS = null;
    onStroke(st);
  };
  cv.addEventListener('pointerup', end);
  cv.addEventListener('pointercancel', end);
  cv.addEventListener('touchstart', e => e.preventDefault(), {passive:false});
  cv.addEventListener('touchmove', e => e.preventDefault(), {passive:false});
  return {
    guide, pad,
    get strokes(){ return strokes; },
    add(st){ strokes.push(st); redraw(); },
    flashBad(st){ flash = st; redraw(); setTimeout(() => { flash = null; redraw(); }, 450); },
    undo(){ strokes.pop(); redraw(); },
    clear(){ strokes = []; redraw(); },
    redraw, fit,
    destroy(){}
  };
}
function penBar(){
  const bar = el('div',{class:'penbar'});
  const cols = el('div',{class:'pcols'}), sizes = el('div',{class:'psizes'});
  const upd = () => {
    cols.querySelectorAll('.sw').forEach(b => b.classList.toggle('on', b.dataset.c === settings.penColor));
    sizes.querySelectorAll('.sz').forEach(b => { b.classList.toggle('on', b.dataset.s === settings.penSize); b.firstChild.style.background = settings.penColor; });
  };
  PEN_COLORS.forEach(([c,name]) => { const b = el('button',{class:'sw','data-c':c,'aria-label':name,style:`background:${c}`}); b.onclick = () => { settings.penColor = c; saveSet(); upd(); beep('tap'); }; cols.appendChild(b); });
  PEN_SIZES.forEach(([s,k,name]) => { const b = el('button',{class:'sz','data-s':s,'aria-label':name}); const dot = el('i'); const px = Math.round(8 * k + 2); dot.style.width = dot.style.height = px + 'px'; b.appendChild(dot); b.appendChild(el('span',{text:name})); b.onclick = () => { settings.penSize = s; saveSet(); upd(); beep('tap'); }; sizes.appendChild(b); });
  bar.appendChild(el('div',{class:'plabel',text:'🖍️ ペン'})); bar.appendChild(cols); bar.appendChild(sizes);
  upd();
  return bar;
}
function setGuide(svg, d, {faint=false, next=-1, doneUpto=-1} = {}){
  svg.innerHTML = '';
  gridLines(svg);
  if (faint){
    const g = sel('g',{fill:'none','stroke-linecap':'round','stroke-linejoin':'round','stroke-width':5.5});
    d.s.forEach((p,i) => g.appendChild(sel('path',{d:p, stroke: i === next ? '#ffd3b0' : '#e3e7ef'})));
    svg.appendChild(g);
  }
  if (next >= 0 && faint){
    const [x,y] = d.n[next] ? startPoint(d, next) : [0,0];
    svg.appendChild(sel('circle',{cx:x, cy:y, r:3.4, fill:'#ff7a2f', class:'pulse'}));
    const t = sel('text',{x:d.n[next][0]-1, y:d.n[next][1], 'font-size':7.5, fill:'#ff7a2f','font-weight':'bold'}); t.textContent = next+1; svg.appendChild(t);
  }
}
function startPoint(d, i){ return refOf(d)[i][0]; }
function showHint(svg, d, i){
  const p = sel('path',{d:d.s[i], fill:'none', stroke:'#ff9a52','stroke-width':5.5,'stroke-linecap':'round','stroke-linejoin':'round'});
  svg.appendChild(p);
  const len = p.getTotalLength(); p.style.strokeDasharray = len + ' ' + (len+10);
  const a = p.animate([{strokeDashoffset:len},{strokeDashoffset:0}],{duration:Math.max(500,len*14),fill:'both',easing:'ease-in-out'});
  const [x,y] = startPoint(d,i);
  const c = sel('circle',{cx:x, cy:y, r:3.4, fill:'#ff7a2f', class:'pulse'}); svg.appendChild(c);
  a.onfinish = () => setTimeout(() => { p.animate([{opacity:1},{opacity:0}],{duration:600,fill:'forwards'}).onfinish = () => { p.remove(); c.remove(); }; }, 700);
}

/* ===== れんしゅう ===== */
function renderPractice(s, {k, mode, ctx}){
  const d = BYK[k]; const ref = refOf(d);
  const trace = mode === 'trace';
  setTitle(`「${k}」を ${trace ? 'なぞって' : 'じぶんで'} かこう`);
  const wrap = el('div',{class:'pr'});
  const padBox = el('div',{class:'padbox'});
  wrap.appendChild(padBox);
  const side = el('div',{class:'side'});
  const bubble = el('div',{class:'bubble',html:'<span class="face"></span><span class="t"></span>'});
  const dots = el('div',{class:'dots'});
  const tools = el('div',{class:'tools'});
  const tHint = el('button',{class:'tool',html:'<span class="i">💡</span>ヒント'});
  const tRedo = el('button',{class:'tool',html:'<span class="i">🧽</span>やりなおし'});
  const tSwap = el('button',{class:'tool',html: trace ? '<span class="i">✍️</span>じぶんで' : '<span class="i">✏️</span>なぞる'});
  [tHint,tRedo,tSwap].forEach(b => tools.appendChild(b));
  side.appendChild(el('div',{html:`<span class="modechip">${trace ? '✏️ なぞりがき' : '✍️ おてほん なし'}</span> <span class="modechip">${d.s.length}かく</span>` + (penSeen || settings.penMode==='pen' ? ' <span class="modechip">🖊️ ペン モード</span>' : '')}));
  side.appendChild(bubble); side.appendChild(dots); side.appendChild(penBar()); side.appendChild(tools);
  wrap.appendChild(side);
  s.appendChild(wrap);

  let done = 0, miss = 0, missHere = 0, finished = false;
  const tol = (trace ? 15 : 19) * TOL[settings.strict];
  const say2 = (face, html, cls='') => { bubble.className = 'bubble ' + cls; const f = bubble.querySelector('.face'); f.innerHTML = avatarSVG(AV, {'😊':'happy','🤔':'think','🎉':'cheer'}[face] || 'normal'); hop(f); bubble.querySelector('.t').innerHTML = html; };
  const updDots = () => { dots.innerHTML = ''; d.s.forEach((_,i) => dots.appendChild(el('span',{class: i < done ? 'done' : i === done ? 'now' : '', text: i+1}))); };
  const updGuide = () => setGuide(pad.guide, d, {faint: trace, next: finished ? -1 : done});
  const pad = makePad(padBox, st => {
    if (finished) return;
    const res = judge(st.pts, ref[done], tol);
    if (res.ok){
      pad.add(st); done++; missHere = 0; beep('ok');
      if (done === d.s.length) return complete();
      updDots(); updGuide();
      const praise = ['いいね！','じょうず！','そのちょうし！','ばっちり！','すごい！'][Math.floor(Math.random()*5)];
      say2('😊', `${praise} つぎは <b>${circ(done+1)}</b>`, 'good');
      return;
    }
    miss++; missHere++; beep('ng'); pad.flashBad(st);
    let msg;
    if (res.rev) msg = `かく <b>むきが はんたい</b> だよ。<b style="color:#ff7a2f">●</b> から かきはじめよう`;
    else if (res.partial) msg = 'とちゅうで はなさないで、<b>ひとふで</b>で かこう';
    else {
      let other = -1;
      for (let j=done+1;j<ref.length;j++){ if (judge(st.pts, ref[j], tol).ok){ other = j; break; } }
      msg = other >= 0 ? `<b>かきじゅん</b>が ちがうよ。いまは ${circ(done+1)} の せんだよ` : (trace ? 'おしい！ <b style="color:#ff7a2f">オレンジ</b>の せんを なぞってね' : 'おしい！ もういちど かいてみよう');
    }
    say2('🤔', msg, 'bad');
    if (!trace && missHere >= 2) showHint(pad.guide, d, done);
    if (trace && missHere >= 2) showHint(pad.guide, d, done);
  });
  practice = pad; let t0 = performance.now();
  updDots(); updGuide();
  say2('🐣', trace ? `うすい じを なぞってね。<b style="color:#ff7a2f">●</b> から ${circ(1)} を かこう` : `おてほんを みないで かいてみよう。${circ(1)} から！ こまったら 💡ヒント`);
  tHint.onclick = () => { if (!finished) showHint(pad.guide, d, done); };
  tRedo.onclick = () => { done = 0; miss = 0; missHere = 0; finished = false; t0 = performance.now(); pad.clear(); updDots(); updGuide(); say2('🐣', `もういちど ${circ(1)} から かこう`); };
  tSwap.onclick = () => go('practice',{k, mode: trace ? 'free' : 'trace', ctx}, true);

  function complete(){
    finished = true; updDots(); updGuide();
    const counted = countPractice(k, d.s.length, performance.now() - t0);
    dots.querySelectorAll('span').forEach(x => x.className = 'done');
    const p = P(k);
    const isNew = !(p.tr || p.fr);
    const perfect = miss === 0;
    if (trace) p.tr = (p.tr||0) + 1; else { p.fr = (p.fr||0) + 1; if (miss === 0) p.wk = 0; }
    p.ld = today();
    saveProg(); checkUnlock(); evNote(k);
    if (counted){ bump('done'); bump(trace ? 'tr' : 'fr'); if (isNew) bump('newk'); }
    if (perfect && counted){ bump('hana'); META.hana++; }
    const gain = counted ? (trace ? (perfect ? 2 : 1) : (perfect ? 4 : 2)) : 0;
    addPts(gain); progressChanged();
    say2('🎉', perfect ? 'ぜんぶ ただしく かけたね！ はなまる！' : `できた！ まちがいは ${miss}かい。もういちど やってみよう`, 'good');
    beep('win'); if (perfect) confetti();
    setTimeout(() => {
      const idx = ctx.indexOf(k);
      const nextK = idx >= 0 && idx < ctx.length-1 ? ctx[idx+1] : null;
      const box = openOv();
      const top = el('div',{class:'ov-top'}); top.appendChild(el('div',{class:'ov-av hop',html:avatarSVG(AV,'cheer','0 0 120 120',true,true)})); top.appendChild(perfect ? hanamaru() : el('div',{class:'mark',style:'color:#20b26b',text:'○'})); box.appendChild(top);
      const nmx = AV.name ? esc(AV.name) + '、' : '';
      box.appendChild(el('div',{class:'msg',html: perfect ? nmx + 'ぜんぶ ただしく かけたね！' : nmx + 'よく がんばったね！'}));
      box.appendChild(el('div',{style:'color:#f5b301;font-size:30px',html:`${starStr(k)} <span class="gain">+${gain} 🪙</span>`}));
      const btns = el('div',{class:'btns'});
      if (trace){ const b = el('button',{class:'big-btn green',html:'✍️ つぎは じぶんで かく'}); b.onclick = () => go('practice',{k, mode:'free', ctx}, true); btns.appendChild(b); }
      const again = el('button',{class:'big-btn gray',html:'🔁 もういちど'}); again.onclick = () => go('practice',{k, mode, ctx}, true); btns.appendChild(again);
      if (nextK){ const b = el('button',{class:'big-btn',html:`つぎの かんじ「${nextK}」▶`}); b.onclick = () => { stack.pop(); cur = {name:'kanji', params:{k:nextK, ctx}}; render(); }; btns.appendChild(b); }
      const bk = el('button',{class:'big-btn gray',html:'◀ かんじの ページへ'}); bk.onclick = () => back(); btns.appendChild(bk);
      box.appendChild(btns);
    }, 600);
  }
}

/* ===== テスト ===== */
function pickWord(d, maxG){
  if (d.t) return [d.t[0], d.t[1], d.t[2] || d.m];
  const ok = d.w.filter(([w]) => [...w].every(c => !KG[c] || KG[c] <= maxG));
  const pool = ok.length ? ok : d.w;
  if (pool.length) return [pool[0][0], pool[0][1], d.m];
  const kn = d.kun[0] || '', [st, ok2] = kn.split('-');
  return kn ? [d.k + (ok2 || ''), st + (ok2 || ''), d.m] : [d.k, d.on[0] || '', d.m];
}
function startTest(list, label){
  const maxG = Math.max(...list.map(x => KG[x] || 1));
  const qs = shuffle(list).slice(0, 10).map(k => { const d = BYK[k]; return {k, w: pickWord(d, Math.max(d.g, maxG))}; });
  go('test',{qs, i:0, res:[], label});
}
function normalize(strokes, ref){
  const all = strokes.flatMap(s => s.pts), rall = ref.flat();
  const bb = pts => { let x0=1e9,y0=1e9,x1=-1e9,y1=-1e9; pts.forEach(([x,y]) => { x0=Math.min(x0,x); y0=Math.min(y0,y); x1=Math.max(x1,x); y1=Math.max(y1,y); }); return {x0,y0,x1,y1,w:x1-x0,h:y1-y0,cx:(x0+x1)/2,cy:(y0+y1)/2}; };
  const u = bb(all), r = bb(rall);
  const sx = u.w > 6 && r.w > 10 ? r.w/u.w : null, sy = u.h > 6 && r.h > 10 ? r.h/u.h : null;
  let sc = sx && sy ? (sx+sy)/2 : (sx || sy || 1); sc = Math.min(2.2, Math.max(0.45, sc));
  return strokes.map(s => s.pts.map(([x,y]) => [(x-u.cx)*sc + r.cx, (y-u.cy)*sc + r.cy]));
}
function grade(strokes, d){
  const ref = refOf(d); const n = ref.length;
  if (!strokes.length) return {mark:'×', msg:'なにも かいて ないよ'};
  const tol = 22 * TOL[settings.strict];
  const U = normalize(strokes, ref);
  if (U.length !== n){
    return {mark:'×', msg: `かくすうが ちがうよ（ただしくは ${n}かく。きみは ${U.length}かく）`};
  }
  const inOrder = U.every((u,i) => judge(u, ref[i], tol).ok);
  if (inOrder) return {mark:'◎', msg:'せいかい！ かきじゅんも ばっちり'};
  const used = new Set(); let allMatch = true, revCount = 0;
  U.forEach(u => {
    let found = -1;
    for (let j=0;j<n;j++){ if (used.has(j)) continue; const r = judge(u, ref[j], tol); if (r.ok){ found = j; break; } if (r.rev){ found = j; revCount++; break; } }
    if (found < 0) allMatch = false; else used.add(found);
  });
  if (allMatch) return {mark:'○', msg: revCount ? 'せいかい！ でも かく むきに きをつけよう' : 'せいかい！ でも かきじゅんに きをつけよう'};
  return {mark:'×', msg:'かたちが ちょっと ちがうみたい。おてほんを みてみよう'};
}
function renderTest(s, params){
  const {qs, i, res, label} = params;
  if (i >= qs.length) return renderTestEnd(s, params);
  const q = qs[i]; const d = BYK[q.k];
  setTitle(`${label} かきとり テスト`);
  const wrap = el('div',{class:'pr'});
  const padBox = el('div',{class:'padbox'});
  const side = el('div',{class:'side'});
  const [word, rd, mean] = q.w;
  const shown = [...word].map(c => c === q.k ? '<span class="box"></span>' : esc(c)).join('');
  const qc = el('div',{class:'q card',html:`<div class="num">だい ${i+1} もん ／ ${qs.length}もん</div>
    <div class="word" style="background:none"><ruby>${shown}<rt>${esc(rd)}</rt></ruby></div>
    ${mean ? `<div class="qm"><b>いみ</b> ${esc(mean)}</div>` : ''}
    <div class="hint">□に はいる かんじを かこう（${d.s.length}かく）</div>`});
  const speak = el('button',{class:'tool speak2',html:'<span class="i">🔈</span>よみ'}); speak.onclick = () => say(rd);
  const tools = el('div',{class:'tools five'});
  tools.appendChild(speak);
  const tUndo = el('button',{class:'tool',html:'<span class="i">↩️</span>もどす'});
  const tClear = el('button',{class:'tool',html:'<span class="i">🧽</span>けす'});
  const tGive = el('button',{class:'tool',html:'<span class="i">🙈</span>わからない'});
  [tUndo,tClear,tGive].forEach(b => tools.appendChild(b));
  const check = el('button',{class:'tool check',html:'<span class="i">✅</span>こたえ'});
  tools.appendChild(check);
  qc.appendChild(tools); side.appendChild(qc);
  side.appendChild(penBar());
  wrap.appendChild(padBox); wrap.appendChild(side);
  s.appendChild(wrap);
  const pad = makePad(padBox, st => { pad.add(st); beep('tap'); });
  practice = pad;
  setGuide(pad.guide, d, {});
  tUndo.onclick = () => pad.undo();
  tClear.onclick = () => pad.clear();
  const finish = r => {
    res.push({k:q.k, mark:r.mark});
    const p = P(q.k);
    if (r.mark === '×'){ p.wk = 1; p.tm = (p.tm||0) + 1; beep('ng'); }
    else { p.ts = (p.ts||0) + 1; p.wk = 0; beep('ok'); if (r.mark === '◎') confetti(12); addPts(r.mark === '◎' ? 3 : 2); }
    p.ld = today();
    saveProg(); checkUnlock(); saveMeta();
    const box = openOv();
    const top = el('div',{class:'ov-top'}); top.appendChild(el('div',{class:'ov-av hop',html:avatarSVG(AV, r.mark === '×' ? 'think' : r.mark === '◎' ? 'cheer' : 'happy', '0 0 120 120', true, true)}));
    top.appendChild(r.mark === '◎' ? hanamaru({banner:false}) : el('div',{class:'mark',style:`color:${r.mark === '×' ? '#ef476f' : '#20b26b'}`,text:r.mark})); box.appendChild(top);
    box.appendChild(el('div',{class:'msg',html:esc(r.msg)}));
    box.appendChild(el('div',{style:'font-size:30px;margin-bottom:6px',html:`<ruby>${[...word].map(c => c === q.k ? `<span style="color:#ff7a2f">${c}</span>` : esc(c)).join('')}<rt style="font-size:15px">${esc(rd)}</rt></ruby>` + (mean ? `<div style="font-size:17px;line-height:1.5;margin:4px auto 6px;padding:6px 10px;border-radius:12px;background:#fff6df;color:#5a4500;max-width:440px">${esc(mean)}</div>` : '')}));
    const ksvg = kanjiSVG(d,{nums:true, width:4}); box.appendChild(ksvg); setTimeout(() => animateSVG(ksvg,{speed:1.5}), 150);
    const btns = el('div',{class:'btns'});
    const nx = el('button',{class:'big-btn',html: i+1 < qs.length ? 'つぎの もんだい ▶' : 'けっかを みる 🏁'});
    nx.onclick = () => go('test', Object.assign({}, params, {i:i+1}), true);
    btns.appendChild(nx); box.appendChild(btns);
  };
  check.onclick = () => finish(grade(pad.strokes, d));
  tGive.onclick = () => finish({mark:'×', msg:'こたえは この かんじ。いっしょに おぼえよう！'});
}
function renderTestEnd(s, {qs, res, label}){
  setTitle('テストの けっか');
  const good = res.filter(r => r.mark !== '×').length;
  const pr = cur.params;
  if (!pr.awarded){
    pr.awarded = true; META.tests++;
    if (pr.ev){ const ce = currentEvent(); if (ce && ce.id === pr.ev){ const es = evState(ce); es.best = Math.max(es.best || 0, good); } } bump('tests'); const r0 = dayRec(); r0.bestTest = Math.max(r0.bestTest || 0, good);
    if (good === res.length && res.length >= 5){ META.perfect++; addPts(20, '💯', 'ぜんもん せいかい ボーナス！'); }
    progressChanged();
  }
  const c = el('div',{class:'card',style:'text-align:center;max-width:640px;margin:0 auto'});
  c.appendChild(el('div',{class:'ov-av hop',style:'margin:0 auto 6px',html:avatarSVG(AV, good >= res.length*0.7 ? 'cheer' : 'think', '0 0 120 120', true, true)}));
  c.appendChild(el('div',{style:'font-size:22px',text:`${label} かきとり テスト`}));
  c.appendChild(el('div',{style:'font-size:64px;font-weight:bold;color:#ff7a2f;margin:6px 0',html:`${good}<small style="font-size:28px;color:#6b7085"> / ${res.length}</small>`}));
  c.appendChild(el('div',{class:'msg',style:'font-size:22px;font-weight:bold',text: good === res.length ? 'ぜんもん せいかい！ すごい！' : good >= res.length*0.7 ? 'よく できました！' : 'まちがえた かんじを れんしゅう しよう！'}));
  const rl = el('div',{class:'result-list'});
  res.forEach(r => { const b = el('span',{html:`${r.k}<b style="color:${r.mark==='×'?'#ef476f':'#20b26b'}">${r.mark}</b>`}); b.onclick = () => go('kanji',{k:r.k, ctx:res.map(x=>x.k)}); rl.appendChild(b); });
  c.appendChild(rl);
  const wrong = res.filter(r => r.mark === '×').map(r => r.k);
  const btns = el('div',{class:'row',style:'margin-top:12px'});
  if (wrong.length){ const b = el('button',{class:'big-btn',html:'🔁 まちがえた かんじを れんしゅう'}); b.onclick = () => { home(); go('kanji',{k:wrong[0], ctx:wrong}); }; btns.appendChild(b); }
  const again = el('button',{class:'big-btn blue',html:'📝 もういちど テスト'}); again.onclick = () => { if (pr.ev && currentEvent()){ back(); startEventTest(currentEvent()); return; } const list = [...new Set(qs.map(q=>q.k))]; back(); startTest(cur.params.weak ? DATA.filter(d=>(prog[d.k]||{}).wk).map(d=>d.k) : (cur.params.g ? levelOf(cur.params.g).list : list), label); };
  const hm = el('button',{class:'big-btn gray',html:'🏠 ホーム'}); hm.onclick = home;
  btns.appendChild(again); btns.appendChild(hm);
  c.appendChild(btns);
  s.appendChild(c);
  if (good === res.length) { beep('win'); confetti(); }
}

/* ===== オーバーレイ・演出 ===== */
function openOv(){ if (closeOv.hook){ const h = closeOv.hook; closeOv.hook = null; try{ h(); }catch(e){} } const ov = $('#ov'); const box = $('#ovBox'); box.innerHTML = ''; ov.classList.add('on'); return box; }
function closeOv(){ const h = closeOv.hook; closeOv.hook = null; if (h){ try{ h(); }catch(e){} } $('#ov').classList.remove('on'); }
let hmSeq = 0;
function hanamaru(opts = {}){
  const banner = opts.banner !== false;
  const W = 220, H = banner ? 236 : 204, cx = 110, cy = 100, id = 'hm' + (++hmSeq);
  const svg = sel('svg',{viewBox:`0 0 ${W} ${H}`, class:'hanamaru' + (banner ? '' : ' small')});
  const sp4 = (x, y, r, f) => `<path class="hm-tw" d="M${x},${y-r} Q${x+r*.2},${y-r*.2} ${x+r},${y} Q${x+r*.2},${y+r*.2} ${x},${y+r} Q${x-r*.2},${y+r*.2} ${x-r},${y} Q${x-r*.2},${y-r*.2} ${x},${y-r}Z" fill="${f}"/>`;
  let sp = '';
  for (let a = 0; a <= Math.PI * 2 * 2.25; a += 0.12){ const r = 4 + a * 2.15; const x = cx + Math.cos(a - Math.PI/2) * r * 1.04, y = cy + Math.sin(a - Math.PI/2) * r * .96; sp += (sp ? 'L' : 'M') + x.toFixed(1) + ',' + y.toFixed(1); }
  let s = `<defs>
    <radialGradient id="${id}g"><stop offset="0" stop-color="#fff0f6"/><stop offset=".7" stop-color="#ffe0ee" stop-opacity=".9"/><stop offset="1" stop-color="#ffd6e7" stop-opacity="0"/></radialGradient>
    <linearGradient id="${id}p" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffc9de"/><stop offset="1" stop-color="#ff6f9f"/></linearGradient>
    <linearGradient id="${id}q" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffe3ee"/><stop offset="1" stop-color="#ff96bd"/></linearGradient></defs>
    <circle cx="${cx}" cy="${cy}" r="98" fill="url(#${id}g)"/>
    <g class="hm-leaf"><path d="M${cx-24},${cy+62} Q${cx-66},${cy+74} ${cx-78},${cy+42} Q${cx-40},${cy+30} ${cx-24},${cy+62}Z" fill="#5cd08f" stroke="#fff" stroke-width="3"/><path d="M${cx-30},${cy+58} Q${cx-52},${cy+52} ${cx-68},${cy+46}" stroke="#3aa96d" stroke-width="2" fill="none"/>
      <path d="M${cx+24},${cy+62} Q${cx+66},${cy+74} ${cx+78},${cy+42} Q${cx+40},${cy+30} ${cx+24},${cy+62}Z" fill="#5cd08f" stroke="#fff" stroke-width="3"/><path d="M${cx+30},${cy+58} Q${cx+52},${cy+52} ${cx+68},${cy+46}" stroke="#3aa96d" stroke-width="2" fill="none"/></g>`;
  for (let i = 0; i < 10; i++) s += `<g transform="rotate(${i*36} ${cx} ${cy})"><ellipse class="hm-pt" cx="${cx}" cy="${cy-55}" rx="25" ry="33" fill="url(#${id}${i%2 ? 'q' : 'p'})" stroke="#fff" stroke-width="3.2"/><ellipse class="hm-pt" cx="${cx-7}" cy="${cy-70}" rx="5" ry="8" fill="#fff" opacity=".55"/></g>`;
  s += `<circle class="hm-c" cx="${cx}" cy="${cy}" r="47" fill="#fffaf3" stroke="#ffc2d6" stroke-width="4"/>
    <path class="hm-sp" d="${sp}" fill="none" stroke="#ef476f" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round"/>
    ${sp4(24, 30, 10, '#ffd23f')}${sp4(198, 38, 8, '#ffd23f')}${sp4(206, 148, 7, '#fff')}${sp4(14, 140, 8, '#ffb3d1')}${sp4(186, 186 - (banner ? 0 : 20), 5, '#ffd23f')}`;
  if (banner) s += `<g class="hm-bn"><path d="M12,198 L38,192 L38,228 L12,222 L22,210Z" fill="#e8577a"/><path d="M208,198 L182,192 L182,228 L208,222 L198,210Z" fill="#e8577a"/>
    <rect x="30" y="186" width="160" height="38" rx="10" fill="#ff6f9f" stroke="#fff" stroke-width="3"/>
    <text x="110" y="211.5" font-size="19" font-weight="bold" fill="#fff" text-anchor="middle" letter-spacing="1">よくできました</text></g>`;
  svg.innerHTML = s;
  requestAnimationFrame(() => {
    try{
      const E = 'cubic-bezier(.2,.9,.3,1.35)';
      svg.querySelectorAll('.hm-pt').forEach((p, i) => p.animate([{transform:'scale(0)', opacity:0},{transform:'scale(1.15)', opacity:1, offset:.7},{transform:'scale(1)', opacity:1}], {duration:420, delay:Math.floor(i/2)*60, easing:E, fill:'both'}));
      svg.querySelector('.hm-c').animate([{transform:'scale(0)'},{transform:'scale(1.12)', offset:.7},{transform:'scale(1)'}], {duration:420, delay:300, easing:E, fill:'both'});
      svg.querySelector('.hm-leaf').animate([{opacity:0, transform:'translateY(14px)'},{opacity:1, transform:'none'}], {duration:400, delay:450, fill:'both'});
      const p = svg.querySelector('.hm-sp'); const len = p.getTotalLength(); p.style.strokeDasharray = len + ' ' + (len + 10);
      p.animate([{strokeDashoffset:len},{strokeDashoffset:0}], {duration:750, delay:620, easing:'ease-in-out', fill:'both'});
      const bn = svg.querySelector('.hm-bn'); if (bn) bn.animate([{opacity:0, transform:'translateY(18px) scale(.9)'},{opacity:1, transform:'translateY(-3px) scale(1.04)', offset:.7},{opacity:1, transform:'none'}], {duration:450, delay:1250, easing:E, fill:'both'});
      svg.animate([{transform:'rotate(0)'},{transform:'rotate(-5deg)'},{transform:'rotate(4deg)'},{transform:'rotate(0)'}], {duration:600, delay:1500, easing:'ease-in-out'});
    }catch(e){}
  });
  return svg;
}
function confetti(n=26){
  const em = ['⭐','🌸','✨','🎉','💮','🌟'];
  for (let i=0;i<n;i++){ const c = el('div',{class:'conf',text:em[i%em.length]});
    c.style.left = Math.random()*100 + 'vw'; c.style.animationDuration = (1.6 + Math.random()*1.6) + 's'; c.style.animationDelay = Math.random()*.4 + 's';
    document.body.appendChild(c); setTimeout(() => c.remove(), 3800); }
}
let toastT = null;
function toast(msg){
  let t = $('#toast'); if (!t){ t = el('div',{id:'toast',style:'position:fixed;left:50%;bottom:calc(30px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:#2b2d42;color:#fff;padding:14px 20px;border-radius:18px;font-size:17px;z-index:70;max-width:90vw;text-align:center'}); document.body.appendChild(t); }
  t.textContent = msg; t.style.display = 'block'; clearTimeout(toastT); toastT = setTimeout(() => t.style.display = 'none', 2600);
}
$('#ov').addEventListener('click', e => { if (e.target.id === 'ov' && cur.name !== 'test') closeOv(); });

/* ===== せってい ===== */
function openSettings(){
  const box = openOv();
  box.appendChild(el('div',{class:'msg',text:'⚙️ せってい（おうちの かたへ）'}));
  const seg = (label, key, opts) => {
    const row = el('div',{class:'set-row'}); row.appendChild(el('div',{html:label}));
    const sg = el('div',{class:'seg'});
    opts.forEach(([v,t]) => { const b = el('button',{class: settings[key] === v ? 'on' : '', text:t}); b.onclick = () => { settings[key] = v; saveSet(); applyTheme(); sg.querySelectorAll('button').forEach(x => x.classList.remove('on')); b.classList.add('on'); }; sg.appendChild(b); });
    row.appendChild(sg); box.appendChild(row);
  };
  seg('はんていの きびしさ', 'strict', [['easy','やさしい'],['normal','ふつう'],['hard','きびしい']]);
  seg('かく もの<br><small class="muted">「じどう」は Apple Pencil を<br>つかうと ゆびを むしします</small>', 'penMode', [['auto','じどう'],['pen','ペンだけ'],['all','ゆびも OK']]);
  seg('おと・よみあげ', 'sound', [[true,'オン'],[false,'オフ']]);
  seg('がめんの ふんいき', 'theme', [['normal','ふつう'],['yume','ゆめかわ'],['sora','そらいろ']]);
  box.appendChild(el('div',{class:'cloud-badge muted',style:'font-size:14px;margin-top:12px;text-align:left',text:cloudLabel()}));
  const bk = el('button',{class:'big-btn blue',style:'margin-top:10px;width:100%;font-size:18px;min-height:56px',html:'💾 きろくの ほぞん・ひきつぎ'}); bk.onclick = openBackup; box.appendChild(bk);
  const ab = el('button',{class:'big-btn gray',style:'margin-top:10px;width:100%;font-size:17px;min-height:52px',html:'🔒 プライバシー・りようじょうけん'}); ab.onclick = openAbout; box.appendChild(ab);
  const reset = el('button',{class:'big-btn gray',style:'margin-top:14px;width:100%;font-size:17px;min-height:52px',html:'🗑️ れんしゅうの きろくを けす'});
  reset.onclick = () => ask('★や にがての きろくを ぜんぶ けしますか？', 'けす', () => { prog = {}; saveProg(); home(); });
  box.appendChild(reset);
  const done = el('button',{class:'big-btn',style:'margin-top:10px;width:100%',text:'とじる'}); done.onclick = () => { closeOv(); updSound(); if (cur.name !== 'practice' && cur.name !== 'test') render(); };
  box.appendChild(done);
  box.appendChild(el('div',{class:'credit',html:
    `<b>このアプリについて</b><br>
     小学校の1026字（2020年度からの学年別漢字配当表）と、常用漢字・人名用漢字・JIS第1・第2水準の漢字をあわせた約6300字に対応。級は漢字検定の10級〜1級を目安にした表示で、検定の出題範囲・筆順・採点基準と同じであることは保証しません。「漢検」「漢字検定」は公益財団法人 日本漢字能力検定協会の登録商標で、本アプリは同協会とは関係ありません。「ぶしゅ」は KanjiVG の部首情報にもとづく目安で、漢検の部首と異なる場合があります。読みは常用漢字表の音訓をすべて表示しています（級によって出題されない読みも含みます）。<br>
     書き順：<a href="https://kanjivg.tagaini.net/" target="_blank" rel="noopener">KanjiVG</a>（© Ulrich Apel ほか, CC BY-SA 3.0）／
     ことば：<a href="https://www.edrdg.org/" target="_blank" rel="noopener">JMdict</a>（© EDRDG, CC BY-SA 4.0）／
     読み：常用漢字表（cjkvi-tables）。データ部分は CC BY-SA で配布されます。<br>
     4級〜1級の常用外の読み・旧字体の対応は KANJIDIC（© EDRDG, CC BY-SA 4.0）にもとづきます。The pitch accent notation, verb particle data, phonetics, homonyms and other additions or modifications to EDICT, KANJIDIC or KRADFILE were provided by Uros O. through his free database.<br>
     4級〜1級：級の目安・常用外の読みは <a href="https://github.com/mifunetoshiro/kanjium" target="_blank" rel="noopener">kanjium</a>（CC BY-SA 4.0）、4級〜2級の配当と読みは常用漢字表。準1級・1級の級分けは目安で、日本漢字能力検定協会の公式な一覧ではありません。日本語の「いみ」は本アプリのオリジナル（CC BY-SA）。<br>
     QR コード：qrcode-generator（© Kazuhiko Arase, MIT）／jsQR（cozmo/jsQR, Apache License 2.0 — <a href="https://www.apache.org/licenses/LICENSE-2.0" target="_blank" rel="noopener">全文</a>）。ライセンスの詳細は <a href="https://github.com/kanji-renshu/kanji-renshu.github.io" target="_blank" rel="noopener">ソースコード</a> の LICENSE・LICENSE-DATA.md を見てください。QR コードは株式会社デンソーウェーブの登録商標です。<br>
     <b>データの扱い</b>：きろく・キャラ・せっていは この端末のブラウザの中だけに保存され、どこにも送信されません（ログインや広告、アクセス解析もありません）。ページを読み込むときに配信元（GitHub）へ通常の接続記録が残ります。ともだちカードは、QR を見せたり画像を送ったりした相手にだけ渡ります。カードには ニックネームを使い、本名をのせないでください。`}));
}



/* ===== れんしゅうの かぞえかた（れんだで ふやせないように） ===== */
const DAY_PER_KANJI = 3, DAY_MAX_DONE = 150;
function countPractice(k, strokes, ms){
  if (ms < Math.max(2500, strokes * 600)) return false;           // はやすぎる（さいごまで ていねいに かいていない）
  const t = today(); let dc = store.get('kkr.dc', null);
  if (!dc || dc.d !== t || typeof dc.c !== 'object' || Array.isArray(dc.c)) dc = {d:t, c:{}};
  const n = num(dc.c[k]);
  if (n >= DAY_PER_KANJI || num((META.days[t] || {}).done) >= DAY_MAX_DONE) return false;
  dc.c[k] = n + 1; if (Object.keys(dc.c).length > 400) return false;
  store.set('kkr.dc', dc); return true;
}

/* ===== ともだちカード（サーバーなし：QR を みせあう） ===== */
const FR_MAX = 30, CARD_PREFIX = 'KKC1.';
const weekKey = (d = new Date()) => { const x = new Date(d.getFullYear(), d.getMonth(), d.getDate()); x.setDate(x.getDate() - ((x.getDay() + 6) % 7)); return today(x); };
const weekLabel = wk => { const [y, m, d] = wk.split('-').map(Number); return `${m}/${d}〜`; };
function myCardId(){
  let id = store.get('kkr.cid', '');
  if (typeof id !== 'string' || !/^[a-z0-9]{10}$/.test(id)){
    const r = crypto.getRandomValues(new Uint8Array(10)); id = Array.from(r, b => 'abcdefghijklmnopqrstuvwxyz0123456789'[b % 36]).join('');
    store.set('kkr.cid', id);
  }
  return id;
}
function weekStats(){
  const wk = weekKey(), base = new Date(wk + 'T00:00:00'); let done = 0, days = 0;
  for (let i = 0; i < 7; i++){ const x = new Date(base); x.setDate(base.getDate() + i); const r = META.days[today(x)]; if (r){ done += Math.min(DAY_MAX_DONE, num(r.done)); if (num(r.done) + num(r.tests) > 0) days++; } }
  return {wk, done, days};
}
function myCard(){
  const ws = weekStats(), av = {};
  Object.keys(AV_DEFAULT).forEach(k => { if (k !== 'name' && AV[k] !== AV_DEFAULT[k]) av[k] = AV[k]; });
  return {a:'kkc', v:2, id:myCardId(), n:AV.name || '', av, w:ws.wk, d:ws.done, y:ws.days, s:totalStars(), m:masterCount()};
}
/* カードの しょめい：たんまつごとの かぎ（ECDSA P-256）。バックアップに ふくめるので、きしゅへんこうでも おなじ ひとと して あつかわれる */
const u8b64 = by => { let s = ''; for (let i = 0; i < by.length; i += 8192) s += String.fromCharCode.apply(null, by.subarray(i, i + 8192)); return btoa(s); };
const b64u8 = s => Uint8Array.from(atob(s), c => c.charCodeAt(0));
const ECP = {name:'ECDSA', namedCurve:'P-256'}, ECS = {name:'ECDSA', hash:'SHA-256'};
const validJwk = j => j && typeof j === 'object' && j.kty === 'EC' && j.crv === 'P-256' && ['x','y','d'].every(f => typeof j[f] === 'string' && /^[A-Za-z0-9_-]{40,50}$/.test(j[f]));
let cardKeyP = null;
function cardKey(){
  if (!cardKeyP) cardKeyP = (async () => {
    let jwk = store.get('kkr.ckey', null);
    if (!validJwk(jwk)){ const kp = await crypto.subtle.generateKey(ECP, true, ['sign', 'verify']); jwk = await crypto.subtle.exportKey('jwk', kp.privateKey); store.set('kkr.ckey', {kty:jwk.kty, crv:jwk.crv, x:jwk.x, y:jwk.y, d:jwk.d}); jwk = store.get('kkr.ckey'); }
    const priv = await crypto.subtle.importKey('jwk', Object.assign({}, jwk, {ext:true, key_ops:['sign']}), ECP, false, ['sign']);
    const pub = await crypto.subtle.importKey('jwk', {kty:'EC', crv:'P-256', x:jwk.x, y:jwk.y, ext:true}, ECP, true, ['verify']);
    return {priv, pk: u8b64(new Uint8Array(await crypto.subtle.exportKey('raw', pub)))};
  })().catch(e => { cardKeyP = null; throw e; });
  return cardKeyP;
}
const cardBody = c => JSON.stringify({a:c.a, v:c.v, id:c.id, n:c.n, av:c.av, w:c.w, d:c.d, y:c.y, s:c.s, m:c.m, pk:c.pk});
async function signCard(c){
  const k = await cardKey(); c.pk = k.pk;
  c.sg = u8b64(new Uint8Array(await crypto.subtle.sign(ECS, k.priv, new TextEncoder().encode(cardBody(c)))));
  return c;
}
async function verifyCard(raw){
  if (raw.v !== 2 || typeof raw.pk !== 'string' || typeof raw.sg !== 'string' || !/^[A-Za-z0-9+/]{86}==$/.test(raw.sg) || !/^B[A-P][A-Za-z0-9+/]{85}=$/.test(raw.pk)) return false;
  try{
    const pub = await crypto.subtle.importKey('raw', b64u8(raw.pk), ECP, false, ['verify']);
    return await crypto.subtle.verify(ECS, pub, b64u8(raw.sg), new TextEncoder().encode(cardBody(raw)));
  }catch(e){ return false; }
}
/* カードの かずが ありえるか（あやしい ときは「？」） */
function cardDoubt(c, prev){
  const why = [];
  if (!c.ok) why.push('しょめいが ない');
  const elapsed = c.w === weekKey() ? Math.floor((new Date(today() + 'T00:00:00') - new Date(c.w + 'T00:00:00')) / 864e5) + 1 : 7;
  if (c.y > elapsed) why.push('ひにちが おおすぎる');
  if (c.d > c.y * DAY_MAX_DONE || (c.d > 0 && c.y === 0)) why.push('かいすうが おおすぎる');
  if (c.m * 3 > c.s) why.push('★と マスターが あわない');
  if (prev && prev.id === c.id){
    if (prev.w === c.w && (c.d < prev.d || c.y < prev.y)) why.push('まえの カードより へっている');
    if (prev.w > c.w) why.push('まえの カードより ふるい');
  }
  return why;
}
async function encodeCard(c){
  c = await signCard(c);
  const json = JSON.stringify(c);
  const buf = await new Response(new Blob([json]).stream().pipeThrough(new CompressionStream('deflate-raw'))).arrayBuffer();
  let bin = ''; new Uint8Array(buf).forEach(b => bin += String.fromCharCode(b));
  return CARD_PREFIX + btoa(bin);
}
/* うけとった カードは しんらい しない：かたと はんいを ぜんぶ たしかめる */
function sanitizeCard(c){
  if (!c || typeof c !== 'object' || Array.isArray(c) || c.a !== 'kkc' || (c.v !== 1 && c.v !== 2)) throw new Error('card');
  const id = typeof c.id === 'string' ? c.id : ''; if (!/^[a-z0-9]{10}$/.test(id)) throw new Error('id');
  const w = typeof c.w === 'string' ? c.w : ''; if (!DATE_RE.test(w) || isNaN(Date.parse(w + 'T00:00:00'))) throw new Error('week');
  const nextWeek = new Date(weekKey() + 'T00:00:00'); nextWeek.setDate(nextWeek.getDate() + 7);
  if (new Date(w + 'T00:00:00') > nextWeek || new Date(w + 'T00:00:00').getDay() !== 1) throw new Error('week');
  const n = (v, max) => Math.max(0, Math.min(max, Math.floor(Number(v)) || 0));
  const rawAv = c.av && typeof c.av === 'object' && !Array.isArray(c.av) ? c.av : {};
  const av = Object.assign({}, AV_DEFAULT, sanitizeAV(Object.assign({}, rawAv, {name: typeof c.n === 'string' ? c.n : ''})));
  const pk = typeof c.pk === 'string' && /^B[A-P][A-Za-z0-9+/]{85}=$/.test(c.pk) ? c.pk : '';
  return {id, nm:av.name, av, w, d:n(c.d, 9999), y:n(c.y, 7), s:n(c.s, ALLK.length * 3), m:n(c.m, ALLK.length), pk, ok:!!(c.ok && pk)};
}
async function decodeCard(text){
  text = String(text || '').trim();
  if (!text.startsWith(CARD_PREFIX) || text.length > 3000 || !/^[A-Za-z0-9+/=]+$/.test(text.slice(CARD_PREFIX.length))) throw new Error('notcard');
  const raw = JSON.parse(await inflate(text.slice(CARD_PREFIX.length), 8000));
  if (raw && typeof raw === 'object') raw.ok = await verifyCard(raw);
  return sanitizeCard(raw);
}
function loadFriends(){
  const raw = store.get('kkr.friends', []); const out = [];
  if (Array.isArray(raw)) raw.slice(0, FR_MAX).forEach(x => { try{ if (x && typeof x === 'object'){ const c = sanitizeCard(x.c); c.doubt = !c.ok || !!(x.c && x.c.dq) || cardDoubt(c, null).length > 0; out.push({c, got:num(x.got)}); } }catch(e){} });
  return out;
}
let FRIENDS = loadFriends();
const friendsStore = () => FRIENDS.map(f => ({c:{a:'kkc', v:2, n:f.c.nm, av:f.c.av, id:f.c.id, w:f.c.w, d:f.c.d, y:f.c.y, s:f.c.s, m:f.c.m, pk:f.c.pk, ok:f.c.ok, dq:!!f.c.doubt}, got:f.got}));
const saveFriends = () => store.set('kkr.friends', friendsStore());
function qrSVG(text, px){
  const q = QRGEN(0, 'M'); q.addData(text, 'Byte'); q.make();
  const n = q.getModuleCount(), m = 4, size = n + m * 2; let d = '';
  for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) if (q.isDark(r, c)) d += `M${c + m},${r + m}h1v1h-1z`;
  return `<svg class="qr" viewBox="0 0 ${size} ${size}" width="${px}" height="${px}" shape-rendering="crispEdges" role="img" aria-label="ともだちカードの QR コード"><rect width="${size}" height="${size}" fill="#fff"/><path d="${d}" fill="#1f2235"/></svg>`;
}
function decodeImageData(img, inv = 'attemptBoth'){
  const r = QRSCAN(img.data, img.width, img.height, {inversionAttempts:inv});
  return r ? r.data : null;
}
function addCard(c){
  if (c.id === myCardId()){ toast('これは じぶんの カードだよ'); return; }
  const i = FRIENDS.findIndex(f => f.c.id === c.id);
  if (i < 0 && FRIENDS.length >= FR_MAX){ toast(`ともだちは ${FR_MAX}にん まで。だれかを けしてから よんでね`); return; }
  const prev = i >= 0 ? FRIENDS[i].c : null;
  const keyChanged = prev && prev.pk && c.pk !== prev.pk;
  const doubt = cardDoubt(c, prev);
  const box = openOv();
  box.appendChild(el('div',{class:'msg',text: keyChanged ? '⚠️ カードの かぎが かわったよ' : i < 0 ? 'ともだちを ついかする？' : 'カードを あたらしく する？'}));
  if (keyChanged) box.appendChild(el('p',{class:'bk-note',text:`まえに よんだ「${prev.nm || 'なまえなし'}」の カードと、べつの たんまつで つくられた カードです。おなじ ともだちが きしゅへんこう した ときだけ「あたらしくする」を おしてね。`}));
  else if (doubt.length) box.appendChild(el('p',{class:'bk-note',text:'❓ この カードは すこし へんな ところが あります（' + doubt.join('・') + '）。ランキングでは「？」が つきます。'}));
  box.appendChild(el('div',{class:'fr-conf',html:`<div class="fr-cav">${avatarSVG(c.av, 'happy')}</div><div><b>${esc(c.nm || 'なまえなし')}</b><br>✏️ ${c.d}かい・📅 ${c.y}にち（${weekLabel(c.w)}）<br>★ ${c.s}</div>`}));
  const btns = el('div',{class:'btns'});
  const n = el('button',{class:'big-btn gray',text:'やめる'}); n.onclick = closeOv;
  const y = el('button',{class:'big-btn',text:i < 0 ? 'ついかする' : 'あたらしくする'});
  y.onclick = () => { c.doubt = doubt.length > 0; const f = {c, got:Date.now()}; if (i < 0) FRIENDS.push(f); else FRIENDS[i] = f; saveFriends(); closeOv(); beep('win'); toast(`${c.nm || 'ともだち'}の カードを よみこんだよ`); if (cur.name === 'friends') render(); };
  btns.appendChild(n); btns.appendChild(y); box.appendChild(btns);
}
async function handleScanned(text){
  try{ addCard(await decodeCard(text)); return true; }
  catch(e){ toast(e && e.message === 'notcard' ? 'これは ともだちカードの QR じゃないみたい' : 'カードを よめませんでした'); return false; }
}
function readPhoto(){
  const inp = el('input',{type:'file', accept:'image/*', style:'display:none'}); document.body.appendChild(inp);
  inp.onchange = async () => {
    const f = inp.files && inp.files[0]; inp.remove(); if (!f) return;
    if (f.size > 25e6){ toast('しゃしんが おおきすぎるよ'); return; }
    let url = '';
    try{
      url = URL.createObjectURL(f);
      const im = new Image(); im.decoding = 'async'; im.src = url; await im.decode();
      let found = null;
      for (const maxSide of [1400, 900, 2200]){
        const k = Math.min(1, maxSide / Math.max(im.naturalWidth, im.naturalHeight));
        const cv = el('canvas',{width:Math.max(1, Math.round(im.naturalWidth * k)), height:Math.max(1, Math.round(im.naturalHeight * k))});
        const cx = cv.getContext('2d', {willReadFrequently:true}); cx.drawImage(im, 0, 0, cv.width, cv.height);
        found = decodeImageData(cx.getImageData(0, 0, cv.width, cv.height)); if (found) break;
      }
      if (found) await handleScanned(found); else toast('しゃしんの なかに QR が みつからなかったよ');
    }catch(e){ toast('しゃしんを よめませんでした'); }
    finally{ if (url) URL.revokeObjectURL(url); }
  };
  inp.click();
}
async function openScan(){
  const box = openOv();
  box.appendChild(el('div',{class:'msg',text:'📷 ともだちの QR を うつしてね'}));
  const vw = el('div',{class:'scan-v'}); const video = el('video',{playsinline:'', muted:'', autoplay:''}); vw.appendChild(video); vw.appendChild(el('div',{class:'scan-frame'}));
  const st = el('p',{class:'bk-note',text:'カメラを じゅんびしています…'});
  box.appendChild(vw); box.appendChild(st);
  const btns = el('div',{class:'btns'});
  const ph = el('button',{class:'big-btn blue',text:'🖼 しゃしんから よむ'}); ph.onclick = () => { closeOv(); readPhoto(); };
  const c = el('button',{class:'big-btn gray',text:'とじる'}); c.onclick = closeOv;
  btns.appendChild(c); btns.appendChild(ph); box.appendChild(btns);
  let stream = null, alive = true, timer = 0;
  closeOv.hook = () => { alive = false; clearTimeout(timer); if (stream) stream.getTracks().forEach(tr => tr.stop()); video.srcObject = null; };
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){ st.textContent = 'この ひらきかたでは カメラが つかえません。「しゃしんから よむ」を つかってね'; return; }
  try{ stream = await navigator.mediaDevices.getUserMedia({video:{facingMode:'environment', width:{ideal:1280}, height:{ideal:720}}, audio:false}); }
  catch(e){ st.textContent = 'カメラが つかえませんでした。「しゃしんから よむ」を つかってね'; return; }
  if (!alive){ stream.getTracks().forEach(tr => tr.stop()); return; }
  video.muted = true; video.setAttribute('playsinline', ''); video.srcObject = stream;
  try{ await video.play(); }catch(e){}
  st.textContent = 'QR を わくの なかに いれてね';
  const cv = el('canvas'); const cx = cv.getContext('2d', {willReadFrequently:true});
  const tick = async () => {
    if (!alive) return;
    if (video.readyState >= 2 && video.videoWidth){
      const k = Math.min(1, 720 / Math.max(video.videoWidth, video.videoHeight));
      cv.width = Math.round(video.videoWidth * k); cv.height = Math.round(video.videoHeight * k);
      cx.drawImage(video, 0, 0, cv.width, cv.height);
      const txt = decodeImageData(cx.getImageData(0, 0, cv.width, cv.height), 'dontInvert');
      if (txt && alive){
        if (txt.startsWith(CARD_PREFIX)){ closeOv(); await handleScanned(txt); return; }
        st.textContent = 'これは ともだちカードの QR じゃないみたい';
      }
    }
    timer = setTimeout(tick, 220);
  };
  tick();
}
async function cardImage(code){
  const W = 720, H = 1000, cv = el('canvas',{width:W, height:H}), cx = cv.getContext('2d');
  cx.fillStyle = '#fff6e5'; cx.fillRect(0, 0, W, H);
  cx.fillStyle = '#fff'; cx.beginPath(); cx.roundRect ? cx.roundRect(30, 30, W - 60, H - 60, 36) : cx.rect(30, 30, W - 60, H - 60); cx.fill();
  cx.fillStyle = '#ff7a2f'; cx.font = 'bold 34px sans-serif'; cx.textAlign = 'center'; cx.fillText('かんじ れんしゅう ともだちカード', W / 2, 96);
  try{
    const url = URL.createObjectURL(new Blob([avatarSVG(AV, 'happy').replace('<svg ', '<svg xmlns="http://www.w3.org/2000/svg" width="240" height="240" ')], {type:'image/svg+xml'}));
    const im = new Image(); im.src = url; await im.decode(); cx.drawImage(im, 60, 130, 200, 200); URL.revokeObjectURL(url);
  }catch(e){}
  const ws = weekStats(); cx.textAlign = 'left'; cx.fillStyle = '#2b2d42';
  cx.font = 'bold 44px sans-serif'; cx.fillText(AV.name || 'なまえなし', 290, 200);
  cx.font = '30px sans-serif'; cx.fillText(`✏️ ${ws.done}かい  📅 ${ws.days}にち`, 290, 256); cx.fillText(`★ ${totalStars()}（${weekLabel(ws.wk)}）`, 290, 304);
  const q = QRGEN(0, 'M'); q.addData(code, 'Byte'); q.make(); const n = q.getModuleCount(), size = 560, u = Math.floor(size / (n + 8)), x0 = Math.round((W - u * n) / 2), y0 = Math.round(370 + (size - u * n) / 2);
  cx.fillStyle = '#fff'; cx.fillRect(x0 - 4 * u, y0 - 4 * u, u * (n + 8), u * (n + 8)); cx.fillStyle = '#1f2235';
  for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) if (q.isDark(r, c)) cx.fillRect(x0 + c * u, y0 + r * u, u, u);
  cx.fillStyle = '#7a7a88'; cx.font = '24px sans-serif'; cx.textAlign = 'center'; cx.fillText('「🤝 ともだち」→「しゃしんから よむ」で よめるよ', W / 2, H - 56, W - 100);
  return new Promise((ok, ng) => cv.toBlob(b => b ? ok(b) : ng(new Error('blob')), 'image/png'));
}
async function saveCardImage(code){
  let blob; try{ blob = await cardImage(code); }catch(e){ toast('がぞうを つくれませんでした'); return; }
  const file = new File([blob], 'tomodachi-card.png', {type:'image/png'});
  try{ if (navigator.canShare && navigator.canShare({files:[file]})){ await navigator.share({files:[file], title:'ともだちカード'}); return; } }catch(e){ if (e && e.name === 'AbortError') return; }
  try{ const url = URL.createObjectURL(blob); const a = el('a',{href:url, download:'tomodachi-card.png'}); document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(url), 4000); toast('がぞうを ほぞんしたよ'); }
  catch(e){ toast('がぞうを ほぞん できませんでした'); }
}
function renderFriends(s){
  setTitle('ともだち');
  const wrap = el('div',{class:'fr'});
  const left = el('div',{class:'card fr-me'}), right = el('div',{class:'card fr-rank'});
  const ws = weekStats();
  left.innerHTML = `<h3>🪪 じぶんの カード</h3>
    <div class="fr-head"><div class="fr-av">${avatarSVG(AV, 'happy')}</div><div><b class="fr-nm">${esc(AV.name || 'なまえなし')}</b><div class="fr-st">✏️ ${ws.done}かい・📅 ${ws.days}にち<br>★ ${totalStars()}</div></div></div>
    <div class="fr-qr"><span class="muted">QR を つくっています…</span></div>
    <p class="fr-note">${AV.name ? 'なまえは ニックネームに してね（ほんとうの なまえは のせない）' : 'キャラ・ショップで ニックネームを つけられるよ'}</p>`;
  const bb = el('div',{class:'fr-btns'});
  const bCam = el('button',{class:'big-btn',text:'📷 カードを よむ'}); bCam.onclick = () => { beep('tap'); openScan(); };
  const bPh = el('button',{class:'big-btn blue',text:'🖼 しゃしんから よむ'}); bPh.onclick = () => { beep('tap'); readPhoto(); };
  const bSv = el('button',{class:'big-btn gray',text:'💾 カードを がぞうで ほぞん'});
  bb.appendChild(bCam); bb.appendChild(bPh); bb.appendChild(bSv); left.appendChild(bb);
  encodeCard(myCard()).then(code => { const q = left.querySelector('.fr-qr'); if (q) q.innerHTML = qrSVG(code, 240); bSv.onclick = () => { beep('tap'); saveCardImage(code); }; requestAnimationFrame(layout); }).catch(() => { const q = left.querySelector('.fr-qr'); if (q) q.textContent = 'QR を つくれませんでした'; });
  right.appendChild(el('h3',{html:`🏆 こんしゅうの ランキング <small>${weekLabel(ws.wk)}</small>`}));
  const me = {c:{id:myCardId(), nm:AV.name || '', av:AV, w:ws.wk, d:ws.done, y:ws.days, s:totalStars()}, me:true};
  const now = [me].concat(FRIENDS.filter(f => f.c.w === ws.wk && !f.c.doubt)).sort((a, b) => b.c.d - a.c.d || b.c.y - a.c.y || (a.me ? -1 : b.me ? 1 : 0));
  const doubtful = FRIENDS.filter(f => f.c.w === ws.wk && f.c.doubt);
  const old = FRIENDS.filter(f => f.c.w !== ws.wk).sort((a, b) => b.c.w.localeCompare(a.c.w) || b.c.d - a.c.d);
  const list = el('div',{class:'fr-list'});
  const row = (f, rank) => {
    const r = el('div',{class:'fr-row' + (f.me ? ' me' : '') + (rank ? '' : ' old')});
    r.innerHTML = `<span class="fr-rk">${rank ? (rank <= 3 ? ['🥇','🥈','🥉'][rank - 1] : rank) : f.c.doubt ? '❓' : '・'}</span><span class="fr-sav">${avatarSVG(f.c.av, 'happy')}</span>
      <span class="fr-who"><b>${f.me ? (f.c.nm ? esc(f.c.nm) + '（じぶん）' : 'じぶん') : esc(f.c.nm || 'なまえなし')}</b><small>${rank ? '' : weekLabel(f.c.w) + 'の しゅう・'}★ ${f.c.s}</small></span>
      <span class="fr-val"><b>✏️ ${f.c.d}</b><small>📅 ${f.c.y}にち</small></span>`;
    if (!f.me){ const x = el('button',{class:'fr-del', 'aria-label':'けす', text:'✕'}); x.onclick = () => ask(`${f.c.nm || 'この ともだち'}を ランキングから けしますか？`, 'けす', () => { FRIENDS = FRIENDS.filter(g => g.c.id !== f.c.id); saveFriends(); render(); }); r.appendChild(x); }
    return r;
  };
  let rank = 0, prev = null;
  now.forEach((f, i) => { if (!prev || prev.c.d !== f.c.d || prev.c.y !== f.c.y) rank = i + 1; prev = f; list.appendChild(row(f, rank)); });
  if (now.length === 1) list.appendChild(el('div',{class:'fr-empty',html:'ともだちと カードを みせあって、ランキングを つくろう！<br>① ともだちに じぶんの QR を みせる<br>② ともだちの QR を「📷 カードを よむ」で うつす'}));
  if (doubtful.length){ list.appendChild(el('div',{class:'fr-sub',text:'❓ たしかめが ひつような カード（ランキングに いれていません）'})); doubtful.forEach(f => list.appendChild(row(f, 0))); }
  if (old.length){ list.appendChild(el('div',{class:'fr-sub',text:'まえの しゅうの カード（あたらしい カードを もらうと こんしゅうに はいるよ）'})); old.forEach(f => list.appendChild(row(f, 0))); }
  right.appendChild(list);
  right.appendChild(el('p',{class:'fr-note',text:`✏️ は こんしゅう（げつようび〜）れんしゅうした かず、📅 は れんしゅうした ひの かずです。ともだちは ${FR_MAX}にん まで。`}));
  wrap.appendChild(left); wrap.appendChild(right); s.appendChild(wrap);
  s._layout = (W, H, phone) => { list.style.maxHeight = phone ? '' : Math.max(200, H - 150) + 'px'; };
}

/* ===== レイアウト（スクロールなしで収める） ===== */
// iPhone: 縦は幅 700 未満、横は高さ 520 未満でスマホ表示（縦スクロール）にする
function isPhone(){ return window.innerWidth < 700 || window.innerHeight < 520; }
function layout(){
  const main = document.querySelector('main'); const s = document.querySelector('.screen.on'); if (!s) return;
  const phone = isPhone();
  main.classList.toggle('scroll', phone);
  s.style.transform = ''; s.style.width = ''; delete s.dataset.k;
  const cs = getComputedStyle(main);
  const W = main.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
  const H = main.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
  if (s._layout) s._layout(W, H, phone);
  if (practice && practice.fit) practice.fit(W, H, phone);
  const ae = document.activeElement;
  if (!phone && !(ae && /INPUT|TEXTAREA/.test(ae.tagName))) scaleToFit(s, H);
  fitOv();
}
function scaleToFit(s, H){
  if (s.scrollHeight <= H + 1) return;
  let k = H / s.scrollHeight;
  for (let i=0;i<6;i++){
    s.style.width = (100 / k) + '%'; s.style.transform = `scale(${k})`;
    const need = s.scrollHeight, nk = Math.min(1, H / need);
    if (need * k <= H + 1 && nk - k < 0.015) break;
    k = need * k > H + 1 ? nk : k + (nk - k) / 2;
  }
  s.style.width = (100 / k) + '%'; s.style.transform = `scale(${k})`;
  if (s.scrollHeight * k > H + 1){ k = H / s.scrollHeight; s.style.transform = `scale(${k})`; }
  s.dataset.k = k.toFixed(3);
}
function fitOv(){
  const ov = document.getElementById('ov'), box = document.getElementById('ovBox');
  box.style.transform = '';
  if (!ov.classList.contains('on')) return;
  const maxH = window.innerHeight * 0.94 - 16, h = box.offsetHeight;
  if (h > maxH) box.style.transform = `scale(${Math.max(0.5, maxH / h)})`;
}
let layoutRaf = 0;
const relayout = () => { cancelAnimationFrame(layoutRaf); layoutRaf = requestAnimationFrame(layout); };
window.addEventListener('resize', relayout);
window.addEventListener('orientationchange', () => setTimeout(relayout, 250));
new MutationObserver(relayout).observe(document.getElementById('ovBox'), {childList:true});
if (document.fonts && document.fonts.ready) document.fonts.ready.then(relayout);

/* ===== こうしんチェック ===== */
const update = {state:'', remote:null, last:0};
const verNum = v => String(v).split('.').map(n => parseInt(n,10) || 0);
const newer = (a, b) => { const x = verNum(a), y = verNum(b); for (let i=0;i<3;i++){ if ((x[i]||0) !== (y[i]||0)) return (x[i]||0) > (y[i]||0); } return false; };
async function checkUpdate(manual){
  if (!/^https?:$/.test(location.protocol) || /claude\.ai|claudeusercontent/.test(location.hostname)){ update.state = 'off'; return; }
  try{
    const r = await fetch('version.json?t=' + Date.now(), {cache:'no-store'});
    if (!r.ok) throw new Error('http');
    const j = await r.json(); update.last = Date.now();
    if (j && j.version && newer(j.version, APP_VERSION)){ update.state = 'new'; update.remote = j; }
    else update.state = 'latest';
  }catch(e){ update.state = 'error'; }
  updVerBadge();
}
function updVerBadge(){
  const b = document.getElementById('verBtn');
  if (update.state === 'new'){ b.classList.add('new'); b.textContent = `🆕 あたらしい はん（v${update.remote.version}）`; }
  else { b.classList.remove('new'); b.textContent = `v${APP_VERSION}・${APP_BUILD}`; }
}
function applyUpdate(){
  const v = update.remote ? update.remote.version : Date.now();
  location.replace(location.pathname + '?v=' + encodeURIComponent(v) + '-' + Date.now());
}
document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible'){ if (Date.now() - update.last > 60000) checkUpdate(false); if (META.last !== today()) checkLogin(); } });
setInterval(() => { if (document.visibilityState === 'visible') checkUpdate(false); }, 30 * 60000);

/* ===== プライバシー・りようじょうけん ===== */
function openAbout(){
  const box = openOv();
  box.appendChild(el('div',{class:'msg',text:'🔒 プライバシー・利用条件'}));
  box.appendChild(el('div',{class:'about',html:`
    <h4>データの あつかい</h4>
    <p>学習記録・キャラ・ニックネーム・設定は、この端末のブラウザの中（localStorage）だけに保存します。サーバーへの送信はしません。広告や解析ツール（アクセス解析）も使っていません。</p>
    <p>通信するのは、アプリ本体の読み込み、4級〜1級の漢字データの読み込み、新しい版があるかの確認（同じサイトの version.json を読むだけ）です。このサイトは GitHub Pages で配信しているため、アクセスの際に GitHub がIPアドレスなどの記録を取ることがあります（GitHub のプライバシー方針によります）。</p>
    <p>読み上げ機能は端末やブラウザの音声合成を使います。読み上げるのは漢字の読み・ことばだけで、ニックネームは読み上げません。</p>
    <p>「ともだちカード」の QR や画像には、ニックネーム・キャラ・その週の練習回数などが入ります。見せた相手・送った相手にだけ渡り、アプリがどこかへ送ることはありません。ニックネームには本名を使わないでください。カードを読むときのカメラの映像は、その場で QR を読むためだけに使い、保存も送信もしません。</p>
    <p>「バックアップ」で作るファイルやコードには、ニックネーム・記録・ともだちカードの署名用の鍵が入ります（機種変更しても同じ人としてカードを使えるようにするためです）。人に送ったりインターネットに載せたりしないでください。記録を消すときは、設定の「れんしゅうの きろくを けす」か、ブラウザのサイトデータ削除を使ってください。</p>
    <h4>利用条件</h4>
    <p>本アプリは無料・無保証で提供します。内容（読み・書き順・意味など）は正確さに努めていますが、誤りを含む可能性があります。学校の教科書や公式の資料もあわせて確認してください。</p>
    <p>本アプリは非公式の学習アプリです。級の表示は漢字検定の10級〜1級を目安にしたもので、検定の出題範囲・筆順・採点基準と同じであることは保証しません。準1級・1級の字の分け方は公開データにもとづく目安です。「漢検」「漢字検定」は公益財団法人 日本漢字能力検定協会の登録商標であり、本アプリは同協会とは関係ありません。</p>
    <h4>ライセンス</h4>
    <p>プログラム部分は MIT ライセンス、データ部分は CC BY-SA の条件で配布しています。書き順：KanjiVG（© Ulrich Apel ほか, CC BY-SA 3.0）／熟語：JMdict（© EDRDG, CC BY-SA 4.0）／常用外の読み・旧字体：KANJIDIC（© EDRDG, CC BY-SA 4.0）・kanjium（CC BY-SA 4.0）／読み：常用漢字表（cjkvi-tables）／QR コード：qrcode-generator（MIT）・jsQR（Apache License 2.0）。日本語の「いみ」は本アプリのオリジナルです（CC BY-SA 4.0）。詳しくは配布元リポジトリの LICENSE・LICENSE-DATA.md をご覧ください。</p>`}));
  const c = el('button',{class:'big-btn gray',style:'margin-top:12px;width:100%',text:'とじる'}); c.onclick = closeOv; box.appendChild(c);
}
/* ほかの サイトに うめこまれたとき */
function framedGuard(){
  let framed = false; try{ framed = window.top !== window.self; }catch(e){ framed = true; }
  if (!framed || /claude\.ai|claudeusercontent/.test(location.hostname)) return false;
  document.body.innerHTML = '';
  const d = el('div',{class:'framed'});
  d.appendChild(el('p',{text:'このページは ほかの サイトの なかに うめこまれて います。ただしい ページを ひらいてね。'}));
  const a = el('a',{href:location.href, target:'_blank', rel:'noopener', class:'big-btn', text:'ただしい ページを ひらく'});
  d.appendChild(a); document.body.appendChild(d);
  return true;
}

/* ホームがめんから はじめて ひらいたとき（Safari とは きろくが べつ） */
function homeScreenHint(){
  if (!navigator.standalone || Object.keys(prog).length || store.get('kkr.hintHome', 0)) return false;
  store.set('kkr.hintHome', 1);
  const box = openOv();
  box.appendChild(el('div',{class:'msg',text:'📱 ホームがめんから ひらいたよ'}));
  box.appendChild(el('p',{class:'bk-note',text:'ホームがめんの アイコンと Safari では、きろくの ばしょが べつべつです。Safari で つかっていた きろくが ある ときは、Safari の ほうで「💾 バックアップ」→「ひきつぎコードを コピー」して、ここで「💾 バックアップ」→「コードから もどす」に はりつけてね。'}));
  const c = el('button',{class:'big-btn',style:'width:100%;margin-top:12px',text:'わかった'}); c.onclick = () => { closeOv(); checkLogin(); };
  box.appendChild(c);
  return true;
}

/* ===== 起動 ===== */
document.addEventListener('gesturestart', e => e.preventDefault());
document.addEventListener('dblclick', e => e.preventDefault());
if ('speechSynthesis' in window) { try{ speechSynthesis.getVoices(); speechSynthesis.onvoiceschanged = () => {}; }catch(e){} }
if (framedGuard()) throw new Error('framed');
/* ほぞんデータは しんらい しない：きどうの たびに かたを たしかめる */
(function sanitizeLoaded(){
  try{ prog = mergeProg({}, prog && typeof prog === 'object' && !Array.isArray(prog) ? prog : {}, true); }catch(e){ prog = {}; }
  try{ settings = sanitizeSettings(settings); }catch(e){ settings = sanitizeSettings({}); }
  try{ AV = Object.assign({}, AV_DEFAULT, sanitizeAV(AV)); }catch(e){ AV = Object.assign({}, AV_DEFAULT); hasAV = false; }
  try{ META = Object.assign({}, META_DEFAULT, sanitizeMeta(META)); }catch(e){ META = Object.assign({}, META_DEFAULT, sanitizeMeta({})); }
})();
function applyTheme(){ document.body.dataset.theme = settings.theme || 'normal'; }
applyTheme();
updSound();
lastTotal = totalStars();
home();
initCloud();
checkUpdate(false);
if (/^#import=/.test(location.hash)){ try{ history.replaceState(null, '', location.pathname + location.search); }catch(e){} }
if (!homeScreenHint()) checkLogin();
setTimeout(progressChanged, 1500);
</script>
</body>
</html>
