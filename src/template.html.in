const EYE_COLORS = ['#2b2d42','#7a4a2a','#3a7bff','#20a86b','#8a4bdc','#ff5d9e','#e0a100'];
const CHEEKS = [['normal','ぽっ'],['heart','ハート'],['tere','てれ'],['none','なし']];
const EYES = [['shoujo','しょうじょまんが'],['kira','うるうる'],['heart','ハート'],['star','ほし'],['lash','まつげ'],['round','くりくり'],['dot','てん'],['sparkle','キラキラ'],['cool','キリッ'],['smile','にっこり'],['sleepy','ねむそう'],['wink','ウインク']];
const MOUTHS = [['tiny','ちょこん'],['smile','にこっ'],['open','わーい'],['grin','にかっ'],['cat','ねこ'],['small','おちょぼ'],['flat','まじめ'],['fang','キバ']];
const CLOTHES = ['#3a9bff','#ff6b6b','#3cc47c','#f2b705','#9b7bff','#ff9f43','#ff7eb6','#2b2d42','#ffffff','#ffc2dc','#d9c8ff','#bdf0dc','#bfe3ff'];
const BGS = ['#ffe8a3','#cdeefd','#ffd6e0','#d8f5d0','#e7dcff','#ffe0c2','#ffffff'];
const BG_PATTERNS = [['p_bloom','ばらと キラキラ',80],['p_sakura','さくら',-1],['p_moon','おつきみ',-1],['p_yume','ゆめかわ',80],['p_cloud','そらと くも',60],['p_candy','キャンディ',60],['p_stars','ほしぞら',60],['p_hearts','ハート',60],['p_sunset','ゆうやけ',80],['p_rainbow','にじ',100],['p_space','うちゅう',150]];
const OUTFITS = [['tshirt','Tシャツ',0],['hoodie','パーカー',0],['jersey','ユニフォーム',60],['sailor','セーラー',60],['suit','スーツ',80],['kimono','きもの',100],['hero','ヒーロー',120],['frill','フリルドレス',80],['magical','まほうの ドレス',150],['pajama','パジャマ',40],['school','ブレザー',60],['overalls','オーバーオール',60],['cheer','チアガール',80],['witch','まじょの ローブ',120],['idol','アイドル',150],['gothic','くろの フリル',150],['princess','プリンセス ドレス',200],['yukata','ゆかた',-1]];
const ACCS = [['none','なし',0],['glasses','めがね',0],['ribbon','リボン',0],['cap','ぼうし',0],['headphones','ヘッドホン',0],['star','ほしピン',0],
  ['santa','あかい ぼうし',-1],['heartclip','ハートピン',30],['flowerclip','はなピン',30],['bigribbon','おおきな リボン',60],['tiara','ティアラ',150],['bunny','うさみみ',100],['headband','はちまき',40],['flower','はなかんむり',60],['sunglasses','サングラス',80],['catears','ねこみみ',100],['wizard','まほうの ぼうし',120],['horns','ドラゴンの つの',120],['halo','てんしの わ',150],['crown','おうかん',200]];
const PETS = [['none','なし',0],['chick','ひよこ',50],['hamster','ハムスター',60],['bunny','うさぎ',80],['bear','くま',80],['cat','ねこ',80],['dog','いぬ',80],['unicorn','ユニコーン',200],['robot','ロボ',150],['dragon','ドラゴン',200]];
const SHOES = [['auto','おまかせ',0],['sneaker','スニーカー',0],['loafer','ローファー',0],['ribbon','リボンの くつ',30],['rainboots','ながぐつ',40],['geta','げた',40],['boots','ブーツ',50],['starsneaker','ほしの スニーカー',60],['slippers','うさぎ スリッパ',60],['glass','ガラスの くつ',150]];
const SHOE_COLORS = ['#ff7a2f','#ef476f','#ff8fb1','#ffd23f','#3cc47c','#3a9bff','#9b7bff','#5a3a26','#2b2d42','#ffffff'];
const ITEMS = [['none','なし',0],['kite','たこ',-1],['fukumame','ふくまめ',-1],['diploma','そつぎょうしょうしょ',-1],['koinobori','こいのぼり',-1],['umbrella','かさ',-1],['sasa','ささかざり',-1],['pumpkin','かぼちゃランタン',-1],['balloon','ふうせん',40],['icecream','ソフトクリーム',50],['bouquet','はなたば',60],['starwand','ほしの ステッキ',100],['heartwand','ハートの ステッキ',100]];
const EFFECTS = [['none','なし',0],['momiji','もみじ',-1],['sparkle','キラキラ',80],['bubbles','しゃぼんだま',80],['petals','はなびら',80],['hearts','ハート',100],['rainbow','にじの わく',100],['aura','オーラ',120],['fire','ほのお',150]];
const SHOP = {outfit:OUTFITS, acc:ACCS, pet:PETS, effect:EFFECTS, bg:BG_PATTERNS, item:ITEMS, shoes:SHOES};
const priceOf = (key, val) => { const l = SHOP[key]; if (!l) return 0; const f = l.find(x => x[0] === val); return f ? f[2] : 0; };
const owns = (key, val) => priceOf(key, val) === 0 || (META.owned || []).includes(key + ':' + val);
const totalStars = () => ALLK.reduce((a, k) => a + stars(k), 0);
function shade(hex, f){ const n = parseInt(hex.slice(1),16); const c = [n>>16, (n>>8)&255, n&255].map(v => Math.max(0, Math.min(255, Math.round(v * f)))); return '#' + c.map(v => v.toString(16).padStart(2,'0')).join(''); }
let avSeq = 0;
function avatarSVG(a, expr='normal', vb='0 0 120 120', live=false, full=false){
  const A = Object.assign({}, AV_DEFAULT, a || {});
  const id = 'av' + (++avSeq);
  const hc = A.hairColor, sk = A.skin, dk = '#2b2d42', EC = /^#[0-9a-f]{6}$/i.test(A.eyeColor) ? A.eyeColor : dk, C = A.clothes, Cd = shade(C === '#ffffff' ? '#e6e6e6' : C, 0.82);
  const hs = HAIRS.find(h => h[0] === A.hair) || HAIRS[0];
  const star = (cx, cy, r, f, cls='') => { let p=''; for (let i=0;i<10;i++){ const rr = i%2 ? r*0.45 : r; const an = -Math.PI/2 + i*Math.PI/5; p += (i?'L':'M') + (cx+Math.cos(an)*rr).toFixed(1) + ',' + (cy+Math.sin(an)*rr).toFixed(1); } return `<path class="${cls}" d="${p}Z" fill="${f}" stroke="#e0a100" stroke-width=".8"/>`; };
  const spark = (x, y, r, f) => `<path class="av-tw" d="M${x},${y-r} Q${x+r*.18},${y-r*.18} ${x+r},${y} Q${x+r*.18},${y+r*.18} ${x},${y+r} Q${x-r*.18},${y+r*.18} ${x-r},${y} Q${x-r*.18},${y-r*.18} ${x},${y-r}Z" fill="${f}"/>`;
  const heart = (x, y, s, f) => `<path d="M${x},${y+3*s} C${x-6*s},${y-3*s} ${x-3*s},${y-8*s} ${x},${y-4*s} C${x+3*s},${y-8*s} ${x+6*s},${y-3*s} ${x},${y+3*s}Z" fill="${f}"/>`;
  const flower = (x, y, c) => [0,1,2,3,4].map(i => { const an = i*Math.PI*2/5; return `<circle cx="${(x+Math.cos(an)*3.6).toFixed(1)}" cy="${(y+Math.sin(an)*3.6).toFixed(1)}" r="3" fill="${c}"/>`; }).join('') + `<circle cx="${x}" cy="${y}" r="2.4" fill="#ffd23f"/>`;
  const BH = full ? 200 : 120;
  let defs = full ? `<clipPath id="${id}c"><rect x="0" y="0" width="120" height="200" rx="16"/></clipPath>` : `<clipPath id="${id}c"><circle cx="60" cy="60" r="60"/></clipPath>`;
  // background
  let bg = '';
  const STARPTS = [[16,20],[34,10],[90,14],[104,40],[12,58],[22,90],[100,70],[50,8],[110,96],[8,36]];
  if (A.bg === 'p_bloom'){ defs += `<linearGradient id="${id}b" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffe6f0"/><stop offset="1" stop-color="#ffc2da"/></linearGradient>`;
    const rose = (x, y, s) => `<g transform="translate(${x} ${y}) scale(${s})"><circle r="7" fill="#ff8fb1"/><path d="M0,-5 Q5,-4 4,1 Q2,5 -2,4 Q-5,1 -3,-2 Q-1,-4 2,-2 Q3,1 0,2" fill="none" stroke="#e8577a" stroke-width="1.3"/><ellipse cx="-7" cy="5" rx="4" ry="2" fill="#5cd08f" transform="rotate(-30 -7 5)"/></g>`;
    bg = `<rect width="120" height="120" fill="url(#${id}b)"/>` + [[14,18,1],[106,26,.9],[10,70,.8],[110,80,1],[60,6,.7]].map(([x,y,s]) => rose(x,y,s)).join('') + [[30,40,3],[92,50,4],[20,100,3],[100,108,3.5],[46,10,2.4]].map(([x,y,r]) => `<circle cx="${x}" cy="${y}" r="${r*2.2}" fill="#fff" opacity=".45"/>`).join('') + STARPTS.slice(0,6).map(([x,y]) => spark(x,y,2.6,'#fff')).join(''); }
  else if (A.bg === 'p_yume'){ defs += `<linearGradient id="${id}y" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffd1ea"/><stop offset=".5" stop-color="#e3d3ff"/><stop offset="1" stop-color="#c9f5e6"/></linearGradient>`; bg = `<rect width="120" height="120" fill="url(#${id}y)"/>` + STARPTS.map(([x,y],i) => i%3 === 0 ? heart(x,y,.7,'#ff9ccc') : spark(x,y,i%2?2.2:3.2,'#fff')).join(''); }
  else if (A.bg === 'p_cloud') bg = `<rect width="120" height="120" fill="#bfe6ff"/>` + [[22,26,1],[92,18,.8],[100,62,.9],[14,74,.85]].map(([x,y,s]) => `<g fill="#fff" opacity=".95"><circle cx="${x}" cy="${y}" r="${7*s}"/><circle cx="${x+8*s}" cy="${y-3*s}" r="${8*s}"/><circle cx="${x+16*s}" cy="${y}" r="${6.5*s}"/><rect x="${x}" y="${y}" width="${16*s}" height="${6*s}"/></g>`).join('');
  else if (A.bg === 'p_candy') bg = `<rect width="120" height="120" fill="#fff0f6"/>` + [0,1,2,3,4,5,6,7].map(i => `<rect x="${-60 + i*30}" y="-20" width="12" height="170" fill="${['#ffc2dc','#c9f5e6','#e3d3ff','#fff1a8'][i%4]}" transform="rotate(30 60 60)"/>`).join('');
  else if (A.bg === 'p_sakura') bg = `<rect width="120" height="120" fill="#ffe3ef"/><path d="M-4,20 Q24,26 44,8 M18,22 Q24,34 36,36" stroke="#8a5a2b" stroke-width="3" fill="none" stroke-linecap="round"/>` + [[30,14],[44,8],[14,28],[100,20],[108,56],[12,70],[96,96],[24,104],[60,6],[36,36]].map(([x,y],i) => flower(x, y, i%2 ? '#ffb3d1' : '#ffc9de')).join('');
  else if (A.bg === 'p_moon') bg = `<rect width="120" height="120" fill="#1d2a55"/>` + STARPTS.slice(0,7).map(([x,y]) => spark(x,y,1.8,'#fff')).join('') + `<circle cx="84" cy="32" r="18" fill="#fff3b0"/><circle cx="84" cy="32" r="18" fill="none" stroke="#ffe36e" stroke-width="2" opacity=".6"/>` + [8,16,24,104,112].map((x,i) => `<path d="M${x},122 Q${x+2},${92-i*2} ${x+10},${74+i*3}" stroke="#c9a227" stroke-width="2" fill="none"/>`).join('');
  else if (A.bg === 'p_stars') bg = `<rect width="120" height="120" fill="#2b3a67"/>` + STARPTS.map(([x,y],i) => spark(x,y,i%3?2.4:3.6,i%2?'#fff':'#ffd23f')).join('');
  else if (A.bg === 'p_hearts') bg = `<rect width="120" height="120" fill="#ffd6e0"/>` + [[16,22],[100,18],[14,70],[106,66],[30,104],[92,104],[60,6]].map(([x,y],i) => heart(x,y,i%2?.9:1.2,i%2?'#ff8fb1':'#ff5d8f')).join('');
  else if (A.bg === 'p_sunset'){ defs += `<linearGradient id="${id}s" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffcf6b"/><stop offset=".55" stop-color="#ff7a9a"/><stop offset="1" stop-color="#8a63d2"/></linearGradient>`; bg = `<rect width="120" height="120" fill="url(#${id}s)"/><circle cx="96" cy="30" r="10" fill="#fff3b0" opacity=".9"/>`; }
  else if (A.bg === 'p_rainbow') bg = `<rect width="120" height="120" fill="#cdeefd"/>` + ['#ff6b6b','#ff9f43','#ffd23f','#3cc47c','#3a9bff','#9b7bff'].map((c,i) => `<circle cx="60" cy="128" r="${104 - i*8}" fill="none" stroke="${c}" stroke-width="8"/>`).join('') + `<circle cx="60" cy="128" r="56" fill="#cdeefd"/>`;
  else if (A.bg === 'p_space') bg = `<rect width="120" height="120" fill="#141a33"/>` + STARPTS.map(([x,y],i) => spark(x,y,i%3?1.8:2.8,'#fff')).join('') + `<circle cx="98" cy="28" r="9" fill="#ffb36b"/><ellipse cx="98" cy="28" rx="15" ry="4" fill="none" stroke="#ffe0b0" stroke-width="2" transform="rotate(-18 98 28)"/>`;
  else bg = `<rect width="120" height="120" fill="${/^#[0-9a-f]{6}$/i.test(A.bg) ? A.bg : '#ffe8a3'}"/>`;
  if (full){
    bg = bg.replace(/<rect width="120" height="120"/g, '<rect width="120" height="200"');
    if (!['p_moon','p_rainbow','p_sunset','p_space'].includes(A.bg)){ const deco = bg.replace(/<rect width="120" height="200"[^>]*\/>/g, ''); if (deco) bg += `<g transform="translate(0,96)">${deco}</g>`; }
  }
  // effects behind
  let behind = '';
  if (A.effect === 'aura'){ defs += `<radialGradient id="${id}a"><stop offset="0" stop-color="#9ef0ff" stop-opacity=".95"/><stop offset=".6" stop-color="#5bc8ff" stop-opacity=".55"/><stop offset="1" stop-color="#5bc8ff" stop-opacity="0"/></radialGradient>`; behind = `<circle class="av-tw" cx="60" cy="62" r="52" fill="url(#${id}a)"/>`; }
  if (A.effect === 'fire') behind = [-30,-15,0,15,30].map((dx,i) => { const x = 60+dx, tip = 8 + Math.abs(dx)*0.7; return `<path class="av-tw" d="M${x-11},70 Q${x-14},${tip+26} ${x},${tip} Q${x+14},${tip+26} ${x+11},70Z" fill="#ff7a2f" opacity=".9"/><path d="M${x-6},70 Q${x-7},${tip+30} ${x},${tip+14} Q${x+7},${tip+30} ${x+6},70Z" fill="#ffd23f"/>`; }).join('');
  const back = {
    none:'',
    bob:`<path d="M25,58 Q25,20 60,20 Q95,20 95,58 L95,88 Q95,94 89,94 L31,94 Q25,94 25,88Z" fill="${hc}"/>`,
    long:`<path d="M25,58 Q25,20 60,20 Q95,20 95,58 L98,114 L22,114Z" fill="${hc}"/>`,
    twin:`<ellipse cx="21" cy="68" rx="10" ry="19" fill="${hc}"/><ellipse cx="99" cy="68" rx="10" ry="19" fill="${hc}"/><circle cx="26" cy="50" r="4" fill="#ff5d8f"/><circle cx="94" cy="50" r="4" fill="#ff5d8f"/>`,
    pony:`<path d="M82,32 Q110,38 101,82 Q95,64 84,54Z" fill="${hc}"/>`,
    bun:`<circle cx="60" cy="19" r="13" fill="${hc}"/>`,
    wavy:`<path d="M24,58 Q22,20 60,20 Q98,20 96,58 Q101,70 95,80 Q101,92 93,104 Q97,113 86,117 L34,117 Q23,113 27,104 Q19,92 25,80 Q19,70 24,58Z" fill="${hc}"/>`,
    sidepony:`<path d="M32,38 Q4,48 13,96 Q21,76 36,58Z" fill="${hc}"/><circle cx="31" cy="41" r="4.5" fill="#ff8fb1"/>`,
    afro:`<circle cx="60" cy="42" r="36" fill="${hc}"/><circle cx="28" cy="54" r="14" fill="${hc}"/><circle cx="92" cy="54" r="14" fill="${hc}"/>`
  }[hs[2]] || '';
  const curly = [[32,46],[36,34],[46,26],[60,23],[74,26],[84,34],[88,46]].map(([x,y]) => `<circle cx="${x}" cy="${y}" r="10" fill="${hc}"/>`).join('');
  const front = {
    short:`<path d="M28,56 Q26,22 60,22 Q94,22 92,56 Q89,44 81,39 Q71,46 59,39 Q47,46 37,40 Q31,46 28,56Z" fill="${hc}"/>`,
    bangs:`<path d="M28,62 Q25,21 60,21 Q95,21 92,62 L90,46 Q60,42 30,46Z" fill="${hc}"/>`,
    side:`<path d="M28,60 Q26,21 62,21 Q95,22 92,58 Q88,40 72,36 Q52,48 28,60Z" fill="${hc}"/>`,
    spiky:`<path d="M29,56 L22,36 L36,38 L36,20 L50,30 L60,12 L70,30 L84,20 L84,38 L98,36 L91,56 Q84,42 60,40 Q36,42 29,56Z" fill="${hc}"/>`,
    buzz:`<path d="M31,50 Q31,27 60,27 Q89,27 89,50 Q75,40 60,40 Q45,40 31,50Z" fill="${hc}"/>`,
    mohawk:`<path d="M31,50 Q31,28 60,28 Q89,28 89,50 Q75,41 60,41 Q45,41 31,50Z" fill="${hc}" opacity=".55"/><path d="M52,42 L49,18 L55,22 L57,6 L63,20 L69,10 L70,24 L72,42 Q60,37 52,42Z" fill="${hc}"/>`,
    curly:`<path d="M29,52 Q28,26 60,25 Q92,26 91,52 Q60,38 29,52Z" fill="${hc}"/>` + curly
  }[hs[3]] || '';
  const hairTop = {mohawk:1, buzz:1}[hs[3]] ? 32 : 30;
  const shine = A.hairShine === 'tsuya' || A.hairShine === 'kira' ? `<path d="M37,${hairTop+8} Q60,${hairTop-4} 83,${hairTop+8}" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" opacity=".55"/><path d="M42,${hairTop+5} Q48,${hairTop+1} 54,${hairTop}" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity=".8"/>` + (A.hairShine === 'kira' ? spark(40, hairTop+2, 3.4, '#fff') + spark(80, hairTop+1, 2.6, '#fff8c4') + spark(70, hairTop-6, 2, '#fff') + spark(30, 52, 2.2, '#fff8c4') : '') : '';
  const head = {
    shoujo:`<path d="M30,55 Q30,27 60,27 Q90,27 90,55 Q90,74 76,83 Q66,90 60,90 Q54,90 44,83 Q30,74 30,55Z" fill="${sk}"/>`,
    round:`<ellipse cx="60" cy="58" rx="30" ry="30" fill="${sk}"/>`,
    oval:`<ellipse cx="60" cy="59" rx="27" ry="32" fill="${sk}"/>`,
    square:`<rect x="31" y="28" width="58" height="60" rx="20" fill="${sk}"/>`,
    wide:`<ellipse cx="60" cy="60" rx="33" ry="28" fill="${sk}"/>`
  }[A.face] || '';
  const ex = {shoujo:30, round:30, oval:33, square:31, wide:27}[A.face] || 30;
  const ears = `<circle cx="${ex}" cy="63" r="6" fill="${sk}"/><circle cx="${120-ex}" cy="63" r="6" fill="${sk}"/>`;
  // outfit
  const torso = `<path d="M18,122 Q20,92 60,90 Q100,92 102,122Z" fill="${C}" stroke="${C === '#ffffff' ? '#ddd' : 'none'}"/>`;
  let cape = '', outfit = '';
  switch (A.outfit){
    case 'hoodie': outfit = `<path d="M36,95 Q38,80 60,80 Q82,80 84,95 Q72,88 60,88 Q48,88 36,95Z" fill="${Cd}"/><path d="M55,96 L54,108 M65,96 L66,108" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/><circle cx="54" cy="109" r="1.6" fill="#fff"/><circle cx="66" cy="109" r="1.6" fill="#fff"/><path d="M44,112 Q60,108 76,112 L77,122 L43,122Z" fill="${Cd}"/>`; break;
    case 'jersey': outfit = `<path d="M24,108 L40,94 M96,108 L80,94" stroke="#fff" stroke-width="3.5" stroke-linecap="round"/><path d="M51,91 Q60,98 69,91" fill="none" stroke="#fff" stroke-width="3"/><text x="60" y="117" font-size="15" font-weight="bold" fill="#fff" text-anchor="middle" font-family="Arial,sans-serif">1</text>`; break;
    case 'sailor': outfit = `<path d="M42,90 L60,104 L78,90 L96,99 L60,123 L24,99Z" fill="#fff"/><path d="M42,90 L60,104 L78,90" fill="none" stroke="#3a9bff" stroke-width="1.6"/><path d="M53,101 L67,101 L60,113Z" fill="#ef476f"/>`; break;
    case 'suit': outfit = `<path d="M50,91 L60,116 L70,91Z" fill="#fff"/><path d="M58,94 L62,94 L64.5,108 L60,113 L55.5,108Z" fill="#ef476f"/><path d="M50,91 L57,108 M70,91 L63,108" stroke="${Cd}" stroke-width="2.4"/>`; break;
    case 'kimono': outfit = `<path d="M48,90 L55,90 L74,123 L65,123Z" fill="#fff"/><path d="M72,90 L65,90 L57,104 L61,108Z" fill="#fff"/><rect x="20" y="110" width="80" height="8" fill="#ffd23f"/>`; break;
    case 'hero': cape = `<path d="M34,94 Q16,108 8,124 L112,124 Q104,108 86,94Z" fill="#ef476f"/>`; outfit = star(60, 108, 7, '#ffd23f') + `<path d="M50,92 Q60,99 70,92" fill="none" stroke="${Cd}" stroke-width="2.4"/>`; break;
    case 'yukata': outfit = [[34,104],[48,114],[78,104],[90,116],[62,118]].map(([x,y]) => flower(x, y, '#fff')).join('') + `<path d="M48,90 L55,90 L74,123 L65,123Z" fill="#fff"/><path d="M72,90 L65,90 L57,104 L61,108Z" fill="#fff"/><rect x="20" y="108" width="80" height="9" fill="#ff7eb6"/><path d="M60,112 L52,107 L52,117Z M60,112 L68,107 L68,117Z" fill="#ffd23f"/>`; break;
    case 'frill': outfit = `<circle cx="25" cy="108" r="9" fill="${shade(C,1.08)}"/><circle cx="95" cy="108" r="9" fill="${shade(C,1.08)}"/>` + [44,49,54,59,64,69,74].map((x,i) => `<circle cx="${x+1}" cy="${92 + Math.abs(i-3)*-0.6 + 1}" r="3.4" fill="#fff"/>`).join('') + `<path d="M60,103 L50,97 L50,109Z M60,103 L70,97 L70,109Z" fill="#ff7eb6"/><circle cx="60" cy="103" r="2.6" fill="#ff5d9e"/>` + [30,42,54,66,78,90].map(x => `<circle cx="${x}" cy="121" r="4" fill="#fff" opacity=".85"/>`).join(''); break;
    case 'magical': outfit = `<circle cx="24" cy="106" r="10" fill="#fff"/><circle cx="96" cy="106" r="10" fill="#fff"/><circle cx="24" cy="106" r="10" fill="none" stroke="${Cd}" stroke-width="1.4"/><circle cx="96" cy="106" r="10" fill="none" stroke="${Cd}" stroke-width="1.4"/><path d="M60,104 L42,94 Q38,104 42,114Z M60,104 L78,94 Q82,104 78,114Z" fill="#ff4f8b"/><path d="M58,106 L52,122 M62,106 L68,122" stroke="#ff4f8b" stroke-width="3.2" stroke-linecap="round"/>` + heart(60, 104, 1, '#ffd23f') + spark(60, 101.6, 1.4, '#fff'); break;
    case 'princess': outfit = [44,50,56,62,68,74].map(x => `<circle cx="${x+1}" cy="96" r="1.6" fill="#fff"/>`).join('') + `<circle cx="24" cy="106" r="9" fill="${shade(C,1.08)}" stroke="#fff" stroke-width="1.4"/><circle cx="96" cy="106" r="9" fill="${shade(C,1.08)}" stroke="#fff" stroke-width="1.4"/>` + heart(60, 108, .8, '#ffd23f'); break;
    case 'idol': outfit = star(60, 110, 6, '#ffd23f') + `<path d="M60,97 L51,92 L51,102Z M60,97 L69,92 L69,102Z" fill="#ff5d9e"/><circle cx="24" cy="106" r="9" fill="${shade(C,1.08)}" stroke="#fff" stroke-width="1.4"/><circle cx="96" cy="106" r="9" fill="${shade(C,1.08)}" stroke="#fff" stroke-width="1.4"/>`; break;
    case 'school': outfit = `<path d="M50,91 L60,114 L70,91Z" fill="#fff"/><path d="M60,99 L52,95 L52,103Z M60,99 L68,95 L68,103Z" fill="#ef476f"/><path d="M50,91 L57,110 M70,91 L63,110" stroke="${Cd}" stroke-width="2.2"/>`; break;
    case 'overalls': outfit = `<path d="M18,122 Q20,92 60,90 Q100,92 102,122Z" fill="#fff"/><rect x="44" y="106" width="32" height="20" rx="3" fill="${C}"/><path d="M40,94 L46,108 M80,94 L74,108" stroke="${C}" stroke-width="4"/><circle cx="47" cy="109" r="1.8" fill="#ffd23f"/><circle cx="73" cy="109" r="1.8" fill="#ffd23f"/>`; break;
    case 'pajama': outfit = [[34,108],[50,100],[70,104],[86,110],[58,116],[44,118],[78,118]].map(([x,y]) => `<circle cx="${x}" cy="${y}" r="2" fill="#fff"/>`).join('') + `<path d="M52,91 L60,99 L68,91" fill="none" stroke="#fff" stroke-width="2.6"/>`; break;
    case 'gothic': outfit = `<path d="M18,122 Q20,92 60,90 Q100,92 102,122Z" fill="#2b2d42"/>` + [44,50,56,62,68,74].map(x => `<circle cx="${x+1}" cy="93" r="3.4" fill="#fff"/>`).join('') + `<path d="M60,102 L51,97 L51,107Z M60,102 L69,97 L69,107Z" fill="${C === '#2b2d42' ? '#ef476f' : C}"/>`; break;
    case 'cheer': outfit = `<path d="M40,94 L60,116 L80,94" fill="none" stroke="#fff" stroke-width="3.4"/>`; break;
    case 'witch': outfit = `<path d="M52,91 L60,102 L68,91" fill="#fff"/>` + star(42, 110, 3, '#ffd23f') + star(78, 106, 3, '#ffd23f') + star(62, 116, 2.4, '#ffd23f'); break;
    default: outfit = `<path d="M52,91 L60,100 L68,91" fill="none" stroke="rgba(255,255,255,.75)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>`;
  }
  // ---- ぜんしん ----
  const POSE = (POSES.find(p => p[0] === A.pose) || POSES[0])[2];
  const FO = {
    tshirt:{sl:'short', lo:'pants', lc:'#4a6fa5', sh:'#ff7a2f'}, hoodie:{sl:'long', lo:'shorts', lc:'#3b3f5c', sh:'#ffffff'},
    jersey:{sl:'short', lo:'shorts', lc:C, sh:'#ffffff'}, sailor:{sl:'short', top:'#ffffff', lo:'skirt', lc:C, sh:'#5a3a26'},
    suit:{sl:'long', lo:'pants', lc:Cd, sh:'#3b2a20'}, kimono:{sl:'wide', lo:'long', lc:C, sh:'#8a5a2b'}, yukata:{sl:'wide', lo:'long', lc:C, sh:'#8a5a2b'},
    hero:{sl:'short', lo:'pants', lc:Cd, sh:'#ef476f'}, frill:{sl:'puff', lo:'dress', lc:C, sh:'#ff7eb6'}, magical:{sl:'puff', pc:'#ffffff', lo:'dress2', lc:C, sh:'#ffffff'},
    princess:{sl:'puff', lo:'gown', lc:C, sh:'#ffd23f'}, idol:{sl:'puff', lo:'mini', lc:C, sh:'#ffffff'}, school:{sl:'long', lo:'skirt', lc:'#4a4f6a', sh:'#3b2a20', plaid:1},
    overalls:{sl:'short', top:'#ffffff', lo:'shorts', lc:C, sh:'#ff7a2f'}, pajama:{sl:'long', lo:'pants', lc:C, sh:'#ffb3d1'},
    gothic:{sl:'puff', top:'#2b2d42', pc:'#2b2d42', lo:'dress', lc:'#2b2d42', sh:'#2b2d42'}, cheer:{sl:'none', lo:'skirt', lc:C, sh:'#ffffff'},
    witch:{sl:'wide', lo:'long', lc:C, sh:'#3b2a20'}
  };
  function fullBody(){
    const S = FO[A.outfit] || FO.tshirt, T = S.top || C, Td = shade(T === '#ffffff' ? '#e6e6e6' : T, .82), L = S.lc, Ld = shade(L === '#ffffff' ? '#e6e6e6' : L, .82);
    const pl = pts => 'M' + pts.map(p => p.join(',')).join(' L');
    const mid = (a, b, f) => [a[0] + (b[0]-a[0])*f, a[1] + (b[1]-a[1])*f];
    const LEGS = {stand:[[[53,140],[52,162],[52,182]],[[67,140],[68,162],[68,182]]], open:[[[53,140],[48,162],[45,182]],[[67,140],[72,162],[75,182]]],
      cross:[[[53,140],[57,162],[63,182]],[[67,140],[64,162],[57,182]]], jump:[[[53,140],[42,154],[47,172]],[[67,140],[80,152],[74,170]]]};
    const legs = LEGS[POSE.legs] || LEGS.stand;
    let o = '';
    if (A.outfit === 'hero') o += `<path d="M42,96 Q22,140 14,196 L106,196 Q98,140 78,96Z" fill="#ef476f"/>`;
    // あし
    legs.forEach(g => { o += `<path d="${pl(g)}" fill="none" stroke="${sk}" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>`; });
    if (S.lo === 'pants') legs.forEach(g => { o += `<path d="${pl([g[0], g[1], mid(g[1], g[2], .82)])}" fill="none" stroke="${L}" stroke-width="11.5" stroke-linecap="round" stroke-linejoin="round"/>`; });
    if (S.lo === 'shorts') legs.forEach(g => { o += `<path d="${pl([g[0], mid(g[0], g[1], .55)])}" fill="none" stroke="${L}" stroke-width="12.5" stroke-linecap="round"/>`; });
    if (A.outfit === 'pajama') legs.forEach(g => { [.3,.6,.9].forEach(f => { const p = mid(g[0], g[1], f); o += `<circle cx="${p[0]}" cy="${p[1]}" r="1.4" fill="#fff"/>`; }); });
    const SHOE_DEF = {sneaker:'#ff7a2f', starsneaker:'#3a9bff', loafer:'#5a3a26', ribbon:'#ff8fb1', boots:'#8a5a2b', rainboots:'#ffd23f', geta:'#ef476f', glass:'#bfe6ff', slippers:'#ffffff'};
    const shoe = (g, side) => {
      const f = g[2], ty = A.shoes && A.shoes !== 'auto' ? A.shoes : null;
      const c = ty ? (/^#[0-9a-f]{6}$/i.test(A.shoeColor) ? A.shoeColor : SHOE_DEF[ty]) : S.sh;
      const dk2 = shade(c === '#ffffff' ? '#dddddd' : c, .78);
      const base = (fill = c, st = dk2) => `<ellipse cx="${f[0]}" cy="${f[1] + 2}" rx="6.8" ry="4" fill="${fill}" stroke="${st}" stroke-width="1"/>`;
      if (!ty) return base();
      if (ty === 'sneaker' || ty === 'starsneaker') return base() + `<path d="M${f[0]-6.2},${f[1]+3.4} Q${f[0]},${f[1]+6.6} ${f[0]+6.2},${f[1]+3.4}" stroke="#fff" stroke-width="1.7" fill="none"/><path d="M${f[0]-2},${f[1]-.4} L${f[0]+1},${f[1]+.4} M${f[0]-2},${f[1]+1.4} L${f[0]+1},${f[1]+2.2}" stroke="#fff" stroke-width=".9"/>` + (ty === 'starsneaker' ? star(f[0] + side*2.6, f[1] + 2, 2.4, '#ffd23f') : '');
      if (ty === 'loafer') return base() + `<path d="M${f[0]-3.2},${f[1]+.6} L${f[0]+3.2},${f[1]+.6}" stroke="${shade(c, 1.5)}" stroke-width="1.4"/>`;
      if (ty === 'ribbon') return base() + `<path d="M${f[0]},${f[1]} L${f[0]-4},${f[1]-2.6} L${f[0]-4},${f[1]+2.6}Z M${f[0]},${f[1]} L${f[0]+4},${f[1]-2.6} L${f[0]+4},${f[1]+2.6}Z" fill="#ff5d9e"/><circle cx="${f[0]}" cy="${f[1]}" r="1.3" fill="#fff"/>`;
      if (ty === 'boots' || ty === 'rainboots') return `<path d="${pl([mid(g[1], g[2], .3), g[2]])}" fill="none" stroke="${c}" stroke-width="11" stroke-linecap="round"/>` + base() + (ty === 'boots' ? `<path d="${pl([mid(g[1], g[2], .3), mid(g[1], g[2], .32)])}" stroke="${dk2}" stroke-width="12" stroke-linecap="round"/>` : `<path d="${pl([mid(g[1], g[2], .4), mid(g[1], g[2], .85)])}" stroke="#fff" stroke-width="1.8" stroke-linecap="round" opacity=".6"/>`);
      if (ty === 'geta') return `<rect x="${f[0]-7}" y="${f[1]+1.6}" width="14" height="3.2" rx="1.2" fill="#d9a066"/><rect x="${f[0]-5.5}" y="${f[1]+4.6}" width="3" height="2.6" fill="#b07a4f"/><rect x="${f[0]+2.5}" y="${f[1]+4.6}" width="3" height="2.6" fill="#b07a4f"/><path d="M${f[0]-3.4},${f[1]+1.8} L${f[0]},${f[1]-1.2} L${f[0]+3.4},${f[1]+1.8}" stroke="${c}" stroke-width="2" fill="none" stroke-linecap="round"/>`;
      if (ty === 'glass') return base('rgba(205,238,255,.8)', '#8ac4ef') + `<ellipse cx="${f[0] - 2}" cy="${f[1] + .8}" rx="2.2" ry="1" fill="#fff" opacity=".9"/>` + spark(f[0] + side*4, f[1] - 2, 2.2, '#fff8c4');
      if (ty === 'slippers') return base() + `<ellipse cx="${f[0]-2.4}" cy="${f[1]-2.6}" rx="1.4" ry="3.2" fill="${c}" stroke="${dk2}" stroke-width=".7"/><ellipse cx="${f[0]+1.4}" cy="${f[1]-3}" rx="1.4" ry="3.2" fill="${c}" stroke="${dk2}" stroke-width=".7"/><circle cx="${f[0]-.5}" cy="${f[1]+1.6}" r=".9" fill="#ff7a9a"/>`;
      return base();
    };
    legs.forEach((g, i) => { o += shoe(g, i ? 1 : -1); });
    if (S.lo === 'shorts' || S.lo === 'pants') o += `<path d="M42,128 L78,128 L79,142 L41,142Z" fill="${L}"/>`;
    // スカート
    const frillHem = (y0, x0, x1, c) => { let r = ''; for (let x = x0; x <= x1; x += 6) r += `<circle cx="${x}" cy="${y0}" r="3.6" fill="${c}"/>`; return r; };
    if (S.lo === 'skirt'){ o += `<path d="M41,128 L79,128 L88,154 Q60,160 32,154Z" fill="${L}"/><path d="M50,130 L45,156 M60,130 L60,158 M70,130 L75,156" stroke="${Ld}" stroke-width="1.4"/>`;
      if (S.plaid) o += `<path d="M38,140 L82,140 M35,148 L85,148" stroke="#ef476f" stroke-width="1.2" opacity=".7"/>`;
      if (A.outfit === 'cheer') o += `<path d="M34,150 Q60,156 86,150" stroke="#fff" stroke-width="2.4" fill="none"/>`; }
    if (S.lo === 'dress'){ o += `<path d="M41,128 L79,128 L90,158 Q60,165 30,158Z" fill="${L}"/>` + frillHem(159, 32, 88, A.outfit === 'gothic' ? '#ffffff' : '#fff'); }
    if (S.lo === 'dress2'){ o += `<path d="M40,128 L80,128 L92,162 Q60,170 28,162Z" fill="#fff"/>` + frillHem(163, 30, 90, '#ffe3ee') + `<path d="M41,128 L79,128 L88,152 Q81,158 74,152 Q67,158 60,152 Q53,158 46,152 Q39,158 32,152Z" fill="${L}"/>`; }
    if (S.lo === 'mini'){ o += `<path d="M42,128 L78,128 L88,152 Q60,158 32,152Z" fill="#fff"/>` + frillHem(153, 34, 86, '#ffe3ee') + `<path d="M42,128 L78,128 L84,143 Q60,148 36,143Z" fill="${L}"/>` + heart(42, 142, .7, '#ff5d9e') + heart(78, 142, .7, '#ff5d9e'); }
    if (S.lo === 'long'){ o += `<path d="M41,128 L79,128 L85,186 Q60,191 35,186Z" fill="${L}"/>`;
      if (A.outfit === 'yukata') o += [[46,150],[70,140],[56,172],[76,168],[44,180]].map(([x,y]) => flower(x, y, '#fff')).join('');
      if (A.outfit === 'witch') o += [[46,152],[70,144],[58,174],[76,170]].map(([x,y]) => star(x, y, 3.2, '#ffd23f')).join(''); }
    if (S.lo === 'gown'){ o += `<path d="M42,126 L78,126 Q104,166 102,190 Q60,198 18,190 Q16,166 42,126Z" fill="#fff"/><path d="M42,126 L78,126 Q98,162 96,184 Q60,192 24,184 Q22,162 42,126Z" fill="${L}"/><path d="M50,130 Q44,160 40,186 M70,130 Q76,160 80,186 M60,128 L60,188" stroke="${Ld}" stroke-width="1.3" fill="none" opacity=".7"/>` + frillHem(189, 22, 98, '#ffe3ee') + spark(34, 170, 2.6, '#fff') + spark(84, 160, 2.2, '#fff') + spark(66, 178, 2, '#fff8c4'); }
    // どう
    o += `<rect x="54" y="84" width="12" height="12" fill="${sk}"/><path d="M43,95 Q60,89 77,95 L79,132 L41,132Z" fill="${T}" stroke="${T === '#ffffff' ? '#ddd' : 'none'}"/>`;
    const D = {
      tshirt:`<path d="M53,93 L60,101 L67,93" fill="none" stroke="rgba(255,255,255,.8)" stroke-width="2.6" stroke-linecap="round"/>`,
      hoodie:`<path d="M40,99 Q42,84 60,84 Q78,84 80,99 Q70,92 60,92 Q50,92 40,99Z" fill="${Td}"/><path d="M56,95 L55,106 M64,95 L65,106" stroke="#fff" stroke-width="1.6"/><path d="M46,118 Q60,114 74,118 L75,130 L45,130Z" fill="${Td}"/>`,
      jersey:`<path d="M52,93 Q60,99 68,93" fill="none" stroke="#fff" stroke-width="2.6"/><text x="60" y="123" font-size="15" font-weight="bold" fill="#fff" text-anchor="middle" font-family="Arial,sans-serif">1</text>`,
      sailor:`<path d="M44,93 L60,108 L76,93 L83,101 L60,118 L37,101Z" fill="${C}"/><path d="M46,96 L60,108 L74,96" fill="none" stroke="#fff" stroke-width="1.4"/><path d="M54,107 L66,107 L60,118Z" fill="#ef476f"/>`,
      suit:`<path d="M52,93 L60,118 L68,93Z" fill="#fff"/><path d="M58.4,96 L61.6,96 L63.5,110 L60,115 L56.5,110Z" fill="#ef476f"/><path d="M52,93 L57,112 M68,93 L63,112" stroke="${Td}" stroke-width="2"/>`,
      kimono:`<path d="M49,92 L55,92 L72,132 L64,132Z" fill="#fff"/><path d="M71,92 L65,92 L57,108 L61,111Z" fill="#fff"/><rect x="41" y="119" width="38" height="10" fill="#ffd23f"/>`,
      yukata:[[48,104],[70,100],[52,124]].map(([x,y]) => flower(x, y, '#fff')).join('') + `<path d="M49,92 L55,92 L72,132 L64,132Z" fill="#fff"/><path d="M71,92 L65,92 L57,108 L61,111Z" fill="#fff"/><rect x="41" y="118" width="38" height="10" fill="#ff7eb6"/><path d="M60,123 L52,118 L52,128Z M60,123 L68,118 L68,128Z" fill="#ffd23f"/>`,
      hero: star(60, 110, 7, '#ffd23f') + `<rect x="41" y="126" width="38" height="5" fill="#ffd23f"/>`,
      frill: frillHem(94, 48, 72, '#fff') + `<path d="M60,106 L51,101 L51,111Z M60,106 L69,101 L69,111Z" fill="#ff7eb6"/><circle cx="60" cy="106" r="2.4" fill="#ff5d9e"/>`,
      magical:`<path d="M60,104 L44,95 Q41,104 44,113Z M60,104 L76,95 Q79,104 76,113Z" fill="#ff4f8b"/><path d="M58,106 L53,121 M62,106 L67,121" stroke="#ff4f8b" stroke-width="3" stroke-linecap="round"/>` + heart(60, 104, .9, '#ffd23f'),
      princess: [44,48,52,56,60,64,68,72,76].map((x,i) => `<circle cx="${x}" cy="${97 + Math.abs(i-4)*-.8 + 3}" r="1.5" fill="#fff"/>`).join('') + `<path d="M50,112 Q60,118 70,112 L68,130 L52,130Z" fill="${shade(C,1.08)}" opacity=".9"/>` + heart(60, 122, .6, '#ffd23f'),
      idol: star(60, 114, 6, '#ffd23f') + `<path d="M60,97 L52,92 L52,102Z M60,97 L68,92 L68,102Z" fill="#ff5d9e"/><circle cx="60" cy="97" r="2.2" fill="#ff7eb6"/>` + frillHem(131, 44, 76, '#fff'),
      school:`<path d="M52,93 L60,114 L68,93Z" fill="#fff"/><path d="M60,100 L53,96 L53,104Z M60,100 L67,96 L67,104Z" fill="#ef476f"/><path d="M52,93 L57,114 M68,93 L63,114" stroke="${Td}" stroke-width="2"/><circle cx="60" cy="120" r="1.4" fill="${Td}"/><circle cx="60" cy="126" r="1.4" fill="${Td}"/>`,
      overalls:`<rect x="48" y="108" width="24" height="24" rx="3" fill="${L}"/><path d="M47,96 L50,110 M73,96 L70,110" stroke="${L}" stroke-width="3.6" stroke-linecap="round"/><circle cx="51" cy="111" r="1.6" fill="#ffd23f"/><circle cx="69" cy="111" r="1.6" fill="#ffd23f"/><rect x="55" y="116" width="10" height="7" rx="1.5" fill="${Ld}"/>`,
      pajama: [[48,104],[66,100],[56,114],[72,120],[46,124],[62,126]].map(([x,y]) => `<circle cx="${x}" cy="${y}" r="1.8" fill="#fff"/>`).join('') + `<path d="M52,93 L60,100 L68,93" fill="none" stroke="#fff" stroke-width="2.4"/>`,
      gothic: frillHem(95, 48, 72, '#ffffff') + `<path d="M60,103 L52,98 L52,108Z M60,103 L68,98 L68,108Z" fill="${C === '#2b2d42' ? '#ef476f' : C}"/><circle cx="60" cy="103" r="2" fill="#fff"/><path d="M48,112 L72,112 M49,118 L71,118 M50,124 L70,124" stroke="#444a66" stroke-width="1.2"/>`,
      cheer:`<path d="M44,96 L60,116 L76,96" fill="none" stroke="#fff" stroke-width="3"/>`,
      witch:`<path d="M52,93 L60,104 L68,93" fill="#fff"/>` + star(54, 118, 3, '#ffd23f') + star(68, 110, 2.6, '#ffd23f')
    };
    o += D[A.outfit] || D.tshirt;
    // うで
    const arm = (seg, side) => {
      const [s, e, h] = seg; let r = '';
      if (S.sl === 'wide'){ r += `<path d="${pl([e, h])}" stroke="${sk}" stroke-width="7" stroke-linecap="round"/><path d="M${s[0]},${s[1]-3} L${e[0]+side*2},${e[1]-3} L${e[0]+side*2},${e[1]+12} L${s[0]},${s[1]+12}Z" fill="${T}" stroke="${Td}" stroke-width="1"/>`; }
      else {
        r += `<path d="${pl([s, e, h])}" fill="none" stroke="${sk}" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>`;
        if (S.sl === 'long') r += `<path d="${pl([s, e, mid(e, h, .8)])}" fill="none" stroke="${T}" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>`;
        if (S.sl === 'short') r += `<path d="${pl([s, mid(s, e, .6)])}" fill="none" stroke="${T}" stroke-width="10" stroke-linecap="round"/>`;
        if (S.sl === 'puff') r += `<circle cx="${s[0] + side*2}" cy="${s[1] + 2}" r="7.5" fill="${S.pc || T}" stroke="#fff" stroke-width="1.6"/>`;
      }
      r += `<circle cx="${h[0]}" cy="${h[1]}" r="4.3" fill="${sk}" stroke="${shade(sk, .85)}" stroke-width=".8"/>`;
      return r;
    };
    const hands = {L:POSE.L[2], R:POSE.R[2]};
    o += arm(POSE.L, -1) + arm(POSE.R, 1);
    if (POSE.peace){ const h = POSE.R[2]; o += `<path d="M${h[0]},${h[1]} L${h[0]-2.5},${h[1]-8} M${h[0]},${h[1]} L${h[0]+3},${h[1]-8}" stroke="${sk}" stroke-width="2.8" stroke-linecap="round"/>`; }
    if (POSE.heartHands) o += heart(60, 112, 1.1, '#ff5d8f');
    const holdKey = A.item && A.item !== 'none' ? POSE.hold : null;
    if (A.outfit === 'cheer') ['L','R'].forEach(k => { if (k === holdKey) return; const h = hands[k]; o += [[0,0],[-4,-3],[4,-3],[-4,3],[4,3],[0,-5],[0,5]].map(([dx,dy],i) => `<circle cx="${h[0]+dx}" cy="${h[1]+dy}" r="3.4" fill="${i%2 ? '#fff' : C}"/>`).join(''); });
    return {body:o, hold: holdKey ? hands[holdKey] : null};
  }

  const FB = full ? fullBody() : null;
  const body = full ? FB.body : cape + `<rect x="53" y="82" width="14" height="12" fill="${sk}"/>` + torso + outfit;
  // eyes
  const eye = (t, x, y, side) => {
    const st = `fill="none" stroke="${dk}" stroke-width="2.8" stroke-linecap="round"`;
    const lash = side ? `<path d="M${x-5.8},${y-4} Q${x},${y-9.5} ${x+5.8},${y-4}" fill="none" stroke="${dk}" stroke-width="1.9" stroke-linecap="round"/><path d="M${x + side*5.6},${y-4.2} L${x + side*8.6},${y-6.8}" stroke="${dk}" stroke-width="1.7" stroke-linecap="round"/>` : '';
    if (t === 'shoujo'){
      const gid = id + 'e' + (side > 0 ? 'r' : 'l');
      defs += `<linearGradient id="${gid}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${shade(EC === dk ? '#5a3a8a' : EC, .55)}"/><stop offset=".55" stop-color="${EC === dk ? '#8a63d2' : EC}"/><stop offset="1" stop-color="${EC === dk ? '#d9b8ff' : shade(EC, 1.5)}"/></linearGradient>`;
      return `<ellipse cx="${x}" cy="${y+1}" rx="6.4" ry="8.6" fill="#fff"/><ellipse cx="${x}" cy="${y+1.4}" rx="5.6" ry="7.8" fill="url(#${gid})"/><ellipse cx="${x}" cy="${y+.6}" rx="2.6" ry="3.6" fill="${dk}" opacity=".75"/>`
        + `<ellipse cx="${x + side*-1.6}" cy="${y-2.6}" rx="2.4" ry="3" fill="#fff"/><circle cx="${x + side*2}" cy="${y+4.4}" r="1.3" fill="#fff"/><circle cx="${x + side*-2.6}" cy="${y+3}" r=".8" fill="#fff" opacity=".9"/>`
        + `<path d="M${x-7},${y-5} Q${x},${y-11.5} ${x+7},${y-5}" fill="none" stroke="${dk}" stroke-width="2.6" stroke-linecap="round"/>`
        + `<path d="M${x + side*6.6},${y-5.2} L${x + side*10},${y-8.4} M${x + side*7},${y-3} L${x + side*10.4},${y-4.6} M${x + side*4},${y-8.2} L${x + side*5.6},${y-11.4}" stroke="${dk}" stroke-width="1.6" stroke-linecap="round"/>`
        + `<path d="M${x-4},${y+10.4} Q${x},${y+11.6} ${x+4},${y+10.4}" stroke="${dk}" stroke-width="1" fill="none" opacity=".55"/>`;
    }
    if (t === 'kira') return `<ellipse cx="${x}" cy="${y}" rx="5.7" ry="7.1" fill="${dk}"/><ellipse cx="${x}" cy="${y+.8}" rx="4.6" ry="5.9" fill="${EC}"/><ellipse cx="${x}" cy="${y+3.2}" rx="3.4" ry="2.4" fill="#fff" opacity=".35"/><ellipse cx="${x}" cy="${y+.6}" rx="2.1" ry="2.7" fill="${dk}" opacity=".7"/><circle cx="${x+1.9}" cy="${y-2.6}" r="2.2" fill="#fff"/><circle cx="${x-2}" cy="${y+2.6}" r="1.1" fill="#fff"/>` + lash;
    if (t === 'heart') return `<path d="M${x},${y+4.6} C${x-7.5},${y-1} ${x-4},${y-7.5} ${x},${y-3} C${x+4},${y-7.5} ${x+7.5},${y-1} ${x},${y+4.6}Z" fill="${EC === dk ? '#ff5d9e' : EC}" stroke="${dk}" stroke-width="1"/><circle cx="${x+2}" cy="${y-2.4}" r="1.3" fill="#fff"/>` + lash;
    if (t === 'star') return `<ellipse cx="${x}" cy="${y}" rx="5.4" ry="6.6" fill="${dk}"/>` + star(x, y+.4, 4.6, EC === dk ? '#ffd23f' : EC) + `<circle cx="${x+2}" cy="${y-2.8}" r="1.2" fill="#fff"/>` + lash;
    if (t === 'lash') return `<circle cx="${x}" cy="${y}" r="4.6" fill="${EC}"/><circle cx="${x}" cy="${y}" r="2.4" fill="${dk}" opacity=".6"/><circle cx="${x+1.6}" cy="${y-1.7}" r="1.6" fill="#fff"/>` + lash;
    if (t === 'dot') return `<circle cx="${x}" cy="${y}" r="3.3" fill="${dk}"/>`;
    if (t === 'sparkle') return `<ellipse cx="${x}" cy="${y}" rx="5" ry="6" fill="${EC}"/><circle cx="${x+1.8}" cy="${y-2.2}" r="2" fill="#fff"/><circle cx="${x-1.6}" cy="${y+2}" r="1" fill="#fff"/>`;
    if (t === 'cool') return `<path d="M${x-5},${y+1} Q${x},${y-3.5} ${x+5},${y+1}" ${st}/><circle cx="${x}" cy="${y+1}" r="2.6" fill="${dk}"/><path d="M${x-6},${y-8 + (side>0?2:0)} L${x+6},${y-8 + (side>0?0:2)}" ${st} stroke-width="2.6"/>`;
    if (t === 'smile' || t === 'happy') return `<path d="M${x-4.5},${y+1.5} Q${x},${y-5} ${x+4.5},${y+1.5}" ${st}/>`;
    if (t === 'sleepy') return `<path d="M${x-4.5},${y} Q${x},${y+3.5} ${x+4.5},${y}" ${st}/>`;
    if (t === 'think') return `<circle cx="${x-1.5}" cy="${y-1.5}" r="3.3" fill="${dk}"/><path d="M${x-5},${y-10} Q${x},${y-13} ${x+5},${y-10}" ${st} stroke-width="2.2"/>`;
    return `<circle cx="${x}" cy="${y}" r="4.6" fill="${EC}"/><circle cx="${x+1.6}" cy="${y-1.7}" r="1.6" fill="#fff"/>`;
  };
  let eyes;
  if (expr === 'happy' || expr === 'cheer') eyes = eye('happy',48,60) + eye('happy',72,60);
  else if (expr === 'think') eyes = eye('think',48,60) + eye('think',72,60);
  else if (A.eyes === 'wink') eyes = eye('round',48,60) + eye('smile',72,60);
