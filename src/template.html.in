    : ck === 'none' ? '' : `<ellipse cx="40" cy="70" rx="5.5" ry="3.5" fill="#ff8fa3" opacity=".55"/><ellipse cx="80" cy="70" rx="5.5" ry="3.5" fill="#ff8fa3" opacity=".55"/>`;
  const acc = {
