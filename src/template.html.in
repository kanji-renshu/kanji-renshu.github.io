    tiara:`<path d="M38,35 Q60,27 82,35 L79,23 L71,29 L66,16 L60,26 L54,16 L49,29 L41,23Z" fill="#ffd23f" stroke="#e0a100" stroke-width="1.3" stroke-linejoin="round"/>` + heart(60, 28, .7, '#ff5d9e') + `<circle cx="49" cy="28" r="1.6" fill="#9ad0ff"/><circle cx="71" cy="28" r="1.6" fill="#9ad0ff"/>` + spark(66, 14, 2.2, '#fff'),
    bunny:`<g transform="rotate(-12 46 24)"><ellipse cx="46" cy="10" rx="7.5" ry="19" fill="#fff" stroke="#f2c4d6" stroke-width="1.4"/><ellipse cx="46" cy="11" rx="3.6" ry="13" fill="#ffc2dc"/></g><g transform="rotate(22 74 24)"><ellipse cx="74" cy="10" rx="7.5" ry="19" fill="#fff" stroke="#f2c4d6" stroke-width="1.4"/><ellipse cx="74" cy="11" rx="3.6" ry="13" fill="#ffc2dc"/></g>`,
    headband:`<path d="M28,44 Q60,34 92,44 L92,51 Q60,41 28,51Z" fill="#ef476f"/><path d="M90,46 L104,38 L101,50Z M90,48 L102,56 L94,58Z" fill="#ef476f"/><circle cx="60" cy="42" r="4" fill="#fff"/><circle cx="60" cy="42" r="2.2" fill="#ef476f"/>`,
