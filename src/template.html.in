    crown:`<path d="M38,30 L42,10 L51,22 L60,6 L69,22 L78,10 L82,30Z" fill="#ffc93c" stroke="#e0a100" stroke-width="1.6" stroke-linejoin="round"/><circle cx="60" cy="22" r="3" fill="#ef476f"/><circle cx="48" cy="25" r="2.2" fill="#3a9bff"/><circle cx="72" cy="25" r="2.2" fill="#3cc47c"/>`
  }[A.acc] || '';
  const sweat = expr === 'think' ? `<path d="M92,40 Q97,48 92,52 Q87,48 92,40Z" fill="#7cc6ff"/>` : '';
  // outside the circle
  let outside = '';
  const outStart = '';
  if (A.effect === 'rainbow' && full){ defs += `<linearGradient id="${id}r" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff6b6b"/><stop offset=".25" stop-color="#ffd23f"/><stop offset=".5" stop-color="#3cc47c"/><stop offset=".75" stop-color="#3a9bff"/><stop offset="1" stop-color="#9b7bff"/></linearGradient>`; outside += `<rect x="2.5" y="2.5" width="115" height="195" rx="14" fill="none" stroke="url(#${id}r)" stroke-width="5"/>`; }
  else if (A.effect === 'rainbow'){ defs += `<linearGradient id="${id}r" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff6b6b"/><stop offset=".25" stop-color="#ffd23f"/><stop offset=".5" stop-color="#3cc47c"/><stop offset=".75" stop-color="#3a9bff"/><stop offset="1" stop-color="#9b7bff"/></linearGradient>`; outside += `<circle cx="60" cy="60" r="57.5" fill="none" stroke="url(#${id}r)" stroke-width="5"/>`; }
  if (A.effect === 'momiji') outside += [[12,24,20],[106,22,-25],[112,66,40],[8,78,-15],[102,104,30],[60,5,10]].map(([x,y,a],i) => `<g class="av-tw" transform="rotate(${a} ${x} ${y})">${star(x, y, 6.5, i%2 ? '#ff922b' : '#e8590c').replace('stroke="#e0a100"','stroke="#c2410c"')}</g>`).join('');
  if (A.effect === 'bubbles') outside += [[12,30,6],[106,24,5],[110,70,7],[8,80,5],[96,108,4],[20,110,3.5],[60,5,3.5]].map(([x,y,r]) => `<g class="av-tw"><circle cx="${x}" cy="${y}" r="${r}" fill="rgba(180,230,255,.35)" stroke="#9ad0ff" stroke-width="1.2"/><circle cx="${x-r*.35}" cy="${y-r*.35}" r="${r*.25}" fill="#fff"/></g>`).join('');
  if (A.effect === 'petals') outside += [[14,22,20],[104,18,-30],[110,62,60],[8,72,-10],[100,104,40],[18,108,80],[60,6,10]].map(([x,y,a],i) => `<ellipse class="av-tw" cx="${x}" cy="${y}" rx="5" ry="3" fill="${i%2 ? '#ffc2dc' : '#ffb3d1'}" transform="rotate(${a} ${x} ${y})"/>`).join('');
