    wizard:`<path d="M36,38 L64,-2 L84,38Z" fill="#5b3cc4"/><ellipse cx="60" cy="39" rx="34" ry="7" fill="#4a2fa8"/>` + star(62, 22, 5, '#ffd23f') + star(72, 32, 3, '#ffd23f'),
    horns:`<path d="M38,36 Q28,18 38,6 Q40,22 47,31Z M82,36 Q92,18 82,6 Q80,22 73,31Z" fill="#ffd23f" stroke="#e0a100" stroke-width="1.4"/>`,
