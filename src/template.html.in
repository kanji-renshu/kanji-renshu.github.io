    ribbon:`<path d="M80,28 L67,19 L67,37Z M80,28 L93,19 L93,37Z" fill="#ff5d8f" stroke="#e23b74" stroke-width="1.5" stroke-linejoin="round"/><circle cx="80" cy="28" r="4.5" fill="#ff8fb1" stroke="#e23b74" stroke-width="1.5"/>`,
    cap:`<path d="M27,47 Q28,15 60,15 Q92,15 93,47Z" fill="#ef476f"/><path d="M78,45 Q100,42 108,48 Q98,52 78,50Z" fill="#c9304f"/><circle cx="60" cy="15" r="3.5" fill="#c9304f"/>`,
